// VoxelWorklistArgs.usf -- the args-setup kernel for the persistent worklist
// (P3; docs/gpu-worklist-plan-2026-08-23.md). NOT WIRED to any dispatch chain
// yet -- see VoxelGpuWorklist.h's banner for the sequencing argument.
//
// ONE tiny dispatch per tick turns "N records pending" into one
// DispatchIndirect argument triple PER STAGE, with the group-per-record
// multiplier applied here on the GPU -- so the number of RDG passes per tick
// is a constant (one per stage) no matter how many chunks are in flight. The
// CPU uploads a head cursor and a slice budget; it never reads anything back.
//
// The control buffer is the identity the window log checks:
//   [0] consumeFirst -- ring index of the first record this tick consumes
//   [1] consumeCount -- how many (min(pending, SliceBudget))
//   [2] tailCursor   -- persistent: first unconsumed record (GPU-owned)
// A drifting appended == consumed + pending identity on the host log means
// this kernel and the host disagree about the cursor -- the failing reading.

#include "/Engine/Public/Platform.ush"

RWStructuredBuffer<uint> WorklistControl;
// EVoxelWorklistStage::COUNT triples of {groupsX, groupsY, 1}, consumed by
// DispatchIndirect. Typed R32 (RWBuffer, not RWStructuredBuffer): the host
// creates this with CreateIndirectDesc and binds a PF_R32_UINT UAV.
RWBuffer<uint> WorklistArgs;
// Per-stage groups-per-record, bound from the host enum table so the shader
// carries no copy of the stage shapes.
StructuredBuffer<uint> GroupsPerRecord;
// Per-stage RECORD DIMENSION, parallel to GroupsPerRecord and bound from the
// same host table: 0 = the record is carried in X (the triple is
// {Take x groups, 1, 1}), 1 = the record is carried in Y ({groups, Take, 1}).
//
// A dispatch dimension is capped at 65,535 groups, so a stage with G groups
// per record caps a flush at 65,535/G records while its record rides X. The
// Write stage (the Claim stage's two word copies, 148 groups per record --
// the biggest of any stage by 2.3x) capped it at 442 = ~26,500 chunks/s at
// 60 ticks, BELOW the 50,000 goal. Moving only that stage's record to Y makes
// its X a constant 148 and leaves the binding stage at 64 groups/record
// (Classify, Pack) = 1,023 records = ~61,000 chunks/s.
//
// A table rather than a stage-index literal here, for the reason the
// GroupsPerRecord table exists: this kernel must carry no copy of the stage
// shapes. The consuming kernel is locked to the SAME host constant through
// its own #error (VXC_WORKLIST_WRITE_RECORD_IN_Y), because the failure is
// silent otherwise -- a kernel reading the record from Y against a 1D triple
// sees Gid.y == 0 for every group and writes only record 0, leaving every
// other chunk's pool words unwritten. HOLES, with no error anywhere.
StructuredBuffer<uint> RecordInY;

uint HeadCursor;     // host ring head (records appended so far, mod capacity handled host-side as monotonic counts)
uint SliceBudget;    // max records the consuming graph may take this tick
uint StageCount;

[numthreads(1, 1, 1)]
void WorklistArgsMain(uint3 tid : SV_DispatchThreadID)
{
	const uint Tail = WorklistControl[2];
	const uint Pending = HeadCursor - Tail;   // monotonic counters: wrap-safe uint subtraction
	const uint Take = min(Pending, SliceBudget);
	WorklistControl[0] = Tail;
	WorklistControl[1] = Take;
	WorklistControl[2] = Tail + Take;
	for (uint S = 0; S < StageCount; ++S)
	{
		const uint G = GroupsPerRecord[S];
		const bool bRecY = RecordInY[S] != 0u;
		WorklistArgs[S * 3u + 0u] = bRecY ? G : (Take * G);
		WorklistArgs[S * 3u + 1u] = bRecY ? Take : 1u;
		WorklistArgs[S * 3u + 2u] = 1u;
	}
}
