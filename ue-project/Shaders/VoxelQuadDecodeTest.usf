// Harness kernel for the packed-quad decode (ADR-0006, G2).
//
// Exists so DecodeVoxelQuadVertex can be checked against a CPU reference
// without anything being drawn. The real consumer of that function is the
// vertex factory; this just runs it over a quad buffer and writes what it
// produced, so a mismatch shows up as a number instead of as terrain that
// looks slightly wrong in a screenshot nobody has time to take.

#include "/Engine/Public/Platform.ush"
#include "/VoxelEarth/VoxelQuadDecode.ush"

StructuredBuffer<uint2> InQuads;
RWStructuredBuffer<float4> OutVertices;  // xyz = position UU, w = ao | mat<<8
uint NumQuads;
float LevelScale;

[numthreads(64, 1, 1)]
void QuadDecodeTestMain(uint3 tid : SV_DispatchThreadID)
{
	const uint VertexIndex = tid.x;
	if (VertexIndex >= NumQuads * VOXEL_VERTICES_PER_QUAD)
	{
		return;
	}

	const uint QuadIndex = VertexIndex / VOXEL_VERTICES_PER_QUAD;
	const uint CornerIndex = VertexIndex % VOXEL_VERTICES_PER_QUAD;

	const FVoxelQuadVertex V = DecodeVoxelQuadVertex(InQuads[QuadIndex], CornerIndex, LevelScale);

	// AO is quantised back to its original 0..3 so the comparison is exact
	// rather than a float tolerance — the decode multiplies by 1/3, and
	// round-tripping through that is lossless for these four values.
	const uint AoQuantised = (uint)(V.AmbientOcclusion * 3.0f + 0.5f);

	OutVertices[VertexIndex] = float4(V.PositionUU, asfloat(AoQuantised | (V.MaterialId << 8)));
}
