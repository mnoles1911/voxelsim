// The GPU-side moves that make a packed chunk RESIDENT in the brick pool
// (docs/ray-marching-plan-2026-08-19.md P1-C / P2).
//
// WHAT THIS FILE IS, IN ONE LINE. brickpack.ush produces a chunk's bricks into
// scratch buffers with CHUNK-RELATIVE offsets; these five kernels move those
// bytes into the pool's three arenas, add the pool base to the offsets that
// name them, and write the one 32 B chunk record that describes the result.
//
// WHY THE PRODUCER DOES NOT WRITE STRAIGHT INTO THE POOL. It could -- the three
// write bases exist for exactly that -- but the pool allocation cannot be made
// until the totals are known, and the totals are a property of the classify
// pass's scan, which has already run by then. So the chain is
//
//     BrickClassify -> Scan x2 -> BrickPack   (scratch, all bases ZERO)
//     BrickTotalMain                          (8 bytes to the CPU)
//     ... CPU allocates from FVoxelBrickPool ...
//     BrickWordCopy x2 + BrickDescPoolWrite + BrickChunkRecord  (into the pool)
//
// which is the D1 quad path's shape (VoxelQuadPoolWrite.usf), one arena wider.
// Keeping the producer's bases at zero has a second payoff that is worth more
// than the pass it costs: the scratch buffers ARE the chunk-relative form
// docs/brick-volume-format.md defines, so voxel.GPU.VerifyBrickPack can compare
// them against vxc::packChunkBricksCanonical with no rebasing at all, and
// compare the POOL copy with a rebase it derives from the allocation it was
// handed. Two comparisons, one of which cannot be wrong about the base.
//
// THE TRAP THIS FILE EXISTS TO CONTAIN. A non-zero base lands IN the
// descriptor's offset field (format section 6b). Every consumer of a descriptor
// therefore has to agree on whether it is holding a chunk offset or a pool
// address, and the two are indistinguishable by inspection. The rule here is:
//   * the SCRATCH buffers are chunk-relative, always;
//   * the POOL buffers are pool-absolute, always;
//   * BrickDescPoolWriteMain is the ONLY place the two meet, and it is the
//     only kernel in the project that adds a base to an offset field.
//
// UNIFORM BRICKS ARE NOT REBASED, and that is not an optimisation. A uniform
// brick allocates nothing, so its offset fields are ZERO by contract (format
// section 2, and packChunkBricksCanonical writes eight zero bytes for uniform
// AIR). Adding a base to them would invent an address into another brick's
// payload -- and it would still LOOK right, because the kind field would still
// say "no payload here".

#include "/Engine/Public/Platform.ush"

// --- resources ---------------------------------------------------------------
//
// Loose globals, Unreal's $Globals convention, bound by reflected name from the
// FParameters structs in VoxelGpuWorldGen.cpp. Each kernel uses a subset; a
// resource an entry point does not touch is simply not in its reflection and
// its parameter struct does not declare it.

// Generic dword arena copy (occupancy and materials both).
StructuredBuffer<uint>   InWords;
RWStructuredBuffer<uint> OutWords;

// Descriptors: 8 B per brick slot, format section 2.
StructuredBuffer<uint2>   InBrickDesc;
RWStructuredBuffer<uint2> OutBrickDesc;

// The chunk's occupancy, CHUNK-RELATIVE (scratch). Read only by the chunk-record
// kernel, and only to decide allSolid -- see the note there.
StructuredBuffer<uint> InBrickOcc;

// The 64-bit L1 mask brickpack.ush accumulated with InterlockedOr: 2 dwords per
// chunk, "which of my 64 bricks are non-empty".
StructuredBuffer<uint> InChunkBrickMask;

// FVoxelMarchChunk records, 8 dwords each. Format section 6.
RWStructuredBuffer<uint> OutChunkTable;

// --- the batched-flush table (voxel.GPU.BrickFlushBatch) ---------------------
//
// One entry per chunk of a FUSED pool flush. The pool's per-chunk allocations
// are NON-CONTIGUOUS -- the arenas are first-fit suballocators, so K chunks'
// destination ranges are scattered wherever free runs happened to be -- which
// is why the batched kernels take a TABLE of destinations rather than a base
// plus a stride. The sources, by contrast, ARE contiguous per chunk: a Tier
// B.1 stack's scratch is chunk-major, so each chunk's words are one run.
//
// LAYOUT, PER ENTRY (stride bound from the host as FlushTableStride, never a
// literal here -- the ChunkRecordDwords rule, for the same left-behind-writer
// reason):
//   [0]  SrcBrickFirst   first scratch descriptor slot of this chunk
//   [1]  DstBrickBase    first POOL descriptor slot (the allocation)
//   [2]  OccSrcFirst     first scratch occupancy dword
//   [3]  OccDstBase      first POOL occupancy dword
//   [4]  OccWords        occupancy dwords this chunk owns (0 = all collapsed)
//   [5]  OccCumEnd       inclusive prefix sum of OccWords over entries 0..e
//   [6]  MatSrcFirst     first scratch material dword
//   [7]  MatDstBase      first POOL material dword
//   [8]  MatWords
//   [9]  MatCumEnd       inclusive prefix sum of MatWords over entries 0..e
//   [10] ChunkSlot       record index in OutChunkTable
//   [11] SrcChunkIndex   index into the scratch L1 mask (the producing dispatch)
//   [12] RingLevel
//   [13..15] OriginVoxel xyz, as int bit patterns
//   [16] ClimatePacked   [17] SurfaceGradPacked  [18] SurfaceZRelBits
//   [19..] zero
//
// The CUM columns exist for the word-copy kernel's binary search: they are
// non-decreasing by construction (each is the previous plus a non-negative
// count), so "which chunk owns flat word i" is a lower_bound over at most
// log2(entries) table reads. A zero-word entry's CumEnd equals its
// predecessor's and can never be selected, which is what makes all-collapsed
// chunks free rather than a special case.
//
// FOR THE CLEAR KERNEL the same binding is reused as a PLAIN SLOT LIST,
// stride 1 -- a retired slot needs nothing but its index.
StructuredBuffer<uint> InFlushTable;

// --- the flush cross-check's inputs (BrickFlushVerifyMain only) --------------
//
// The POOL arenas, bound read-only so the verify kernel can compare what the
// batched kernels LANDED against what the classic per-chunk kernels would have
// written. Separate names from the Out* UAVs above because one kernel must
// never hold the same buffer as both UAV and SRV.
StructuredBuffer<uint2> InPoolDesc;
StructuredBuffer<uint>  InPoolOcc;
StructuredBuffer<uint>  InPoolMat;
StructuredBuffer<uint>  InPoolTable;
// [0] mismatched dwords, [1] chunks verified. InterlockedAdd only.
RWStructuredBuffer<uint> OutVerify;

// The two scanned count/offset arrays, for the totals kernel.
StructuredBuffer<uint> InOccCounts;
StructuredBuffer<uint> InOccOffsets;
StructuredBuffer<uint> InMatCounts;
StructuredBuffer<uint> InMatOffsets;
RWStructuredBuffer<uint> OutBrickTotals;

// --- parameters --------------------------------------------------------------
uint NumWords;      // dwords BrickWordCopyMain moves
uint SrcFirst;      // first source element (0 on every path today; threaded
                    // through rather than assumed, for VoxelQuadPoolWrite.usf's
                    // reason -- the failure mode of assuming it is a copy that
                    // starts somewhere plausible and wrong)
uint DstFirst;      // first destination element in the pool arena
uint BrickCount;    // descriptors this chunk owns; 64 by contract, passed so the
                    // kernel does not hard-code a constant the host could change
uint OccBase;       // pool dword base of this chunk's occupancy allocation
uint MatBase;       // pool dword base of this chunk's material allocation
uint ChunkSlot;     // this chunk's record index in OutChunkTable (DESTINATION)
uint SrcChunkIndex; // this chunk's index within the SOURCE dispatch, which is
                    // what indexes the scratch L1 mask. Separate from ChunkSlot
                    // because the two are unrelated numbers that are equal in
                    // the one-chunk case -- exactly the coincidence that makes a
                    // conflated pair pass every test until a batched region
                    // exists
uint BrickBase;     // this chunk's first descriptor slot in the pool
uint RingLevel;     // 0..5; goes in LevelAndFlags [0:3]
uint ChunkClimatePacked;     // record dword 7, packed by FVoxelBrickChunkShading
uint ChunkSurfaceGradPacked; // record dword 8   ::Pack on the C++ side -- this
uint ChunkSurfaceZRelBits;   // record dword 9   kernel does NO arithmetic on
                    // them, so there is nothing here that can diverge from the
                    // CPU writer.
uint ChunkRecordDwords; // record stride, bound from FVoxelBrickPool::
                    // kChunkRecordDwords. NEVER a literal in this file: the two
                    // record kernels and the C++ writer must agree, and a
                    // literal is how one of them gets left behind.
int3 OriginVoxel;   // chunk min corner in LEVEL-L voxel coords
uint ScanCount;     // number of scanned bricks, for the totals kernel

// --- batched-flush parameters (voxel.GPU.BrickFlushBatch) --------------------
uint NumTableEntries;   // chunks (or, for the clear kernel, slots) in InFlushTable
uint TotalWords;        // sum of the table's per-chunk word counts, one arena
uint TableFieldFirst;   // 2 for the occupancy field group, 6 for materials --
                        // one kernel serves both arenas, exactly as
                        // BrickWordCopyMain does, and the field group is the
                        // only thing that differs
uint FlushTableStride;  // dwords per table entry, bound from the host
                        // (kFlushTableStride). NEVER a literal here.

// --- flush-verify parameters (BrickFlushVerifyMain) --------------------------
//
// Everything below is handed as LOOSE PER-CHUNK CONSTANTS, deliberately NOT
// read from InFlushTable. The verify exists to catch a wrong table (a bad
// prefix sum, a binary-search bug, a mis-assembled entry); a verify that took
// its coordinates from the same table would follow the bug to the wrong
// address and compare the wrong bytes against themselves -- derived, not
// verified, which is the exact failure family this project keeps paying for.
// These constants are filled from the SAME FPendingWrite fields the classic
// per-chunk passes are filled from, so the reference semantics here ARE the
// classic path's.
uint OccSrcFirst;       // chunk's first scratch occupancy dword
uint MatSrcFirst;       // chunk's first scratch material dword
uint VerifyOccWords;    // occupancy dwords to compare
uint VerifyMatWords;    // material dwords to compare

// The descriptor's offset field is 28 bits (format section 2). The host is
// required to keep every base plus its scanned offset under 2^28 dwords per
// arena -- FVoxelBrickPool::Init refuses a larger capacity outright -- so the
// mask below can never actually truncate. It is applied anyway because a
// truncation that reaches the GPU produces a wrong world rather than an error,
// and the one thing worse than a bound is a bound nobody restated.
static const uint kBrickOffsetMask = 0x0fffffffu;
static const uint kBrickFieldMask  = 0xf0000000u;
static const uint kBrickKindMixed  = 2u;
static const uint kBrickOccWords   = 16u;

// ---------------------------------------------------------------------------
// BrickTotalMain -- the 8 bytes the CPU needs, and the only readback on this
// path.
//
// Exactly QuadTotalMain's derivation (VoxelQuadScan.usf), twice: the scan is
// EXCLUSIVE, so the last brick's start offset plus its own count is the total.
// Deliberately the same arithmetic rather than a second one, so the two can be
// cross-checked and so a scan whose semantics ever changed would break both
// visibly instead of one silently.
// ---------------------------------------------------------------------------
[numthreads(1, 1, 1)]
void BrickTotalMain(uint3 tid : SV_DispatchThreadID)
{
	if (tid.x != 0)
	{
		return;
	}
	// ScanCount 0 would underflow to 0xFFFFFFFF and index wildly out of bounds.
	// The host cannot currently produce it (a region is validated to hold at
	// least one whole chunk), so this is the same unreachable-defence guard
	// QuadTotalMain carries, for the same reason.
	if (ScanCount == 0u)
	{
		OutBrickTotals[0] = 0u;
		OutBrickTotals[1] = 0u;
		return;
	}
	const uint Last = ScanCount - 1u;
	OutBrickTotals[0] = InOccOffsets[Last] + InOccCounts[Last];
	OutBrickTotals[1] = InMatOffsets[Last] + InMatCounts[Last];
}

// ---------------------------------------------------------------------------
// BrickStackTotalsMain -- per-chunk arena totals for a MULTI-CHUNK region
// (voxel.GPU.WorldGenBatch, Tier B.1).
//
// WHY IT EXISTS. BrickTotalMain above answers "how many dwords does this
// REGION need", which is the right question when a region is one chunk -- the
// shape every streaming dispatch had until the batched path. A batched region
// is a vertical stack of K chunks generated and packed in ONE set of passes,
// and the pool still allocates PER CHUNK, so the CPU needs K pairs, not one.
//
// WHY THE SPLIT IS THIS SUBTRACTION AND NOTHING CLEVERER. decodeBrick's pack
// order is CHUNK-MAJOR (brickpack.ush: packIndex = chunkIndex * 64 + local),
// and the two scans run over the counts in pack order, so chunk c's bricks are
// scan entries [c*BrickCount, (c+1)*BrickCount) and its arena words are the
// CONTIGUOUS run from InOccOffsets[first] to InOccOffsets[last] +
// InOccCounts[last]. That contiguity is what lets the pool copy a chunk out of
// the batch scratch as one run, and this kernel is where the assumption is
// turned into numbers the CPU can CHECK: the harvest cross-checks
// sum(per-chunk) == region pair, so a wrong split fails loudly instead of
// publishing somebody else's bricks. (This project has shipped code that ran
// and did nothing for months; every batch therefore carries its own check.)
//
// Thread 0 also writes the region pair into [0, 1] -- the same derivation as
// BrickTotalMain, restated so ONE readback carries both halves of the
// cross-check. Layout: [0]=region occ, [1]=region mat, then per chunk c:
// [2+2c]=occ dwords, [3+2c]=mat dwords.
//
// ScanCount is the region's brick count, BrickCount the bricks per chunk (64
// by contract, bound from the host like every other count in this file).
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void BrickStackTotalsMain(uint3 tid : SV_DispatchThreadID)
{
	// Same unreachable-defence guard as BrickTotalMain: a zero count would
	// underflow the Last index below into a wild read.
	if (ScanCount == 0u || BrickCount == 0u)
	{
		return;
	}
	const uint NumChunks = ScanCount / BrickCount;
	if (tid.x >= NumChunks)
	{
		return;
	}

	const uint First = tid.x * BrickCount;
	const uint Last  = First + BrickCount - 1u;
	// The scans are EXCLUSIVE, so a chunk's words end at its last brick's start
	// offset plus that brick's own count, and begin at its first brick's start
	// offset. The difference is the chunk's total; it is also, because the pack
	// order is chunk-major, the length of the chunk's contiguous arena run.
	OutBrickTotals[2u + 2u * tid.x + 0u] =
		(InOccOffsets[Last] + InOccCounts[Last]) - InOccOffsets[First];
	OutBrickTotals[2u + 2u * tid.x + 1u] =
		(InMatOffsets[Last] + InMatCounts[Last]) - InMatOffsets[First];

	if (tid.x == 0u)
	{
		const uint L = ScanCount - 1u;
		OutBrickTotals[0] = InOccOffsets[L] + InOccCounts[L];
		OutBrickTotals[1] = InMatOffsets[L] + InMatCounts[L];
	}
}

// ---------------------------------------------------------------------------
// BrickWordCopyMain -- one arena, one chunk's run of dwords.
//
// A compute pass rather than AddCopyBufferPass for VoxelQuadPoolWrite.usf's
// second reason, which applies verbatim here: two small RDG-pooled buffers can
// be suballocated from ONE D3D12 resource, and FD3D12CommandContext::
// RHICopyBufferRegion asserts source != destination. A copy that trips a
// checked-build assert depending on nothing but pool state is not a copy worth
// saving a dispatch for.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void BrickWordCopyMain(uint3 tid : SV_DispatchThreadID)
{
	const uint i = tid.x;
	if (i >= NumWords)
	{
		return;
	}
	OutWords[DstFirst + i] = InWords[SrcFirst + i];
}

// ---------------------------------------------------------------------------
// BrickDescPoolWriteMain -- the descriptors, WITH the pool base folded into the
// offset fields. The only kernel that does this; see the file header.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void BrickDescPoolWriteMain(uint3 tid : SV_DispatchThreadID)
{
	const uint i = tid.x;
	if (i >= BrickCount)
	{
		return;
	}

	uint2 D = InBrickDesc[SrcFirst + i];

	// MIXED only. A uniform brick's offset fields are zero by contract and must
	// stay zero -- see the file header for why rebasing them is worse than
	// useless.
	const uint Kind = (D.x >> 28u) & 3u;
	if (Kind == kBrickKindMixed)
	{
		const uint OccOffset = ((D.x & kBrickOffsetMask) + OccBase) & kBrickOffsetMask;
		const uint MatOffset = ((D.y & kBrickOffsetMask) + MatBase) & kBrickOffsetMask;
		D.x = OccOffset | (D.x & kBrickFieldMask);
		D.y = MatOffset | (D.y & kBrickFieldMask);
	}

	OutBrickDesc[DstFirst + i] = D;
}

// ---------------------------------------------------------------------------
// BrickChunkRecordMain -- the 32 B FVoxelMarchChunk (format section 6).
//
// ONE WORKGROUP, ONE CHUNK, 64 THREADS -- one per brick, because of allSolid.
//
// allSolid IS NOT DERIVABLE FROM THE DESCRIPTORS AND IT LOOKS AS THOUGH IT IS.
// A brick can be fully solid and still MIXED: 512 solid cells holding two
// materials does not collapse. So "all 64 descriptors are uniform SOLID" is
// strictly stronger than allSolid and under-reports it, which would tell a
// marcher a solid chunk needs entering. This kernel computes it from the CELL
// DATA, as format section 6 requires and as vxc::packChunkBricksCanonical does:
// a MIXED brick is fully solid iff all 16 of its occupancy dwords are
// 0xFFFFFFFF, and the AND of 16 dwords is 16 loads of memory that is already
// hot -- this pass runs immediately after the copy that wrote it.
//
// It reads the SCRATCH buffers, not the pool: their offsets are chunk-relative,
// so this kernel needs no base and cannot be wrong about one.
//
// anySolid is free and comes from the L1 mask: a chunk with no non-empty brick
// has a zero mask by construction.
// ---------------------------------------------------------------------------
groupshared uint gsAllSolid;

[numthreads(64, 1, 1)]
void BrickChunkRecordMain(uint3 gtid : SV_GroupThreadID)
{
	if (gtid.x == 0u)
	{
		gsAllSolid = 1u;
	}
	GroupMemoryBarrierWithGroupSync();

	if (gtid.x < BrickCount)
	{
		const uint2 D = InBrickDesc[SrcFirst + gtid.x];
		const uint Kind = (D.x >> 28u) & 3u;

		bool bBrickAllSolid = false;
		if (Kind == 1u)
		{
			// Uniform SOLID: 512 non-air cells, no payload to consult.
			bBrickAllSolid = true;
		}
		else if (Kind == kBrickKindMixed)
		{
			const uint OccWord = D.x & kBrickOffsetMask;
			uint Acc = 0xffffffffu;
			for (uint k = 0u; k < kBrickOccWords; ++k)
			{
				Acc &= InBrickOcc[OccWord + k];
			}
			bBrickAllSolid = (Acc == 0xffffffffu);
		}
		// Kind 0 is uniform AIR and leaves bBrickAllSolid false, which is what
		// makes an all-air chunk report allSolid = 0 rather than vacuously 1.

		if (!bBrickAllSolid)
		{
			InterlockedAnd(gsAllSolid, 0u);
		}
	}
	GroupMemoryBarrierWithGroupSync();

	if (gtid.x != 0u)
	{
		return;
	}

	const uint MaskLo = InChunkBrickMask[2u * SrcChunkIndex + 0u];
	const uint MaskHi = InChunkBrickMask[2u * SrcChunkIndex + 1u];
	const uint AnySolid = ((MaskLo | MaskHi) != 0u) ? 1u : 0u;
	const uint AllSolid = (gsAllSolid != 0u) ? 1u : 0u;

	// LevelAndFlags: [0:3] ring level, [4] anySolid, [5] allSolid.
	//
	// THE RING LEVEL IS THE FIELD THAT MAKES THIS A ONE-LINE REQUIREMENT NOW AND
	// A REWRITE LATER (format section 6). GI cone marching in Phase 7 steps
	// ACROSS rings, because rings already are 2x steps, and it can only do that
	// if the level is resident next to the chunk rather than implied by which
	// table the chunk was found in.
	const uint LevelAndFlags = (RingLevel & 0xfu) | (AnySolid << 4u) | (AllSolid << 5u);

	// STRIDE COMES FROM THE HOST, NOT FROM A LITERAL. ChunkRecordDwords is bound
	// from FVoxelBrickPool::kChunkRecordDwords, so this kernel and the C++
	// writer cannot disagree about the record length. A literal here was one of
	// the two ways the format could grow with a writer silently left behind, and
	// that failure is not subtle: records land at half stride, overwrite each
	// other, and the reader's origin validation rejects them -- GPU-forked
	// terrain vanishes while CPU-worker terrain does not.
	const uint Base = ChunkSlot * ChunkRecordDwords;
	OutChunkTable[Base + 0u] = asuint(OriginVoxel.x);
	OutChunkTable[Base + 1u] = asuint(OriginVoxel.y);
	OutChunkTable[Base + 2u] = asuint(OriginVoxel.z);
	OutChunkTable[Base + 3u] = LevelAndFlags;
	OutChunkTable[Base + 4u] = BrickBase;
	OutChunkTable[Base + 5u] = MaskLo;
	OutChunkTable[Base + 6u] = MaskHi;
	// Step 2: the shading terms, handed down ALREADY PACKED. See the parameter
	// block -- this kernel deliberately does no bit work on them.
	OutChunkTable[Base + 7u] = ChunkClimatePacked;
	OutChunkTable[Base + 8u] = ChunkSurfaceGradPacked;
	OutChunkTable[Base + 9u] = ChunkSurfaceZRelBits;
	for (uint D = 10u; D < ChunkRecordDwords; ++D)
	{
		OutChunkTable[Base + D] = 0u;
	}
}

// ---------------------------------------------------------------------------
// BrickChunkClearMain -- retires one record.
//
// Writes eight zero dwords, which is a record whose LevelAndFlags has anySolid
// clear. A marcher reads that as "nothing here", so a freed slot is inert the
// instant this lands rather than pointing at an arena range that has been handed
// to somebody else. Ordering is the caller's: FVoxelBrickPool records the clear
// in the SAME graph as, and BEFORE, any write that reuses the freed range.
// ---------------------------------------------------------------------------
// 64 IS A GROUP SIZE, NOT THE RECORD LENGTH, and the distinction is the whole
// point. This used to be [numthreads(8)] with an `if (tid.x >= 8u)` guard, where
// 8 silently meant BOTH. Grow the record and that kernel clears the first half
// of every retired slot and leaves the rest -- so a slot freed and re-allocated
// carries the PREVIOUS TENANT'S fields, with no error anywhere. Once the record
// holds per-chunk shading, the symptom is tint that follows slot reuse.
//
// The group is now larger than any plausible record and the bound comes from the
// host, so the two numbers can never be confused again.
[numthreads(64, 1, 1)]
void BrickChunkClearMain(uint3 tid : SV_DispatchThreadID)
{
	if (tid.x >= ChunkRecordDwords)
	{
		return;
	}
	OutChunkTable[ChunkSlot * ChunkRecordDwords + tid.x] = 0u;
}

// ===========================================================================
// The BATCHED pool flush (voxel.GPU.BrickFlushBatch) -- Tier B.1's follow-up.
//
// WHY THESE EXIST, WITH THE MEASUREMENT THAT MOTIVATED THEM. Tier B.1 fused
// worldgen+pack for a Z-stack of chunks into one set of passes (a measured leg:
// 689 chunks in 215 stacks, ~3,010 passes against ~10,335 per-chunk, crosscheck
// 0 FAIL) -- and throughput did NOT move, so per-chunk PASS SETUP upstream of
// the pool was not the ceiling. What stayed per-chunk was THIS file's pool
// flush: 2 word copies + desc rebase + record, ~4 small dispatches per chunk,
// on every arm. The four kernels below collapse that to ~4 dispatches per
// FUSED GROUP (a group = the chunks sharing one producing dispatch's scratch
// buffers, i.e. one B.1 stack), driven by InFlushTable.
//
// WHY A TABLE AND NOT A BASE+STRIDE. The pool's arenas are first-fit
// suballocators; K chunks' destination ranges land wherever free runs were.
// Non-contiguous destinations cannot be an arithmetic function of the thread
// id, so each kernel looks its addressing up instead of computing it.
//
// BYTE-IDENTITY IS THE CONTRACT. Each kernel below is the corresponding
// classic kernel's body with the loose per-chunk constants replaced by table
// reads -- no arithmetic changed. BrickFlushVerifyMain then compares the
// landed pool bytes against the classic formula computed from loose constants,
// so "identical by construction" is also CHECKED, every window, live.
// ===========================================================================

// ---------------------------------------------------------------------------
// BrickFlushBatchWordCopyMain -- ONE dispatch moves EVERY fused chunk's run in
// one arena. One thread per word over the group's summed word count; the
// owning chunk is a lower_bound over the table's non-decreasing CumEnd column
// (<= 10 iterations at the 512-entry cap, against memory that is hot after the
// first few threads touch it).
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void BrickFlushBatchWordCopyMain(uint3 tid : SV_DispatchThreadID)
{
	const uint i = tid.x;
	if (i >= TotalWords)
	{
		return;
	}

	// lower_bound: first entry whose CumEnd exceeds i. A zero-word entry's
	// CumEnd equals its predecessor's, so it is never selected -- all-collapsed
	// chunks cost nothing here rather than needing a skip.
	uint Lo = 0u;
	uint Hi = NumTableEntries;
	while (Lo < Hi)
	{
		const uint Mid = (Lo + Hi) >> 1u;
		const uint Cum = InFlushTable[Mid * FlushTableStride + TableFieldFirst + 3u];
		if (Cum <= i)
		{
			Lo = Mid + 1u;
		}
		else
		{
			Hi = Mid;
		}
	}

	const uint Base = Lo * FlushTableStride + TableFieldFirst;
	const uint SrcRunFirst = InFlushTable[Base + 0u];
	const uint DstRunBase  = InFlushTable[Base + 1u];
	const uint Words       = InFlushTable[Base + 2u];
	const uint CumEnd      = InFlushTable[Base + 3u];
	// i is inside this entry's [CumEnd - Words, CumEnd) span by the search's
	// postcondition, so Local cannot underflow.
	const uint Local = i - (CumEnd - Words);
	OutWords[DstRunBase + Local] = InWords[SrcRunFirst + Local];
}

// ---------------------------------------------------------------------------
// BrickFlushBatchDescWriteMain -- every fused chunk's descriptors in ONE
// dispatch. BrickDescPoolWriteMain's arithmetic verbatim, with the rebase
// derived from the table: (DstBase - SrcFirst) as a wrapping uint, sound for
// the reason recorded on FVoxelBrickPool::AddFlushPasses_RenderThread -- the
// kernel masks to 28 bits and Init refuses arenas past 2^28 dwords, so the
// wrapped add lands on exactly (offset - SrcFirst + DstBase).
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void BrickFlushBatchDescWriteMain(uint3 tid : SV_DispatchThreadID)
{
	const uint i = tid.x;
	if (i >= NumTableEntries * BrickCount)
	{
		return;
	}
	const uint e = i / BrickCount;
	const uint b = i - e * BrickCount;

	const uint Base = e * FlushTableStride;
	const uint SrcBrickFirst = InFlushTable[Base + 0u];
	const uint DstBrickBase  = InFlushTable[Base + 1u];
	const uint OccRebase = InFlushTable[Base + 3u] - InFlushTable[Base + 2u];
	const uint MatRebase = InFlushTable[Base + 7u] - InFlushTable[Base + 6u];

	uint2 D = InBrickDesc[SrcBrickFirst + b];
	const uint Kind = (D.x >> 28u) & 3u;
	if (Kind == kBrickKindMixed)
	{
		// MIXED only -- a uniform brick's zero offsets must stay zero; see the
		// file header for why rebasing them is worse than useless.
		const uint OccOffset = ((D.x & kBrickOffsetMask) + OccRebase) & kBrickOffsetMask;
		const uint MatOffset = ((D.y & kBrickOffsetMask) + MatRebase) & kBrickOffsetMask;
		D.x = OccOffset | (D.x & kBrickFieldMask);
		D.y = MatOffset | (D.y & kBrickFieldMask);
	}
	OutBrickDesc[DstBrickBase + b] = D;
}

// ---------------------------------------------------------------------------
// BrickFlushBatchRecordMain -- one WORKGROUP per fused chunk, 64 threads, in
// ONE dispatch. BrickChunkRecordMain's body with the loose constants replaced
// by this group's table entry; the allSolid reduce is unchanged and still runs
// over the SCRATCH cell data, because allSolid is not derivable from the
// descriptors (a fully solid two-material brick is still MIXED) -- see the
// classic kernel above for the full argument.
// ---------------------------------------------------------------------------
groupshared uint gsBatchAllSolid;

[numthreads(64, 1, 1)]
void BrickFlushBatchRecordMain(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
	const uint e = gid.x;
	if (e >= NumTableEntries)
	{
		return;
	}
	const uint Base = e * FlushTableStride;
	const uint EntrySrcBrickFirst = InFlushTable[Base + 0u];
	const uint EntryChunkSlot     = InFlushTable[Base + 10u];
	const uint EntrySrcChunkIndex = InFlushTable[Base + 11u];

	if (gtid.x == 0u)
	{
		gsBatchAllSolid = 1u;
	}
	GroupMemoryBarrierWithGroupSync();

	if (gtid.x < BrickCount)
	{
		const uint2 D = InBrickDesc[EntrySrcBrickFirst + gtid.x];
		const uint Kind = (D.x >> 28u) & 3u;

		bool bBrickAllSolid = false;
		if (Kind == 1u)
		{
			bBrickAllSolid = true;
		}
		else if (Kind == kBrickKindMixed)
		{
			const uint OccWord = D.x & kBrickOffsetMask;
			uint Acc = 0xffffffffu;
			for (uint k = 0u; k < kBrickOccWords; ++k)
			{
				Acc &= InBrickOcc[OccWord + k];
			}
			bBrickAllSolid = (Acc == 0xffffffffu);
		}
		if (!bBrickAllSolid)
		{
			InterlockedAnd(gsBatchAllSolid, 0u);
		}
	}
	GroupMemoryBarrierWithGroupSync();

	if (gtid.x != 0u)
	{
		return;
	}

	const uint MaskLo = InChunkBrickMask[2u * EntrySrcChunkIndex + 0u];
	const uint MaskHi = InChunkBrickMask[2u * EntrySrcChunkIndex + 1u];
	const uint AnySolid = ((MaskLo | MaskHi) != 0u) ? 1u : 0u;
	const uint AllSolid = (gsBatchAllSolid != 0u) ? 1u : 0u;
	const uint LevelAndFlags = (InFlushTable[Base + 12u] & 0xfu)
	                         | (AnySolid << 4u) | (AllSolid << 5u);

	const uint Rec = EntryChunkSlot * ChunkRecordDwords;
	OutChunkTable[Rec + 0u] = InFlushTable[Base + 13u];
	OutChunkTable[Rec + 1u] = InFlushTable[Base + 14u];
	OutChunkTable[Rec + 2u] = InFlushTable[Base + 15u];
	OutChunkTable[Rec + 3u] = LevelAndFlags;
	OutChunkTable[Rec + 4u] = InFlushTable[Base + 1u];   // DstBrickBase
	OutChunkTable[Rec + 5u] = MaskLo;
	OutChunkTable[Rec + 6u] = MaskHi;
	OutChunkTable[Rec + 7u] = InFlushTable[Base + 16u];
	OutChunkTable[Rec + 8u] = InFlushTable[Base + 17u];
	OutChunkTable[Rec + 9u] = InFlushTable[Base + 18u];
	for (uint D = 10u; D < ChunkRecordDwords; ++D)
	{
		OutChunkTable[Rec + D] = 0u;
	}
}

// ---------------------------------------------------------------------------
// BrickFlushBatchClearMain -- every retired record of the flush in ONE
// dispatch. InFlushTable is a PLAIN SLOT LIST here (stride 1); one thread per
// (slot, dword), and the dword count comes from the host for the clear
// kernel's own grow-the-record reason.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void BrickFlushBatchClearMain(uint3 tid : SV_DispatchThreadID)
{
	const uint i = tid.x;
	if (i >= NumTableEntries * ChunkRecordDwords)
	{
		return;
	}
	const uint e = i / ChunkRecordDwords;
	const uint d = i - e * ChunkRecordDwords;
	OutChunkTable[InFlushTable[e] * ChunkRecordDwords + d] = 0u;
}

// ---------------------------------------------------------------------------
// BrickFlushVerifyMain -- the LIVE cross-check for the batched flush. One
// workgroup, one chunk, sampled (one fused group per flush), and every input
// address below comes from LOOSE CONSTANTS filled from the same FPendingWrite
// the classic passes would read -- NOT from InFlushTable. See the parameter
// block for why that independence is the whole point.
//
// WHAT FAILS IT: any dword of the chunk's pool descriptor range differing from
// the classic rebase formula over the scratch descriptors; any dword of its
// pool occupancy or material ranges differing from its scratch runs; any of
// the 16 record dwords (reserved tail included) differing from the record the
// classic kernel would build. Mismatches are InterlockedAdd'ed into
// OutVerify[0]; OutVerify[1] counts chunks checked so a verify that silently
// checked nothing is visible as 0/0 rather than as a pass -- the vxc_gpu
// lesson: never gate on a statistic that cannot come out the other way.
// ---------------------------------------------------------------------------
groupshared uint gsVerifyAllSolid;

[numthreads(64, 1, 1)]
void BrickFlushVerifyMain(uint3 gtid : SV_GroupThreadID)
{
	// Phase A: the allSolid reduce, exactly BrickChunkRecordMain's, so the
	// expected record below is the classic record.
	if (gtid.x == 0u)
	{
		gsVerifyAllSolid = 1u;
	}
	GroupMemoryBarrierWithGroupSync();

	if (gtid.x < BrickCount)
	{
		const uint2 D = InBrickDesc[SrcFirst + gtid.x];
		const uint Kind = (D.x >> 28u) & 3u;
		bool bBrickAllSolid = false;
		if (Kind == 1u)
		{
			bBrickAllSolid = true;
		}
		else if (Kind == kBrickKindMixed)
		{
			const uint OccWord = D.x & kBrickOffsetMask;
			uint Acc = 0xffffffffu;
			for (uint k = 0u; k < kBrickOccWords; ++k)
			{
				Acc &= InBrickOcc[OccWord + k];
			}
			bBrickAllSolid = (Acc == 0xffffffffu);
		}
		if (!bBrickAllSolid)
		{
			InterlockedAnd(gsVerifyAllSolid, 0u);
		}
	}
	GroupMemoryBarrierWithGroupSync();

	// Phase B: strided compares. Each thread accumulates locally and adds once,
	// so the atomic traffic is 64 adds per chunk at worst, not one per dword.
	uint Mismatches = 0u;

	// Descriptors: pool bytes vs the classic rebase of the scratch bytes.
	const uint OccRebase = OccBase - OccSrcFirst;
	const uint MatRebase = MatBase - MatSrcFirst;
	for (uint b = gtid.x; b < BrickCount; b += 64u)
	{
		uint2 E = InBrickDesc[SrcFirst + b];
		const uint Kind = (E.x >> 28u) & 3u;
		if (Kind == kBrickKindMixed)
		{
			E.x = (((E.x & kBrickOffsetMask) + OccRebase) & kBrickOffsetMask) | (E.x & kBrickFieldMask);
			E.y = (((E.y & kBrickOffsetMask) + MatRebase) & kBrickOffsetMask) | (E.y & kBrickFieldMask);
		}
		const uint2 G = InPoolDesc[BrickBase + b];
		Mismatches += (E.x != G.x) ? 1u : 0u;
		Mismatches += (E.y != G.y) ? 1u : 0u;
	}

	// The two arena runs, dword for dword.
	for (uint i = gtid.x; i < VerifyOccWords; i += 64u)
	{
		Mismatches += (InPoolOcc[OccBase + i] != InBrickOcc[OccSrcFirst + i]) ? 1u : 0u;
	}
	// InWords is the scratch MATERIAL buffer on this kernel -- the loose-global
	// binding model lets each entry point use the generic dword SRV for
	// whatever arena it needs, exactly as BrickWordCopyMain does.
	for (uint j = gtid.x; j < VerifyMatWords; j += 64u)
	{
		Mismatches += (InPoolMat[MatBase + j] != InWords[MatSrcFirst + j]) ? 1u : 0u;
	}

	if (gtid.x == 0u)
	{
		// The 16-dword record, reserved tail included -- a batched record pass
		// that forgot to zero the tail must fail here, because slot reuse is
		// exactly how stale tail dwords become somebody's terrain tint later.
		const uint MaskLo = InChunkBrickMask[2u * SrcChunkIndex + 0u];
		const uint MaskHi = InChunkBrickMask[2u * SrcChunkIndex + 1u];
		const uint AnySolid = ((MaskLo | MaskHi) != 0u) ? 1u : 0u;
		const uint AllSolid = (gsVerifyAllSolid != 0u) ? 1u : 0u;
		const uint LevelAndFlags = (RingLevel & 0xfu) | (AnySolid << 4u) | (AllSolid << 5u);

		const uint Rec = ChunkSlot * ChunkRecordDwords;
		Mismatches += (InPoolTable[Rec + 0u] != asuint(OriginVoxel.x)) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 1u] != asuint(OriginVoxel.y)) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 2u] != asuint(OriginVoxel.z)) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 3u] != LevelAndFlags) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 4u] != BrickBase) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 5u] != MaskLo) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 6u] != MaskHi) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 7u] != ChunkClimatePacked) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 8u] != ChunkSurfaceGradPacked) ? 1u : 0u;
		Mismatches += (InPoolTable[Rec + 9u] != ChunkSurfaceZRelBits) ? 1u : 0u;
		for (uint D = 10u; D < ChunkRecordDwords; ++D)
		{
			Mismatches += (InPoolTable[Rec + D] != 0u) ? 1u : 0u;
		}
		InterlockedAdd(OutVerify[1], 1u);
	}

	if (Mismatches != 0u)
	{
		InterlockedAdd(OutVerify[0], Mismatches);
	}
}
