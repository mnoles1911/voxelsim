// Vertex factory for GPU-resident voxel quads (ADR-0006, G2).
//
// There is NO VERTEX BUFFER. The GPU mesher writes packed quads (8 bytes each)
// into a persistent pool, and this factory reconstructs every corner from
// SV_VertexID alone: 6 vertices per quad, two triangles, no index buffer.
// That is the whole point of ADR-0006 -- geometry never round-trips through the
// CPU, so streaming a chunk in or out never touches FScene.
//
// Modelled on FLidarPointCloudVertexFactory (Engine/Plugins/Enterprise/
// LidarPointCloud), which does the same trick: read a buffer by SV_VertexID and
// expand each entry into a quad in the vertex shader.
//
// The decode itself lives in VoxelQuadDecode.ush and is verified bit-exact
// against a CPU reference by voxel.GPU.VerifyRegion -- so if terrain looks
// wrong, the bug is in THIS file (framing, transforms, material plumbing),
// not in the unpacking.

#include "/Engine/Private/VertexFactoryCommon.ush"
#include "/VoxelEarth/VoxelQuadDecode.ush"

// The quad pool and its framing arrive in the VoxelVF uniform buffer, declared
// by FVoxelQuadVertexFactoryParameters and injected into this shader by the
// engine. Members are reached THROUGH the struct -- VoxelVF.QuadBuffer -- not
// as loose globals of that name. Declaring loose globals here instead compiles
// perfectly and then silently reads zeros, because they are different, unbound
// symbols. So there is deliberately nothing to declare in this file.

struct FVertexFactoryInput
{
	// No ATTRIBUTE bindings at all -- the vertex declaration is empty (see
	// FVoxelQuadVertexFactory::InitRHI). SV_VertexID is a system value, not a
	// stream, so it arrives without any vertex buffer bound.
	// Zero-stride dummy, never read. It exists only because a draw going
	// through the mesh-pass system needs a vertex declaration to describe --
	// see FVoxelQuadVertexFactory::InitRHI.
	half4 DummyAttribute : ATTRIBUTE0;

	uint VertexId : SV_VertexID;

	VF_INSTANCED_STEREO_DECLARE_INPUT_BLOCK()
	VF_MOBILE_MULTI_VIEW_DECLARE_INPUT_BLOCK()
};

struct FVertexFactoryInterpolantsVSToPS
{
	TANGENTTOWORLD_INTERPOLATOR_BLOCK

	half4  Color     : COLOR0;
	float2 TexCoords : TEXCOORD0;
	// Voxel GI lookup, as a [0,1] volume coordinate rather than a position.
	// Carrying UVW keeps the magnitudes small (perfect interpolation precision)
	// and makes the distance fade recoverable without a second interpolant.
	// TEXCOORD1 is free -- TANGENTTOWORLD_INTERPOLATOR_BLOCK lands on
	// TEXCOORD10/11 (+15), not here.
	float3 GIUVW     : TEXCOORD1;
};

struct FVertexFactoryIntermediates
{
	half3x3 TangentToLocal;
	half3x3 TangentToWorld;
	half    TangentToWorldSign;
	half4   Color;
	float3  Position;      // primitive space, unreal units
	float2  TexCoords;
	float3  GIUVW;

	FSceneDataIntermediates SceneData;
};

// Builds a tangent frame for an axis-aligned voxel face. The face normal is
// one of the six axis directions, and the quad's own u/v axes are the other
// two -- so the frame is exact, not approximated.
half3x3 VoxelBuildTangentFrame(float3 Normal, uint Axis)
{
	const uint U = (Axis + 1u) % 3u;
	const uint V = (Axis + 2u) % 3u;

	float3 Tangent = float3(0.0f, 0.0f, 0.0f);
	float3 Bitangent = float3(0.0f, 0.0f, 0.0f);
	Tangent[U] = 1.0f;
	Bitangent[V] = 1.0f;

	half3x3 Frame;
	Frame[0] = (half3)Tangent;
	Frame[1] = (half3)Bitangent;
	Frame[2] = (half3)Normal;
	return Frame;
}

FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
{
	FVertexFactoryIntermediates Intermediates = (FVertexFactoryIntermediates)0;
	Intermediates.SceneData = VF_GPUSCENE_GET_INTERMEDIATES(Input);

	const uint QuadIndex = Input.VertexId / VOXEL_VERTICES_PER_QUAD;
	const uint CornerIndex = Input.VertexId % VOXEL_VERTICES_PER_QUAD;

	const uint2 Packed = VoxelVF.QuadBuffer[QuadIndex];

	// In pool mode every quad names its own chunk, so one draw can span the
	// whole pool with no per-draw state. In single-chunk mode the framing comes
	// from the uniform buffer instead.
	float3 ChunkOrigin = VoxelVF.ChunkOriginUU;
	float ChunkScale = VoxelVF.LevelScale;
	float2 ChunkClimate = float2(0.5f, 0.5f);
	// Surface height at this chunk's centre, relative to the chunk's own origin.
	// Single-chunk mode has no per-chunk table, so it takes the "no subsystem"
	// fallback BuildChunkVertexData uses: everything counts as surface.
	float ChunkSurfaceZRelUU = -1.0e30f;
	if (VoxelVF.PoolMode != 0u)
	{
		const uint ChunkId = VoxelVF.QuadChunkIds[QuadIndex];
		const float4 Entry = VoxelVF.ChunkOrigins[ChunkId];
		ChunkOrigin = Entry.xyz;
		ChunkScale = Entry.w;
		const float4 Params = VoxelVF.ChunkParams[ChunkId];
		ChunkClimate = Params.xy;
		ChunkSurfaceZRelUU = Params.z;
	}

	const FVoxelQuadVertex Decoded = DecodeVoxelQuadVertex(Packed, CornerIndex, ChunkScale);
	Intermediates.Position = Decoded.PositionUU + ChunkOrigin;

// TEMPORARY BISECT (VOXEL_VF_DEBUG_QUAD). Replaces all real geometry with one
// large flat quad at the primitive origin. If this shows up and the real
// geometry does not, the draw plumbing is fine and the fault is in the decoded
// positions; if even this is invisible, the draw itself never rasterises and
// the empty vertex declaration is the prime suspect. Remove once resolved.
#if VOXEL_VF_DEBUG_QUAD
	{
		// A CUBE, not a single quad.
		//
		// The first version of this test drew one horizontal quad and concluded
		// from its absence that the draw never rasterises. That conclusion was
		// unsound: the quad sat above the camera, so we were looking at its
		// underside, and backface culling alone would explain the blank frame.
		//
		// Six outward-facing sides cannot all be culled from any viewpoint, so
		// this version distinguishes "nothing rasterises" from "I aimed a
		// single-sided surface away from the camera".
		const float S = 2000.0f;   // 20 m
		const uint Face = QuadIndex;
		const uint FAxis = Face / 2u;
		const bool bPositiveFace = (Face % 2u) == 1u;
		const uint FU = (FAxis + 1u) % 3u;
		const uint FV = (FAxis + 2u) % 3u;

		float2 Fwd[6] = { float2(0,0), float2(0,S), float2(S,S),
		                  float2(0,0), float2(S,S), float2(S,0) };
		float2 Rev[6] = { float2(0,0), float2(S,S), float2(0,S),
		                  float2(0,0), float2(S,0), float2(S,S) };
		const float2 C = bPositiveFace ? Fwd[CornerIndex] : Rev[CornerIndex];

		float3 P = float3(0.0f, 0.0f, 0.0f);
		P[FAxis] = bPositiveFace ? S : 0.0f;
		P[FU] = C.x;
		P[FV] = C.y;

		// Faces 0-5 form the cube; every other quad collapses to a point.
		Intermediates.Position = (QuadIndex < 6u) ? P : float3(0.0f, 0.0f, 0.0f);
	}
#endif

	const uint Axis = Packed.x & 0xfu;
	Intermediates.TangentToLocal = VoxelBuildTangentFrame(Decoded.Normal, Axis);
	Intermediates.TangentToWorldSign = 1.0h;

	// Matches the CPU path's vertex colour layout (BuildChunkVertexData):
	//   R = material id, G = ambient occlusion, B/A = climate.
	//
	// KNOWN GAP: climate (B = temperature, A = precipitation) is sampled on the
	// CPU from a 30 m raster and is not available here yet, so both are held at
	// the neutral midpoint. Expect the GPU path's biome tint to differ from the
	// CPU path until G4 supplies climate GPU-side. This is a predicted
	// difference, not a bug to chase during the G2 visual A/B.
	// B/A carry climate, sampled once per chunk on the CPU and looked up above.
	// Single-chunk mode has no per-chunk table, so they stay neutral there and
	// its biome tint will differ from the CPU path -- pool mode is the one
	// that matches.
	// R is a BINARY sky-facing flag, not the material id.
	//
	// The CPU path documents this at length (VoxelClimateProbe.h): thresholding
	// a categorical id through the FColor->shader transform proved unreliable,
	// so R is 0 or 255 -- the fixed points of any monotonic per-channel
	// transform -- and surface-ness is derived from FACE DIRECTION rather than
	// material id, because the ids voxel-core actually emits here are only
	// MAT_ROCK and MAT_SUBSOIL. Writing the id instead makes every quad read as
	// subsurface, which is exactly the grey/tan the first pool render showed.
	//
	// R is a full mirror of VoxelClimate::BiomeTintForFace (VoxelClimateProbe.cpp)
	// AND of the surface-proximity gate that wraps it in BuildChunkVertexData
	// (VoxelChunkComponent.cpp ~:192-225, :417-421). Both halves were missing
	// here, and both are visible in ordinary play -- neither is behind a cvar:
	//
	//   * SIDE FACES. BiomeTintForFace returns 140 (not 0) for any non-Z face:
	//     "the riser of a 10 cm step reads as part turf, part exposed soil. A
	//     hard 0 stripes every hillside at voxel pitch." This factory returned 0
	//     for them, so every vertical wall in the world lost its partial biome
	//     blend. That is the larger of the two differences by area.
	//   * CAVE FLOORS. A cave floor is a +Z face too, so face direction alone
	//     paints it grassland green. The CPU path gates on the vertex being
	//     within kSurfaceBandUU of the chunk's surface height; that height now
	//     arrives per chunk in ChunkParams.z.
	//
	// The gate is expressed chunk-locally on both sides. The CPU asks
	// `ComponentWorldOrigin.Z + Pos.Z > ChunkSurfaceZUU - Band`; subtracting
	// ComponentWorldOrigin.Z from both sides gives exactly the test below, with
	// the subtraction done once on the CPU in double precision. So no float32
	// precision is spent on this world's 84 km offset, and the two paths agree
	// bit for bit rather than approximately.
	//
	// 140.0/255.0 and 200.0 are quoted from the CPU constants on purpose; if
	// either moves, both copies have to move together.
	const uint QPositive = (Packed.x >> 4) & 0xfu;
	const float kSurfaceBandUU = 200.0f;
	const bool bNearSurface = Decoded.PositionUU.z > (ChunkSurfaceZRelUU - kSurfaceBandUU);
	const float FaceTint = (Axis == 2u) ? ((QPositive != 0u) ? 1.0f : 0.0f)
	                                    : (140.0f / 255.0f);

	Intermediates.Color = half4(
		bNearSurface ? (half)FaceTint : 0.0h,
		(half)Decoded.AmbientOcclusion,
		(half)ChunkClimate.x,
		(half)ChunkClimate.y);

	// World-planar UVs on the face's two in-plane axes, matching the CPU
	// path's "position / 100, wrapped to a 32 m period". The wrap keeps the
	// value small so float precision stays sub-millimetre no matter how far
	// the chunk sits from the world origin.
	const uint U = (Axis + 1u) % 3u;
	const uint V = (Axis + 2u) % 3u;
	const float UVPeriodM = 32.0f;
	Intermediates.TexCoords = float2(
		fmod(Intermediates.Position[U] / 100.0f, UVPeriodM),
		fmod(Intermediates.Position[V] / 100.0f, UVPeriodM));

	// Voxel GI probe coordinate. Pushed out along the face normal into the air
	// cell in front of the surface, matching the CPU sampler's first probe
	// offset -- the normal is constant across a quad, so doing it here is exact
	// and costs nothing at pixel rate.
	//
	// Intermediates.Position is POOL space, which is the only space this may be
	// computed in: the pool component carries the world's 84 km offset in its
	// double-precision transform, so this value is small and float32-exact,
	// whereas a world position would be quantised to ~1 UU against a 40 UU cell.
	{
		const float kGIProbeOffsetUU = 0.6f * 40.0f;
		const float3 ProbePos = Intermediates.Position + Decoded.Normal * kGIProbeOffsetUU;
		Intermediates.GIUVW = (ProbePos - VoxelGIVol.OriginPoolUU) * VoxelGIVol.InvSizeUU;
	}

	// Rotate the tangent frame into world space, one basis vector at a time.
	//
	// There is no engine-wide "CalcTangentToWorld" -- the vertex factories that
	// appear to call one each define their own local helper. The genuinely
	// shared primitive is RotateLocalToWorld (VertexFactoryCommon.ush:147), and
	// the FDFMatrix overload is the one to use because it works whether or not
	// the factory opts into GPUScene primitive data.
	const FPrimitiveSceneData VoxelPrimitive = Intermediates.SceneData.Primitive;
	Intermediates.TangentToWorld[0] = (half3)RotateLocalToWorld(
		Intermediates.TangentToLocal[0], VoxelPrimitive.LocalToWorld, VoxelPrimitive.InvNonUniformScale);
	Intermediates.TangentToWorld[1] = (half3)RotateLocalToWorld(
		Intermediates.TangentToLocal[1], VoxelPrimitive.LocalToWorld, VoxelPrimitive.InvNonUniformScale);
	Intermediates.TangentToWorld[2] = (half3)RotateLocalToWorld(
		Intermediates.TangentToLocal[2], VoxelPrimitive.LocalToWorld, VoxelPrimitive.InvNonUniformScale);

	return Intermediates;
}

FVertexFactoryInterpolantsVSToPS VertexFactoryGetInterpolantsVSToPS(
	FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates,
	FMaterialVertexParameters VertexParameters)
{
	FVertexFactoryInterpolantsVSToPS Interpolants = (FVertexFactoryInterpolantsVSToPS)0;
	Interpolants.TangentToWorld0 = float4(Intermediates.TangentToWorld[0], 0);
	Interpolants.TangentToWorld2 = float4(Intermediates.TangentToWorld[2], Intermediates.TangentToWorldSign);
	Interpolants.Color = VertexParameters.VertexColor;
	Interpolants.TexCoords = Intermediates.TexCoords;
	Interpolants.GIUVW = Intermediates.GIUVW;
	return Interpolants;
}

half3x3 VertexFactoryGetTangentToLocal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return Intermediates.TangentToLocal;
}

float4 VertexFactoryGetWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return TransformLocalToTranslatedWorld(Intermediates.Position, Intermediates.SceneData.Primitive.LocalToWorld);
}

float3 VertexFactoryGetInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	// No instancing: instance space == primitive space.
	return Intermediates.Position;
}

float4 VertexFactoryGetRasterizedWorldPosition(
	FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float4 InWorldPosition)
{
	return InWorldPosition;
}

float3 VertexFactoryGetPositionForVertexLighting(
	FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float3 TranslatedWorldPosition)
{
	return TranslatedWorldPosition;
}

float3 VertexFactoryGetWorldNormal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return Intermediates.TangentToWorld[2];
}

float4 VertexFactoryGetPreviousWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	// Terrain does not move between frames; the only motion is the camera, so
	// the previous position is this position under the previous transform.
	return mul(float4(Intermediates.Position, 1),
	           DFMultiplyAffineTranslationDemote(Intermediates.SceneData.InstanceData.PrevLocalToWorld,
	                                             ResolvedView.PrevPreViewTranslation));
}

float3 VertexFactoryGetPreviousInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return Intermediates.Position;
}

FMaterialVertexParameters GetMaterialVertexParameters(
	FVertexFactoryInput Input,
	FVertexFactoryIntermediates Intermediates,
	float3 WorldPosition,
	half3x3 TangentToLocal,
	bool bIsPreviousFrame = false)
{
	FMaterialVertexParameters Result = MakeInitializedMaterialVertexParameters();
	Result.SceneData = Intermediates.SceneData;

	Result.WorldPosition = WorldPosition;
	if (bIsPreviousFrame)
	{
		Result.PositionInstanceSpace = VertexFactoryGetPreviousInstanceSpacePosition(Input, Intermediates);
	}
	else
	{
		Result.PositionInstanceSpace = VertexFactoryGetInstanceSpacePosition(Input, Intermediates);
	}
	Result.PositionPrimitiveSpace = Result.PositionInstanceSpace;

	Result.TangentToWorld = Intermediates.TangentToWorld;
	Result.PreSkinnedNormal = TangentToLocal[2];
	Result.PreSkinnedPosition = WorldPosition;
	Result.VertexColor = Intermediates.Color;

#if NUM_MATERIAL_TEXCOORDS_VERTEX
	Result.TexCoords[0] = Intermediates.TexCoords;
#endif

	Result.LWCData = MakeMaterialLWCData(Result);
	return Result;
}

FMaterialPixelParameters GetMaterialPixelParameters(
	FVertexFactoryInterpolantsVSToPS Interpolants, float4 SvPosition)
{
	FMaterialPixelParameters Result = MakeInitializedMaterialPixelParameters();

	Result.TwoSidedSign = 1;

	// VOXEL GI, folded into vertex colour G at PIXEL rate.
	//
	// G already carries the mesher's AO, and the material computes
	// BaseColor = albedo * VertexColor.G * DebugTint, so modulating it here is
	// authoritative for every downstream node and the material graph is
	// untouched. M_VoxelTerrain.uasset does not change for this feature.
	//
	// PER PIXEL, not per vertex, and that is not a luxury. The component path
	// compensates for per-vertex GI by SUBDIVIDING greedy quads
	// (voxel.GI.MaxQuadSpanVoxels); this factory structurally cannot -- every
	// quad is exactly 6 vertices reconstructed from SV_VertexID, and subdividing
	// would multiply the pool's quad count against its memory budget. So
	// per-vertex here would be strictly worse than per-vertex there, while
	// per-pixel is better than either AND deletes the subdivision cost.
	//
	// With Enabled=0 this whole block is skipped and G is byte-identical to what
	// it was before this feature existed.
	half4 VertexColorWithGI = Interpolants.Color;
	// OUTSIDE THE VOLUME, DO NOT SAMPLE AT ALL.
	//
	// This is the majority of the frame, not an edge case: the volume covers
	// +/-N*20 UU (38.4 m at VolumeDim 192) out of a 2 km cascade, so most pixels
	// on screen are outside it. The sampler is AM_Clamp on all three axes, so a
	// lookup out there returns the FACE texel rather than nothing -- which is
	// what step 1 saw as "large smeared bands" and mistook for an addressing bug.
	// Skipping is not an approximation: the fade is clamped to end inside the
	// half-extent, so Weight is already 0 wherever this branch fires. What it
	// buys is the sample itself, one to three of them, on every pixel outside the
	// volume AND in the depth pass, which this masked material also runs.
	const float3 GIUVW = Interpolants.GIUVW;
	const bool bInsideVolume = all(GIUVW > 0.0f) && all(GIUVW < 1.0f);
	if (VoxelGIVol.Enabled != 0u && bInsideVolume)
	{
		// THREE probe offsets, not one, matching FVoxelLightField's
		// kProbeOffsets {0.6, 1.25, 2.0} cells term for term.
		//
		// The single 0.6-cell probe this used to do is not a cheaper
		// approximation of the CPU sampler, it is a DIFFERENT one, and the
		// difference is concentrated exactly where GI matters: a 20 cm roof slab
		// is half a light-field cell thick, so a 0.6-cell push-out along the
		// normal frequently stays inside the slab's own solid cell, finds nothing
		// solved, and falls back to plain AO -- while the CPU walks on to 1.25 and
		// 2.0 cells and finds data. That asymmetry is precisely the roof-underside
		// defect this module already fixed once on the CPU side, and it would have
		// reappeared as a lighting seam at the voxel.Stream.GPUMaxLevel boundary.
		//
		// The VS hands over the first probe's UVW; the extra offsets are the same
		// step along the world normal, which the pool's pure-translation transform
		// makes usable directly. Costs nothing on a hit -- the later samples only
		// execute where the first one missed, which is a small minority of pixels.
		const float3 StepUVW = float3(Interpolants.TangentToWorld2.xyz)
		                     * VoxelGIVol.CellSizeUU * VoxelGIVol.InvSizeUU;
		float3 ProbeUVW = Interpolants.GIUVW;
		float4 T = Texture3DSampleLevel(VoxelGIVol.Volume, VoxelGIVol.VolumeSampler, ProbeUVW, 0);
		if (T.a <= 1.0e-3f)
		{
			ProbeUVW = Interpolants.GIUVW + StepUVW * 0.65f;   // 1.25 cells total
			T = Texture3DSampleLevel(VoxelGIVol.Volume, VoxelGIVol.VolumeSampler, ProbeUVW, 0);
		}
		if (T.a <= 1.0e-3f)
		{
			ProbeUVW = Interpolants.GIUVW + StepUVW * 1.4f;    // 2.0 cells total
			T = Texture3DSampleLevel(VoxelGIVol.Volume, VoxelGIVol.VolumeSampler, ProbeUVW, 0);
		}

		// A is the validity weight, and dividing by it is what makes hardware
		// trilinear reproduce the CPU sampler's "skip unsolved taps and
		// renormalise by the surviving weight" EXACTLY rather than approximately
		// -- same arithmetic, executed by the texture unit. A ~= 0 means no data
		// there, which falls back to plain AO, matching the CPU's miss path.
		const float W = T.a;
		if (W > 1.0e-3f)
		{
			// Ambient-cube slot from the face normal. Every greedy-mesh normal is
			// axis-aligned, so exactly one slot is selected and the floor/ceiling
			// distinction the light field exists for is preserved.
			const float Nz = Interpolants.TangentToWorld2.z;
			const float Irr = ((Nz > 0.5f) ? T.r : ((Nz < -0.5f) ? T.g : T.b)) / W;

			// Distance from this pixel to the CAMERA, which is what the CPU shade
			// measures (Dist(WorldPos, GICentreUU)). NOT the distance to the
			// volume centre, which is what this used to compute: the volume origin
			// only follows the camera to within the re-centring dead zone
			// (voxel.GI.VolumeRecentreCells, 2560 UU by default), so measuring
			// from it slides the whole fade band by up to that much and puts a
			// slowly moving brightness gradient on stationary geometry.
			//
			// The pixel's own pool-space position is recovered from the UVW rather
			// than carried as a second interpolant -- and it must be the FIRST
			// probe's UVW, not whichever fallback hit, so the fade does not step
			// by a cell where the fallback engages.
			const float3 ProbePoolUU = Interpolants.GIUVW / VoxelGIVol.InvSizeUU
			                         + VoxelGIVol.OriginPoolUU;
			const float DistUU = length(ProbePoolUU - VoxelGIVol.FadeCentrePoolUU);
			const float Fade = 1.0f - saturate((DistUU - VoxelGIVol.FadeStartUU)
			                                 / max(1.0f, VoxelGIVol.FadeEndUU - VoxelGIVol.FadeStartUU));
			const float Ambient = lerp(VoxelGIVol.AmbientFloor, 1.0f, saturate(Irr));
			const float Weight = saturate(VoxelGIVol.Strength * Fade);

			// Must match VoxelChunkComponent.cpp's shade term for term:
			// voxel.Stream.GPUMaxLevel puts both renderers in one frame, so a
			// divergence here shows up as a lighting seam at the ring boundary.
			VertexColorWithGI.g *= (half)lerp(1.0f, Ambient, Weight);

			// DebugVis 3: show the sampled value raw, ignoring AO and the fade.
			// Kept permanently -- a pooled primitive fails silently, and this is
			// the cheapest proof the path is reachable from the PIXEL shader.
			if (VoxelGIVol.DebugVis == 3u)
			{
				VertexColorWithGI.g = (half)saturate(Irr);
			}
		}
	}
	Result.VertexColor = VertexColorWithGI;

	half3 TangentToWorld0 = Interpolants.TangentToWorld0.xyz;
	half4 TangentToWorld2 = Interpolants.TangentToWorld2;
	Result.UnMirrored = TangentToWorld2.w;
	Result.TangentToWorld = AssembleTangentToWorld(TangentToWorld0, TangentToWorld2);

#if NUM_TEX_COORD_INTERPOLATORS
	Result.TexCoords[0] = Interpolants.TexCoords;
#endif

	return Result;
}

float4 VertexFactoryGetTranslatedPrimitiveVolumeBounds(FVertexFactoryInterpolantsVSToPS Interpolants)
{
	FPrimitiveSceneData PrimitiveData = GetPrimitiveDataFromUniformBuffer();
	return float4(DFFastToTranslatedWorld(PrimitiveData.ObjectWorldPosition, ResolvedView.PreViewTranslation),
	              PrimitiveData.ObjectRadius);
}

uint VertexFactoryGetPrimitiveId(FVertexFactoryInterpolantsVSToPS Interpolants)
{
	// Not using GPUScene primitive IDs -- the per-draw primitive uniform buffer
	// carries everything this factory needs.
	return 0;
}

// Must come last: supplies defaults for the optional interface hooks this
// factory does not override.
#include "/Engine/Private/VertexFactoryDefaultInterface.ush"
