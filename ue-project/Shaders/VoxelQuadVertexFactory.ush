// Vertex factory for GPU-resident voxel quads (ADR-0006, G2).
//
// There is NO VERTEX BUFFER. The GPU mesher writes packed quads (8 bytes each)
// into a persistent pool, and this factory reconstructs every corner from
// SV_VertexID alone: 6 vertices per quad, two triangles, no index buffer.
// That is the whole point of ADR-0006 -- geometry never round-trips through the
// CPU, so streaming a chunk in or out never touches FScene.
//
// Modelled on FLidarPointCloudVertexFactory (Engine/Plugins/Enterprise/
// LidarPointCloud), which does the same trick: read a buffer by SV_VertexID and
// expand each entry into a quad in the vertex shader.
//
// The decode itself lives in VoxelQuadDecode.ush and is verified bit-exact
// against a CPU reference by voxel.GPU.VerifyRegion -- so if terrain looks
// wrong, the bug is in THIS file (framing, transforms, material plumbing),
// not in the unpacking.

#include "/Engine/Private/VertexFactoryCommon.ush"
#include "/VoxelEarth/VoxelQuadDecode.ush"
// ADR-0008's palette, generated from vxc::kMaterialPalette by
// ue-project/Tools/gen_material_palette_ush.py. It brings the table, the
// evaluation, and the two route functions this factory calls (VoxelPalettePack
// per vertex, VoxelPaletteUnpack per pixel). Everything the route DECIDES lives
// there because that file is compiled by DXC from tools/compile-shaders.ps1 and
// this one cannot be -- see the block above GetMaterialPixelParameters.
#include "/VoxelEarth/VoxelMaterialPalette.ush"

// The quad pool and its framing arrive in the VoxelVF uniform buffer, declared
// by FVoxelQuadVertexFactoryParameters and injected into this shader by the
// engine. Members are reached THROUGH the struct -- VoxelVF.QuadBuffer -- not
// as loose globals of that name. Declaring loose globals here instead compiles
// perfectly and then silently reads zeros, because they are different, unbound
// symbols. So there is deliberately nothing to declare in this file.

struct FVertexFactoryInput
{
	// No ATTRIBUTE bindings at all -- the vertex declaration is empty (see
	// FVoxelQuadVertexFactory::InitRHI). SV_VertexID is a system value, not a
	// stream, so it arrives without any vertex buffer bound.
	// Zero-stride dummy, never read. It exists only because a draw going
	// through the mesh-pass system needs a vertex declaration to describe --
	// see FVoxelQuadVertexFactory::InitRHI.
	half4 DummyAttribute : ATTRIBUTE0;

	uint VertexId : SV_VertexID;

	VF_INSTANCED_STEREO_DECLARE_INPUT_BLOCK()
	VF_MOBILE_MULTI_VIEW_DECLARE_INPUT_BLOCK()
};

struct FVertexFactoryInterpolantsVSToPS
{
	TANGENTTOWORLD_INTERPOLATOR_BLOCK

	half4  Color     : COLOR0;
	float2 TexCoords : TEXCOORD0;
	// Voxel GI lookup, as a [0,1] volume coordinate rather than a position.
	// Carrying UVW keeps the magnitudes small (perfect interpolation precision)
	// and makes the distance fade recoverable without a second interpolant.
	// TEXCOORD1 is free -- TANGENTTOWORLD_INTERPOLATOR_BLOCK lands on
	// TEXCOORD10/11 (+15), not here.
	float3 GIUVW     : TEXCOORD1;

	// ADR-0008 MATERIAL PALETTE (xyz = voxel-space position, w = mat|faceClass<<8).
	//
	// COSTS NOTHING UNTIL A MATERIAL ASKS FOR IT. The guard is the same condition
	// that decides whether GetMaterialPixelParameters can write TexCoords[3]/[4]
	// at all, so a material that does not read UV3/UV4 -- M_WaterVoxel, and
	// M_VoxelTerrain before its graph is regenerated -- compiles this member away
	// along with everything that fills it. That is what keeps this change inert:
	// not "cheap", absent.
	//
	// WHY AN INTERPOLANT AT ALL, when the local-lights route adds none. Local
	// lights compute a colour from data already at pixel rate; the palette needs
	// the pixel's own VOXEL, and nothing already carried identifies it.
	// VertexColor is full (R surface flag, G AO, B/A climate), TexCoords[0] is
	// the detail UV and is wrapped to a 32 m period -- hashing on it would tile
	// the tint every 320 voxels and still be missing the third axis. GIUVW does
	// encode a position, but it is the GI probe point (pushed 0.6 cells along the
	// normal, recovered through VoxelGIVol's own origin and inverse size), so
	// reading the palette out of it would make a colour depend on a lighting
	// volume's uniforms -- including whatever they hold when GI is off.
#if NUM_TEX_COORD_INTERPOLATORS > 4
	float4 VoxelPalette : TEXCOORD2;
#endif
};

struct FVertexFactoryIntermediates
{
	half3x3 TangentToLocal;
	half3x3 TangentToWorld;
	half    TangentToWorldSign;
	half4   Color;
	float3  Position;      // primitive space, unreal units
	float2  TexCoords;
	float3  GIUVW;
#if NUM_TEX_COORD_INTERPOLATORS > 4
	float4  VoxelPalette;
#endif

	FSceneDataIntermediates SceneData;
};

// Builds a tangent frame for a voxel face. The quad's own u/v axes are two of
// the three world axes, so for an axis-aligned normal the frame is exact rather
// than approximated.
//
// The Gram-Schmidt below is for the ONE case where the normal is not axis
// aligned: the top of a water surface quad, whose shading normal is tilted by
// its four corner heights. Both dot products are EXACTLY zero for an
// axis-aligned normal, so the subtraction is the identity there and every
// terrain face gets back the frame it had before this existed, bit for bit.
// Deliberately not re-normalised: the tilt is bounded by half a voxel of height
// over a voxel of span, so the shortening is under a percent, and normalising
// would perturb the axis-aligned case through rsqrt.
half3x3 VoxelBuildTangentFrame(float3 Normal, uint Axis)
{
	const uint U = (Axis + 1u) % 3u;
	const uint V = (Axis + 2u) % 3u;

	float3 Tangent = float3(0.0f, 0.0f, 0.0f);
	float3 Bitangent = float3(0.0f, 0.0f, 0.0f);
	Tangent[U] = 1.0f;
	Bitangent[V] = 1.0f;
	Tangent -= Normal * dot(Normal, Tangent);
	Bitangent -= Normal * dot(Normal, Bitangent);

	half3x3 Frame;
	Frame[0] = (half3)Tangent;
	Frame[1] = (half3)Bitangent;
	Frame[2] = (half3)Normal;
	return Frame;
}

FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
{
	FVertexFactoryIntermediates Intermediates = (FVertexFactoryIntermediates)0;
	Intermediates.SceneData = VF_GPUSCENE_GET_INTERMEDIATES(Input);

	// WHERE THIS DRAW STARTS IN THE POOL COMES FROM VoxelRange.BaseQuad, NOT
	// FROM SV_VertexID.
	//
	// SV_VertexID does not include the draw's base vertex on D3D12
	// (RHISupportsAbsoluteVertexID is Vulkan-only), so a draw that starts at
	// pool quad F still sees VertexId running from 0. Every draw therefore
	// starts at vertex 0 and names F explicitly -- the same idiom
	// FLocalVertexFactory uses for VF_VertexOffset. BaseQuad is 0 for the single
	// full-pool draw and for the single-chunk component, so those are unchanged.
	//
	// Measured, not assumed: with this expression reading SV_VertexID alone,
	// tiling the pool into N exact contiguous ranges drew only the first 1/N of
	// it at N = 2, 8 and 64 while still paying for every quad. See
	// docs/gpu-waves-plan.md "Wave A".
	const uint QuadIndex = VoxelRange.BaseQuad + (Input.VertexId / VOXEL_VERTICES_PER_QUAD);
	const uint CornerIndex = Input.VertexId % VOXEL_VERTICES_PER_QUAD;

	const uint2 Packed = VoxelVF.QuadBuffer[QuadIndex];

	// In pool mode every quad names its own chunk, so one draw can span the
	// whole pool with no per-draw state. In single-chunk mode the framing comes
	// from the uniform buffer instead.
	float3 ChunkOrigin = VoxelVF.ChunkOriginUU;
	float ChunkScale = VoxelVF.LevelScale;
	float2 ChunkClimate = float2(0.5f, 0.5f);
	// The terrain surface over this chunk as a PLANE, in the chunk's own frame:
	// ChunkSurfaceZRelUU is its value at the chunk's XY ORIGIN (not its centre --
	// that is what lets this be evaluated without knowing the chunk's level), and
	// ChunkSurfaceGradPacked carries the two gradients.
	//
	// Single-chunk mode has no per-chunk table, so it takes the "no subsystem"
	// fallback BuildChunkVertexData uses: everything counts as surface.
	float ChunkSurfaceZRelUU = -1.0e30f;
	float ChunkSurfaceGradPacked = 0.0f;
	if (VoxelVF.PoolMode != 0u)
	{
		const uint ChunkId = VoxelVF.QuadChunkIds[QuadIndex];
		const float4 Entry = VoxelVF.ChunkOrigins[ChunkId];
		ChunkOrigin = Entry.xyz;
		ChunkScale = Entry.w;
		const float4 Params = VoxelVF.ChunkParams[ChunkId];
		ChunkClimate = Params.xy;
		ChunkSurfaceZRelUU = Params.z;
		ChunkSurfaceGradPacked = Params.w;
	}

	// PER-CORNER WATER SURFACE HEIGHTS, water pools only.
	//
	// A second SRV parallel to the quad pool, four bytes per quad, allocated only
	// when this pool draws water (see UVoxelGpuPoolComponent::InitPool -- at
	// terrain's capacity it would be hundreds of megabytes for a field terrain
	// never reads). Terrain binds a same-typed dummy so the uniform buffer has no
	// unbound member, which is a validation failure rather than a tolerated
	// no-op, and the read is gated so the dummy is never actually touched.
	uint PackedCorners = 0u;
	if (VoxelVF.WaterMode != 0u)
	{
		PackedCorners = VoxelVF.QuadCornerHeights[QuadIndex];
	}

	const FVoxelQuadVertex Decoded = DecodeVoxelQuadVertexCore(
		Packed, CornerIndex, ChunkScale, PackedCorners, VoxelVF.WaterMode != 0u);
	Intermediates.Position = Decoded.PositionUU + ChunkOrigin;

// TEMPORARY BISECT (VOXEL_VF_DEBUG_QUAD). Replaces all real geometry with one
// large flat quad at the primitive origin. If this shows up and the real
// geometry does not, the draw plumbing is fine and the fault is in the decoded
// positions; if even this is invisible, the draw itself never rasterises and
// the empty vertex declaration is the prime suspect. Remove once resolved.
#if VOXEL_VF_DEBUG_QUAD
	{
		// A CUBE, not a single quad.
		//
		// The first version of this test drew one horizontal quad and concluded
		// from its absence that the draw never rasterises. That conclusion was
		// unsound: the quad sat above the camera, so we were looking at its
		// underside, and backface culling alone would explain the blank frame.
		//
		// Six outward-facing sides cannot all be culled from any viewpoint, so
		// this version distinguishes "nothing rasterises" from "I aimed a
		// single-sided surface away from the camera".
		const float S = 2000.0f;   // 20 m
		const uint Face = QuadIndex;
		const uint FAxis = Face / 2u;
		const bool bPositiveFace = (Face % 2u) == 1u;
		const uint FU = (FAxis + 1u) % 3u;
		const uint FV = (FAxis + 2u) % 3u;

		float2 Fwd[6] = { float2(0,0), float2(0,S), float2(S,S),
		                  float2(0,0), float2(S,S), float2(S,0) };
		float2 Rev[6] = { float2(0,0), float2(S,S), float2(0,S),
		                  float2(0,0), float2(S,0), float2(S,S) };
		const float2 C = bPositiveFace ? Fwd[CornerIndex] : Rev[CornerIndex];

		float3 P = float3(0.0f, 0.0f, 0.0f);
		P[FAxis] = bPositiveFace ? S : 0.0f;
		P[FU] = C.x;
		P[FV] = C.y;

		// Faces 0-5 form the cube; every other quad collapses to a point.
		Intermediates.Position = (QuadIndex < 6u) ? P : float3(0.0f, 0.0f, 0.0f);
	}
#endif

	const uint Axis = Packed.x & 0xfu;
	// ShadingNormal, not Normal: identical for terrain and for every water face
	// except the top of a surface quad, which tilts with its four corner heights.
	// Decoded.Normal stays the geometric face direction and is what the GI probe
	// push-out below uses -- that one must step into the AIR CELL in front of the
	// face, which is a question about which way the face points, not about how
	// its top is shaded.
	Intermediates.TangentToLocal = VoxelBuildTangentFrame(Decoded.ShadingNormal, Axis);
	Intermediates.TangentToWorldSign = 1.0h;

	// Matches the CPU path's vertex colour layout (BuildChunkVertexData):
	//   R = material id, G = ambient occlusion, B/A = climate.
	//
	// KNOWN GAP: climate (B = temperature, A = precipitation) is sampled on the
	// CPU from a 30 m raster and is not available here yet, so both are held at
	// the neutral midpoint. Expect the GPU path's biome tint to differ from the
	// CPU path until G4 supplies climate GPU-side. This is a predicted
	// difference, not a bug to chase during the G2 visual A/B.
	// B/A carry climate, sampled once per chunk on the CPU and looked up above.
	// Single-chunk mode has no per-chunk table, so they stay neutral there and
	// its biome tint will differ from the CPU path -- pool mode is the one
	// that matches.
	// R is a BINARY sky-facing flag, not the material id.
	//
	// The CPU path documents this at length (VoxelClimateProbe.h): thresholding
	// a categorical id through the FColor->shader transform proved unreliable,
	// so R is 0 or 255 -- the fixed points of any monotonic per-channel
	// transform -- and surface-ness is derived from FACE DIRECTION rather than
	// material id, because the ids voxel-core actually emits here are only
	// MAT_ROCK and MAT_SUBSOIL. Writing the id instead makes every quad read as
	// subsurface, which is exactly the grey/tan the first pool render showed.
	//
	// R is a full mirror of VoxelClimate::BiomeTintForFace (VoxelClimateProbe.cpp)
	// AND of the surface-proximity gate that wraps it in BuildChunkVertexData
	// (VoxelChunkComponent.cpp ~:192-225, :417-421). Both halves were missing
	// here, and both are visible in ordinary play -- neither is behind a cvar:
	//
	//   * SIDE FACES. BiomeTintForFace returns 140 (not 0) for any non-Z face:
	//     "the riser of a 10 cm step reads as part turf, part exposed soil. A
	//     hard 0 stripes every hillside at voxel pitch." This factory returned 0
	//     for them, so every vertical wall in the world lost its partial biome
	//     blend. That is the larger of the two differences by area.
	//   * CAVE FLOORS. A cave floor is a +Z face too, so face direction alone
	//     paints it grassland green. The CPU path gates on the vertex being
	//     within kSurfaceBandUU of the surface ABOVE IT; that surface arrives per
	//     chunk as a plane in ChunkParams.z (height at the chunk's XY origin) and
	//     ChunkParams.w (its two gradients, packed).
	//
	// The gate is expressed chunk-locally on both sides. The CPU asks
	// `ComponentWorldOrigin.Z + Pos.Z > SurfaceAt(Pos.xy) - Band`; subtracting
	// ComponentWorldOrigin.Z from both sides gives exactly the test below, with
	// the subtraction done once on the CPU in double precision. So no float32
	// precision is spent on this world's 84 km offset, and the two paths evaluate
	// the same plane from the same quantised coefficients. They agree to float32
	// rounding on the two products, not bit-for-bit as the single-height form
	// did -- a vertex sitting within an ULP of the band edge could in principle
	// resolve differently on the two renderers. That is one vertex's tint at the
	// boundary of a 2 m band, and the pooled path is the shipping renderer.
	//
	// 140.0/255.0 and 200.0 are quoted from the CPU constants on purpose; if
	// either moves, both copies have to move together.
	//
	// THE REFERENCE IS A PLANE, added for task #44. It was one height sampled at
	// the chunk CENTRE against this same fixed 2 m band, which is fine at L0
	// (3.2 m chunk) and wrong by a factor of 32 at L5 (102.4 m chunk): on a slope
	// most of a coarse chunk's sky-facing faces fell outside the band and lost
	// the tint, and a HORIZONTAL cut through a tilted voxel staircase is a
	// chevron -- the lattice measured in
	// docs/measurements/hatching-lattice-diagnosis-2026-08-03.txt. The band is
	// unchanged at 2 m on purpose: widening it with chunk size was the cheaper
	// candidate and it would have paid for the slope with the cave guard.
	//
	// TRANSCRIPTION of VoxelClimate::UnpackSurfaceGradients / SurfaceZRelAt
	// (VoxelClimateProbe.h), which is also what the component path evaluates on
	// the CPU. Both halves of the mirror move together or the two renderers
	// disagree about where the ground is. Packed 0 -- water's params, the pool's
	// hidden entry, single-chunk mode -- decodes to a flat plane, i.e. to exactly
	// the behaviour that was here before.
	const uint QPositive = (Packed.x >> 4) & 0xfu;
	const float kSurfaceBandUU = 200.0f;
	float SurfaceDZDX = 0.0f;
	float SurfaceDZDY = 0.0f;
	if (ChunkSurfaceGradPacked > 0.0f)
	{
		// Integer split. floor(x/4096) is also exact for a 12+12 field -- checked
		// over all 4095 x 4095 packings, zero mismatches -- because the quotient
		// needs exactly the 24 bits float32 has. This form does not depend on
		// that coincidence and is cheaper. See VoxelClimateProbe.h.
		const uint GradBits = (uint)ChunkSurfaceGradPacked;
		SurfaceDZDX = (float((GradBits >> 12u) & 0xFFFu) - 2048.0f) / 256.0f;
		SurfaceDZDY = (float(GradBits & 0xFFFu) - 2048.0f) / 256.0f;
	}
	const float SurfaceZHereRelUU = ChunkSurfaceZRelUU
		+ SurfaceDZDX * Decoded.PositionUU.x
		+ SurfaceDZDY * Decoded.PositionUU.y;
	const bool bNearSurface = Decoded.PositionUU.z > (SurfaceZHereRelUU - kSurfaceBandUU);
	const float FaceTint = (Axis == 2u) ? ((QPositive != 0u) ? 1.0f : 0.0f)
	                                    : (140.0f / 255.0f);

	// WATER MODE overrides R entirely, and only R.
	//
	// Everything above this line is terrain's biome plumbing, which water has no
	// use for: there is no biome, and the surface-height gate is meaningless for
	// a water brick. What water needs in R is the CA fill fraction 0..255, which
	// the water mesher's occupancy sampler writes into the quad's `mat` byte
	// (UVoxelWaterSubsystem.cpp) precisely so it rides this existing encoding
	// with no second decode path.
	//
	// This is what M_WaterVoxel's World Position Offset reads to seat each
	// surface cell's top face at its own fill height. Without this branch the
	// pooled path would hand it the biome flag -- 1.0 for every +Z face -- and
	// every water surface would draw at full height, silently agreeing with the
	// old >=128 behaviour while the component path showed the stepped surface.
	//
	// The component path needs no equivalent: FWaterChunkSceneProxy already
	// writes the same byte into R directly.
	// B likewise: terrain carries per-chunk climate there, water carries the
	// per-vertex top-boundary flag the World Position Offset needs to lower a
	// partial cell's surface without shearing its side walls. See
	// FVoxelQuadVertex::TopBoundary.
	//
	// R IS NOW PER-CORNER, not per-face: Decoded.CornerHeight is this corner's
	// own surface height within its cell, so a merged surface quad's top is a
	// bilinear patch rather than a plateau and two neighbouring cells of
	// different fill meet exactly instead of leaving an open slit between them.
	// With no corner data the field falls back to MaterialId/255, which is the
	// value this line read before -- so terrain and the decode test are
	// unaffected in every path.
	const bool bWater = (VoxelVF.WaterMode != 0u);
	const float TerrainTintR = bNearSurface ? FaceTint : 0.0f;

	// DEBUG WATER MARKER (vxc::MAT_WATERMARK == 15), and the one place in this
	// renderer where a material id can still be trusted.
	//
	// THIS IS THE PATH THAT ACTUALLY DRAWS. voxel.Stream.GPU is on by default, so
	// terrain streams as packed quads through this factory and NOT through
	// UVoxelChunkComponent's vertex builder. The marker was written against that
	// builder, which is why it was invisible for a whole session: its geometry
	// exists (120,072 quads measured on one pose with the pool off) and the
	// pooled renderer simply never carried the distinction.
	//
	// AND THE ID IS RELIABLE HERE, which it is not on the CPU path.
	// VoxelClimateProbe.h records why R had to stop carrying the id: an
	// exposure-proof probe measured VertexColor.R * 255 arriving as ~6-8 where
	// the CPU wrote 4, so every categorical threshold read 0. That transform is
	// the FColor vertex-attribute path. Decoded.MaterialId is unpacked from the
	// quad's own bits inside this shader and never touches it, so an exact
	// integer compare is sound.
	//
	// The sentinel is the same one the material decodes: R=1, B=0, A=0. B and A
	// are temperature and precipitation, which a marker voxel has no use for --
	// it is an instrument, not terrain, and must not take a biome colour.
	//
	// This is deliberately a per-id branch on one id. It is also the smallest
	// possible instance of the thing biomes need next: per-material appearance
	// in the pooled renderer. If this reads correctly, the same hook generalises
	// to a real per-id lookup here, where the id survives.
	const bool bMarker = (!bWater) && (Decoded.MaterialId == 15u)
	                     && (VoxelVF.WaterMarkerOpacity >= 0.5f);

	const float ColorR = bWater ? Decoded.CornerHeight : (bMarker ? 1.0f : TerrainTintR);
	const float ColorB = bWater ? Decoded.TopBoundary : (bMarker ? 0.0f : ChunkClimate.x);
	const float ColorA = bMarker ? 0.0f : ChunkClimate.y;

	// G STAYS AMBIENT OCCLUSION, INCLUDING ON MARKER QUADS. It briefly carried
	// voxel.WaterMarker.Opacity so the material could dither the marker away,
	// and that was wrong in a way worth recording: the GI pixel path scales G
	// (`VertexColorWithGI.g *= lerp(1, Ambient, Weight)` below), and the GI
	// volume only covers about +/-38 m around the camera. So the marker went
	// see-through EXACTLY when flown close to -- reported as "flying close to
	// the magenta blocks changes the rendering such that water volume is
	// transparent and completely see through". Overloading a channel the
	// renderer already modulates makes the debug signal a function of lighting.
	//
	// Visibility is therefore binary and decided HERE, where the uniform is
	// readable: below 0.5 the quad simply does not take the sentinel and renders
	// as ordinary terrain, which is the A/B ("is a magenta shape hiding
	// landform?") without a re-mesh or a relaunch. Dithered see-through needs a
	// channel nothing else touches, or a real material parameter; it is not
	// worth a lighting-dependent instrument.
	const float ColorG = Decoded.AmbientOcclusion;

	Intermediates.Color = half4(
		(half)ColorR,
		(half)ColorG,
		(half)ColorB,
		(half)ColorA);

	// --- ADR-0008 MATERIAL PALETTE ------------------------------------------
	//
	// This is the hook the marker branch above was described as the smallest
	// instance of, generalised: a real per-material appearance in the pooled
	// renderer. The id is trustworthy HERE for the reason recorded there --
	// Decoded.MaterialId is unpacked from the quad's own bits inside this shader
	// and never goes through the FColor vertex-attribute transform that made
	// VertexColor.R * 255 arrive as ~6-8 where the CPU wrote 4
	// (VoxelClimateProbe.h). The whole feature rests on that measurement.
	//
	// ALL IT DOES IS PACK. The colour is evaluated per PIXEL (see
	// GetMaterialPixelParameters), because greedy meshing merges up to eight
	// voxels into one quad and ADR-0008 invariant 2 keys the tint to the voxel:
	// evaluated here, one quad would be one colour and a bark trunk would read
	// as flat panels.
	//
	// WATER PASSES 0. In a water pool the quad's `mat` byte is the CA fill
	// fraction, not a material id (UVoxelWaterSubsystem's EmitWaterQuads writes
	// it there deliberately so it rides the existing encoding), so feeding it to
	// the palette would index the table with a fill level. 0 is MAT_AIR, whose
	// row is black with no variation, and water's own material does not read
	// these UVs anyway.
#if NUM_TEX_COORD_INTERPOLATORS > 4
	Intermediates.VoxelPalette = VoxelPalettePack(
		Decoded.PositionUU,
		ChunkOrigin,
		Decoded.Normal,                       // GEOMETRIC, not shading -- this
		                                      // asks which way the face points
		VOXEL_SIZE_UU * ChunkScale,           // the quad's own voxel size
		VOXEL_SIZE_UU,                        // ...and a LEVEL-0 one, so the pack
		                                      // can put this ring's level in the
		                                      // key. The pixel half needs the
		                                      // cube's WORLD size to evaluate a
		                                      // world-metric patch wavelength and
		                                      // there is no interpolant left to
		                                      // spend on it.
		bWater ? 0u : Decoded.MaterialId,
		Axis,
		QPositive != 0u);
#endif

	// World-planar UVs on the face's two in-plane axes, matching the CPU
	// path's "position / 100, wrapped to a 32 m period". The wrap keeps the
	// value small so float precision stays sub-millimetre no matter how far
	// the chunk sits from the world origin.
	//
	// THE WRAP IS NOW A POSITIVE MODULO, NOT fmod, AND THAT IS A BUG FIX
	// (2026-08-11). HLSL's fmod carries the SIGN OF ITS ARGUMENT: fmod(-5, 32)
	// is -5, not 27. So this coordinate was an ODD function through world x = 0
	// and y = 0, and every consumer that feeds it into anything with odd
	// symmetry -- a sine, a signed noise, a detail texture read as a
	// perturbation -- got a field that is MIRRORED about both world axes. That
	// is a real repeating-pattern artefact and it is invisible unless you happen
	// to stand at the origin, which is why it survived this long.
	//
	// frac(x / P) * P is the same period, always in [0, P), continuous
	// everywhere except at the period boundary where it was discontinuous
	// anyway. It costs the same.
	//
	// AND IT CHANGES NOTHING THAT EXISTS TODAY, which was checked rather than
	// hoped for. For positive coordinates the two expressions are identical; for
	// negative ones they differ by EXACTLY ONE PERIOD (fmod(-65102, 32) = -14,
	// frac(-65102/32)*32 = 18, and 18 - (-14) = 32). The only consumer of this
	// UV is the terrain/clipmap detail texture at 8 m tiling, and 8 divides 32,
	// so a whole-period offset lands on the same texel. Measured on the pinned
	// lake pose at world (-65102, -51084) m: 0.00% of sky pixels and 0.10% of
	// far-terrain pixels differ by more than 8/255 across this change. What it
	// removes is the LATENT trap -- the next consumer with odd symmetry that is
	// not periodic in 32 m would have inherited a mirrored world, and the water
	// ripple was exactly that consumer.
	//
	// WATER NO LONGER READS THIS AT ALL, and that is the other half of the same
	// fix. M_WaterVoxel used to build its ripple normal on TEXCOORD0, which
	// meant the lake surface carried a literal 32 m repeating tile with a mirror
	// down the middle of the world -- the owner's "looks like a repeating tile".
	// Its wave field is now keyed on absolute world XY instead, which has no
	// period, and which the far-field lake sheets can also agree with (they
	// CANNOT adopt a wrapped UV: AVoxelWaterSheetActor rectangles run to a
	// kilometre and a wrap boundary inside one quad would smear the whole period
	// across it). What still reads TEXCOORD0 is the terrain and clipmap detail
	// texture, which is why the wrap and its precision argument stay.
	const uint U = (Axis + 1u) % 3u;
	const uint V = (Axis + 2u) % 3u;
	const float UVPeriodM = 32.0f;
	Intermediates.TexCoords = float2(
		frac((Intermediates.Position[U] / 100.0f) / UVPeriodM) * UVPeriodM,
		frac((Intermediates.Position[V] / 100.0f) / UVPeriodM) * UVPeriodM);

	// Voxel GI probe coordinate. Pushed out along the face normal into the air
	// cell in front of the surface, matching the CPU sampler's first probe
	// offset -- the normal is constant across a quad, so doing it here is exact
	// and costs nothing at pixel rate.
	//
	// Intermediates.Position is POOL space, which is the only space this may be
	// computed in: the pool component carries the world's 84 km offset in its
	// double-precision transform, so this value is small and float32-exact,
	// whereas a world position would be quantised to ~1 UU against a 40 UU cell.
	{
		const float kGIProbeOffsetUU = 0.6f * 40.0f;
		const float3 ProbePos = Intermediates.Position + Decoded.Normal * kGIProbeOffsetUU;
		Intermediates.GIUVW = (ProbePos - VoxelGIVol.OriginPoolUU) * VoxelGIVol.InvSizeUU;
	}

	// Rotate the tangent frame into world space, one basis vector at a time.
	//
	// There is no engine-wide "CalcTangentToWorld" -- the vertex factories that
	// appear to call one each define their own local helper. The genuinely
	// shared primitive is RotateLocalToWorld (VertexFactoryCommon.ush:147), and
	// the FDFMatrix overload is the one to use because it works whether or not
	// the factory opts into GPUScene primitive data.
	const FPrimitiveSceneData VoxelPrimitive = Intermediates.SceneData.Primitive;
	Intermediates.TangentToWorld[0] = (half3)RotateLocalToWorld(
		Intermediates.TangentToLocal[0], VoxelPrimitive.LocalToWorld, VoxelPrimitive.InvNonUniformScale);
	Intermediates.TangentToWorld[1] = (half3)RotateLocalToWorld(
		Intermediates.TangentToLocal[1], VoxelPrimitive.LocalToWorld, VoxelPrimitive.InvNonUniformScale);
	Intermediates.TangentToWorld[2] = (half3)RotateLocalToWorld(
		Intermediates.TangentToLocal[2], VoxelPrimitive.LocalToWorld, VoxelPrimitive.InvNonUniformScale);

	return Intermediates;
}

FVertexFactoryInterpolantsVSToPS VertexFactoryGetInterpolantsVSToPS(
	FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates,
	FMaterialVertexParameters VertexParameters)
{
	FVertexFactoryInterpolantsVSToPS Interpolants = (FVertexFactoryInterpolantsVSToPS)0;
	Interpolants.TangentToWorld0 = float4(Intermediates.TangentToWorld[0], 0);
	Interpolants.TangentToWorld2 = float4(Intermediates.TangentToWorld[2], Intermediates.TangentToWorldSign);
	Interpolants.Color = VertexParameters.VertexColor;
	Interpolants.TexCoords = Intermediates.TexCoords;
	Interpolants.GIUVW = Intermediates.GIUVW;
#if NUM_TEX_COORD_INTERPOLATORS > 4
	Interpolants.VoxelPalette = Intermediates.VoxelPalette;
#endif
	return Interpolants;
}

half3x3 VertexFactoryGetTangentToLocal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return Intermediates.TangentToLocal;
}

float4 VertexFactoryGetWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return TransformLocalToTranslatedWorld(Intermediates.Position, Intermediates.SceneData.Primitive.LocalToWorld);
}

float3 VertexFactoryGetInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	// No instancing: instance space == primitive space.
	return Intermediates.Position;
}

float4 VertexFactoryGetRasterizedWorldPosition(
	FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float4 InWorldPosition)
{
	return InWorldPosition;
}

float3 VertexFactoryGetPositionForVertexLighting(
	FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float3 TranslatedWorldPosition)
{
	return TranslatedWorldPosition;
}

float3 VertexFactoryGetWorldNormal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return Intermediates.TangentToWorld[2];
}

float4 VertexFactoryGetPreviousWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	// Terrain does not move between frames; the only motion is the camera, so
	// the previous position is this position under the previous transform.
	return mul(float4(Intermediates.Position, 1),
	           DFMultiplyAffineTranslationDemote(Intermediates.SceneData.InstanceData.PrevLocalToWorld,
	                                             ResolvedView.PrevPreViewTranslation));
}

float3 VertexFactoryGetPreviousInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return Intermediates.Position;
}

FMaterialVertexParameters GetMaterialVertexParameters(
	FVertexFactoryInput Input,
	FVertexFactoryIntermediates Intermediates,
	float3 WorldPosition,
	half3x3 TangentToLocal,
	bool bIsPreviousFrame = false)
{
	FMaterialVertexParameters Result = MakeInitializedMaterialVertexParameters();
	Result.SceneData = Intermediates.SceneData;

	Result.WorldPosition = WorldPosition;
	if (bIsPreviousFrame)
	{
		Result.PositionInstanceSpace = VertexFactoryGetPreviousInstanceSpacePosition(Input, Intermediates);
	}
	else
	{
		Result.PositionInstanceSpace = VertexFactoryGetInstanceSpacePosition(Input, Intermediates);
	}
	Result.PositionPrimitiveSpace = Result.PositionInstanceSpace;

	Result.TangentToWorld = Intermediates.TangentToWorld;
	Result.PreSkinnedNormal = TangentToLocal[2];
	Result.PreSkinnedPosition = WorldPosition;
	Result.VertexColor = Intermediates.Color;

#if NUM_MATERIAL_TEXCOORDS_VERTEX
	Result.TexCoords[0] = Intermediates.TexCoords;
#endif

	Result.LWCData = MakeMaterialLWCData(Result);
	return Result;
}

FMaterialPixelParameters GetMaterialPixelParameters(
	FVertexFactoryInterpolantsVSToPS Interpolants, float4 SvPosition)
{
	FMaterialPixelParameters Result = MakeInitializedMaterialPixelParameters();

	Result.TwoSidedSign = 1;

	// VOXEL GI, folded into vertex colour G at PIXEL rate.
	//
	// G already carries the mesher's AO, and the material computes
	// BaseColor = albedo * VertexColor.G * DebugTint, so modulating it here is
	// authoritative for every downstream node and the material graph is
	// untouched. M_VoxelTerrain.uasset does not change for this feature.
	//
	// PER PIXEL, not per vertex, and that is not a luxury. The component path
	// compensates for per-vertex GI by SUBDIVIDING greedy quads
	// (voxel.GI.MaxQuadSpanVoxels); this factory structurally cannot -- every
	// quad is exactly 6 vertices reconstructed from SV_VertexID, and subdividing
	// would multiply the pool's quad count against its memory budget. So
	// per-vertex here would be strictly worse than per-vertex there, while
	// per-pixel is better than either AND deletes the subdivision cost.
	//
	// With Enabled=0 this whole block is skipped and G is byte-identical to what
	// it was before this feature existed.
	half4 VertexColorWithGI = Interpolants.Color;
	// OUTSIDE THE VOLUME, DO NOT SAMPLE AT ALL.
	//
	// This is the majority of the frame, not an edge case: the volume covers
	// +/-N*20 UU (38.4 m at VolumeDim 192) out of a 2 km cascade, so most pixels
	// on screen are outside it. The sampler is AM_Clamp on all three axes, so a
	// lookup out there returns the FACE texel rather than nothing -- which is
	// what step 1 saw as "large smeared bands" and mistook for an addressing bug.
	// Skipping is not an approximation: the fade is clamped to end inside the
	// half-extent, so Weight is already 0 wherever this branch fires. What it
	// buys is the sample itself, one to three of them, on every pixel outside the
	// volume AND in the depth pass, which this masked material also runs.
	const float3 GIUVW = Interpolants.GIUVW;
	const bool bInsideVolume = all(GIUVW > 0.0f) && all(GIUVW < 1.0f);
	if (VoxelGIVol.Enabled != 0u && bInsideVolume)
	{
		// THREE probe offsets, not one, matching FVoxelLightField's
		// kProbeOffsets {0.6, 1.25, 2.0} cells term for term.
		//
		// The single 0.6-cell probe this used to do is not a cheaper
		// approximation of the CPU sampler, it is a DIFFERENT one, and the
		// difference is concentrated exactly where GI matters: a 20 cm roof slab
		// is half a light-field cell thick, so a 0.6-cell push-out along the
		// normal frequently stays inside the slab's own solid cell, finds nothing
		// solved, and falls back to plain AO -- while the CPU walks on to 1.25 and
		// 2.0 cells and finds data. That asymmetry is precisely the roof-underside
		// defect this module already fixed once on the CPU side, and it would have
		// reappeared as a lighting seam at the voxel.Stream.GPUMaxLevel boundary.
		//
		// The VS hands over the first probe's UVW; the extra offsets are the same
		// step along the world normal, which the pool's pure-translation transform
		// makes usable directly. Costs nothing on a hit -- the later samples only
		// execute where the first one missed, which is a small minority of pixels.
		const float3 N = float3(Interpolants.TangentToWorld2.xyz);
		const float3 StepUVW = N * VoxelGIVol.CellSizeUU * VoxelGIVol.InvSizeUU;

		// SCHEME A slot selection. VolumePos holds (Vis[+X], Vis[+Y], Vis[+Z], v)
		// and VolumeNeg holds (Vis[-X], Vis[-Y], Vis[-Z], v), so the face's own
		// direction picks the volume by SIGN and the component by AXIS -- one
		// sample, one channel, exact.
		//
		// This is what makes Scheme A cost memory and nothing else. The design
		// doc lists it as "two samples", but that is the cost for a general
		// normal; every greedy-mesh normal is axis-aligned, so exactly one
		// ambient-cube slot is ever selected and the other volume is never read.
		// Scheme B collapsed the four horizontals to their mean to save the
		// second texture, and measured 2.6x over the doc's own RMS bar, worst on
		// side faces beside vertical occluders -- most of a cave wall.
		const float3 AbsN = abs(N);
		const bool bAxisX = AbsN.x > 0.5f;
		const bool bAxisY = !bAxisX && AbsN.y > 0.5f;
		const float NAxis = bAxisX ? N.x : (bAxisY ? N.y : N.z);
		const bool bPositive = NAxis > 0.0f;

		float3 ProbeUVW = Interpolants.GIUVW;
		float4 T = bPositive
			? Texture3DSampleLevel(VoxelGIVol.VolumePos, VoxelGIVol.VolumeSampler, ProbeUVW, 0)
			: Texture3DSampleLevel(VoxelGIVol.VolumeNeg, VoxelGIVol.VolumeSampler, ProbeUVW, 0);
		if (T.a <= 1.0e-3f)
		{
			ProbeUVW = Interpolants.GIUVW + StepUVW * 0.65f;   // 1.25 cells total
			T = bPositive
				? Texture3DSampleLevel(VoxelGIVol.VolumePos, VoxelGIVol.VolumeSampler, ProbeUVW, 0)
				: Texture3DSampleLevel(VoxelGIVol.VolumeNeg, VoxelGIVol.VolumeSampler, ProbeUVW, 0);
		}
		if (T.a <= 1.0e-3f)
		{
			ProbeUVW = Interpolants.GIUVW + StepUVW * 1.4f;    // 2.0 cells total
			T = bPositive
				? Texture3DSampleLevel(VoxelGIVol.VolumePos, VoxelGIVol.VolumeSampler, ProbeUVW, 0)
				: Texture3DSampleLevel(VoxelGIVol.VolumeNeg, VoxelGIVol.VolumeSampler, ProbeUVW, 0);
		}

		// A is the validity weight, and dividing by it is what makes hardware
		// trilinear reproduce the CPU sampler's "skip unsolved taps and
		// renormalise by the surviving weight" EXACTLY rather than approximately
		// -- same arithmetic, executed by the texture unit. A ~= 0 means no data
		// there, which falls back to plain AO, matching the CPU's miss path.
		const float W = T.a;
		if (W > 1.0e-3f)
		{
			// The volume was already chosen by the normal's sign above, so all that
			// is left is the axis: X -> r, Y -> g, Z -> b. Every direction is
			// stored exactly, so unlike Scheme B there is no "and the four
			// horizontals share a channel" caveat here.
			const float Irr = (bAxisX ? T.r : (bAxisY ? T.g : T.b)) / W;

			// Distance from this pixel to the CAMERA, which is what the CPU shade
			// measures (Dist(WorldPos, GICentreUU)). NOT the distance to the
			// volume centre, which is what this used to compute: the volume origin
			// only follows the camera to within the re-centring dead zone
			// (voxel.GI.VolumeRecentreCells, 2560 UU by default), so measuring
			// from it slides the whole fade band by up to that much and puts a
			// slowly moving brightness gradient on stationary geometry.
			//
			// The pixel's own pool-space position is recovered from the UVW rather
			// than carried as a second interpolant -- and it must be the FIRST
			// probe's UVW, not whichever fallback hit, so the fade does not step
			// by a cell where the fallback engages.
			const float3 ProbePoolUU = Interpolants.GIUVW / VoxelGIVol.InvSizeUU
			                         + VoxelGIVol.OriginPoolUU;
			const float DistUU = length(ProbePoolUU - VoxelGIVol.FadeCentrePoolUU);
			const float Fade = 1.0f - saturate((DistUU - VoxelGIVol.FadeStartUU)
			                                 / max(1.0f, VoxelGIVol.FadeEndUU - VoxelGIVol.FadeStartUU));
			float Ambient = lerp(VoxelGIVol.AmbientFloor, 1.0f, saturate(Irr));
			const float Weight = saturate(VoxelGIVol.Strength * Fade);

			// LOCAL LIGHT UN-CRUSH (docs/sky-and-local-light-plan.md §2.2, L1).
			//
			// THE PROBLEM, exactly: M_VoxelTerrain computes
			// BaseColor = albedo * VertexColor.G * DebugTint, and a deferred point
			// light's contribution is PROPORTIONAL to BaseColor. In a cave
			// G ~= AO * lerp(0.06, 1, ~0) ~= 0.06, so a torch lights a wall at 6% of
			// its albedo. This raises G back where a local source reaches, and does
			// nothing else -- it adds no light of its own.
			//
			// max(), not add or multiply. The un-crush must stay a RELATIVE
			// modulation <= 1 with no time-of-day input or the composition contract
			// in docs/lighting-weather-plan.md §2.3 breaks (a term that scales with
			// time of day multiplied into VertexColor.g gives a camera-relative ring
			// of "correct" brightness sliding across the world). max() with a value
			// in 0..1 cannot exceed the unoccluded 1.0 that contract fixes.
			//
			// SAMPLED THROUGH VoxelGIVol, never as a loose `Texture3D VolumeLocal;`
			// -- see this file's header at :21-26. A loose declaration compiles
			// perfectly and reads zeros forever, which here presents as "the torch
			// does nothing", indistinguishable from a splat that never ran.
			//
			// Interpolants.GIUVW is reused UNCHANGED because VolumeLocal covers the
			// same box as VolumePos/VolumeNeg: zero new interpolants, and the local
			// volume's own texel count is free to differ.
			//
			// The FIRST probe's UVW, not whichever fallback hit, for the same reason
			// the fade above uses it: a local light must not step by a cell where the
			// irradiance fallback engages.
			//
			// And note WHAT that UVW is: the VS builds it at the surface pushed
			// 0.6 cells (24 UU) OUT ALONG THE NORMAL (:328-330), not at the surface
			// itself. That is what this wants -- the un-crush is read in the air in
			// front of the wall, which is where the torch's light is, rather than
			// inside the wall's own solid cell where the splat's occlusion march
			// deliberately refuses to look.
			//
			// Nothing is needed on the W <= 1e-3 miss path below: there G keeps the
			// mesher's raw AO with no GI modulation at all, which is already the
			// un-crushed value -- Ambient is implicitly 1 and max(1, L.a) == 1.
			float LocalUnCrush = 0.0f;
			if (VoxelGIVol.LocalEnabled != 0u)
			{
				const float4 L = Texture3DSampleLevel(VoxelGIVol.VolumeLocal,
				                                      VoxelGIVol.VolumeSampler, Interpolants.GIUVW, 0);
				// L.rgb is deliberately unread: L1 writes A only, and L2 is what
				// routes RGB (tail radiance x RAW AO) out through TexCoords[1]/[2].
				LocalUnCrush = saturate(L.a);
				Ambient = max(Ambient, LocalUnCrush);
			}

			// Must match VoxelChunkComponent.cpp's shade term for term:
			// voxel.Stream.GPUMaxLevel puts both renderers in one frame, so a
			// divergence here shows up as a lighting seam at the ring boundary.
			//
			// THE UN-CRUSH IS THE ONE DELIBERATE EXCEPTION, and it is bounded rather
			// than free. VoxelChunkComponent.cpp:369-372 computes exactly this from
			// Irradiance and the ambient floor with no local-light term, so with
			// voxel.GI.LocalLights 1 a torch standing ON the voxel.Stream.GPUMaxLevel
			// ring lights the pooled side and not the component side -- a seam
			// wherever the two renderers meet under a local light. Not fixed here
			// because fixing it means re-shading component vertex colours per torch on
			// the CPU, which is a different feature; tolerable because the shipped
			// config is fully pooled (docs/sky-and-local-light-plan.md §2.2), because
			// the feature ships gated at 0, and because a torch is a 10 m object while
			// the ring is kilometres out. If a config ever ships with both renderers
			// live AND local lights on, this is the first thing to look at.
			VertexColorWithGI.g *= (half)lerp(1.0f, Ambient, Weight);

			// DebugVis 3: show the sampled value raw, ignoring AO and the fade.
			// Kept permanently -- a pooled primitive fails silently, and this is
			// the cheapest proof the path is reachable from the PIXEL shader.
			if (VoxelGIVol.DebugVis == 3u)
			{
				VertexColorWithGI.g = (half)saturate(Irr);
			}
			// DebugVis 4: the same rung for VolumeLocal -- show its A channel raw,
			// ignoring AO, the ambient floor and the fade. Kept permanently for the
			// same reason 3 is: this path fails silently in two ways that both look
			// like "the torch does nothing" (a loose Texture3D declaration, a
			// uniform member missing from operator==), and this is the cheapest
			// proof that the sampled bytes reach the pixel.
			if (VoxelGIVol.DebugVis == 4u)
			{
				VertexColorWithGI.g = (half)LocalUnCrush;
			}
		}
	}
	Result.VertexColor = VertexColorWithGI;

	half3 TangentToWorld0 = Interpolants.TangentToWorld0.xyz;
	half4 TangentToWorld2 = Interpolants.TangentToWorld2;
	Result.UnMirrored = TangentToWorld2.w;
	Result.TangentToWorld = AssembleTangentToWorld(TangentToWorld0, TangentToWorld2);

#if NUM_TEX_COORD_INTERPOLATORS
	Result.TexCoords[0] = Interpolants.TexCoords;
#endif

	// --- THE MATERIAL PALETTE, AT PIXEL RATE (ADR-0008, extended by ADR-0009) -
	//
	//     TexCoords[3] = material base colour .rg     (LINEAR, unvaried)
	//     TexCoords[4] = (base .b, biomeTint)
	//     TexCoords[5] = (variation lightness, variation hue)
	//
	// and M_VoxelTerrain composes them as
	//
	//     albedo = lerp(materialBase, climateColour, biomeTint)
	//     albedo = albedo * (1 + light);  .r *= 1 + hue;  .b *= 1 - hue
	//
	// before its AO multiply, so the result is lit and occluded like everything
	// else -- invariant 4 keeps lighting out of the table itself.
	//
	// WHY THE BASE AND THE VARIATION ARE SEPARATE, when this could hand over one
	// finished colour in three floats as it used to. Because the CLIMATE goes
	// between them, and the climate is a texture sample that only exists in the
	// graph. Multiply the variation in here and it lands on the material's share
	// only -- and every outdoor surface hands 190-235/255 of its colour to the
	// climate, so the per-voxel dither would be averaged away on exactly the
	// surfaces the player spends the whole game looking at. That is the
	// difference between a mottled hillside and a flat one, and it is the reason
	// terrain has never had cube-to-cube variation despite the palette carrying
	// the numbers for it since ADR-0008.
	//
	// WHY 3, 4 AND 5, when 1 and 2 look free. They are not: the local-lights plan
	// (docs/sky-and-local-light-plan.md L2) routes LocalRGB through
	// TexCoords[1]/[2] into EmissiveColor. Taking them would collide with a
	// feature that is already designed, and the collision would present as a
	// torch that tints bark.
	//
	// [5] IS FREE, WHICH IS WHY IT IS THE THIRD SLOT AND NOT A SECOND
	// INTERPOLANT. Unreal packs customised UVs two per float4, so the float4
	// holding TexCoords[4] already reserves the lanes [5] occupies; a material
	// that reads UV5 spends storage that was allocated and going unused. What
	// this feature costs remains the ONE interpolant carrying the voxel
	// coordinate (see the struct), which no existing channel can supply.
	//
	// EVERY LANE IS 0 WHEN NOTHING WRITES IT, and that polarity is the whole
	// safety argument. biomeTint 0 means "the material owns its colour", which
	// with a base of (0,0,0) would be black -- so the graph gates on the base
	// being written at all, and the component path (where FLocalVertexFactory
	// supplies no fourth or fifth UV; Tools/probe_texcoord1.py measured a second
	// texture coordinate arriving as zero there) keeps the pure biome answer it
	// has always drawn. See create_voxel_material.py, which spells the gate out.
#if NUM_TEX_COORD_INTERPOLATORS > 4
	{
		float3 PaletteBase;
		float2 PaletteVariation;
		float PaletteBiomeTint;
		VoxelPaletteUnpack(Interpolants.VoxelPalette, PaletteBase, PaletteVariation,
		                   PaletteBiomeTint);
		Result.TexCoords[3] = float2(PaletteBase.r, PaletteBase.g);
		Result.TexCoords[4] = float2(PaletteBase.b, PaletteBiomeTint);
#if NUM_TEX_COORD_INTERPOLATORS > 5
		Result.TexCoords[5] = PaletteVariation;
#endif
	}
#endif

	return Result;
}

float4 VertexFactoryGetTranslatedPrimitiveVolumeBounds(FVertexFactoryInterpolantsVSToPS Interpolants)
{
	FPrimitiveSceneData PrimitiveData = GetPrimitiveDataFromUniformBuffer();
	return float4(DFFastToTranslatedWorld(PrimitiveData.ObjectWorldPosition, ResolvedView.PreViewTranslation),
	              PrimitiveData.ObjectRadius);
}

uint VertexFactoryGetPrimitiveId(FVertexFactoryInterpolantsVSToPS Interpolants)
{
	// Not using GPUScene primitive IDs -- the per-draw primitive uniform buffer
	// carries everything this factory needs.
	return 0;
}

// Must come last: supplies defaults for the optional interface hooks this
// factory does not override.
#include "/Engine/Private/VertexFactoryDefaultInterface.ush"
