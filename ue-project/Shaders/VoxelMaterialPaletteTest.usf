// Compile check for VoxelMaterialPalette.ush.
//
// This shader is never dispatched. It exists so that the generated palette
// table and the ADR-0008 evaluation are proved to COMPILE, by DXC, without an
// Unreal editor -- run from tools/compile-shaders.ps1 alongside the worldgen
// kernels. One editor per box is a hard rule here and another session usually
// holds it, so a shader change that can only be checked by opening the editor
// is a shader change nobody checks.
//
// It touches every entry and every face class, so a generator that emits a
// malformed row, an array sized wrong, or an out-of-range index fails here
// rather than in a material compile weeks later.
//
// IT ALSO COMPILES THE RENDERER ROUTE (VoxelPalettePack / VoxelPaletteUnpack),
// and that is the only reason those two functions live in the generated palette
// header rather than in the vertex factory that calls them.
// VoxelQuadVertexFactory.ush cannot be handed to DXC -- it opens with
// /Engine/Private/VertexFactoryCommon.ush and is compiled inside a material
// permutation -- so anything written there is unchecked until somebody opens the
// editor. Everything the route decides is therefore here, where it is checked,
// and the factory is left holding one call per side.
//
// WHAT ADR-0009 ADDED, and what this file therefore has to reach:
//
//   * the CUBE SIZE argument, which carries invariant 5 (the patch wavelength
//     is world metric). Three values, so the band limit's early-out, its
//     inactive case and its binding case are all compiled.
//   * the LEVEL KEY, which the pack derives from voxelSizeUU / baseVoxelSizeUU.
//     The two sizes are separate arguments and passing one twice would silently
//     flatten every ring to level 0, so the base is written as its own named
//     constant.
//   * the VARIATION output, spent through VoxelApplyVariation exactly as the
//     material graph spends it. An `out` nothing reads is deleted before it is
//     compiled, which would leave the arithmetic unchecked here and first
//     compiled in the editor.
//   * the ABSENT WEIGHT encoding, checked rather than merely evaluated -- a row
//     that came back at zero would make the pooled path take the component
//     path's fallback and render the world from a base of (0,0,0).
//
// THIS FILE IS NOT GENERATED, so it does not follow the header the way the two
// generated copies do. tools/check-palette-parity.py compiles it as C++ against
// tools/hlsl_cpp_shim.h for exactly that reason: an arity change in the .ush
// then fails on any box in seconds, rather than waiting for the Windows job.

#include "VoxelMaterialPalette.ush"

RWStructuredBuffer<float3> PaletteCheckOut;

[numthreads(1, 1, 1)]
void PaletteCheckMain(uint3 id : SV_DispatchThreadID)
{
	float3 acc = 0.0f;
	for (uint m = 0u; m < VOXEL_MATERIAL_COUNT; ++m)
	{
		// The cube size is ADR-0009 invariant 5: the patch wavelength is world
		// metric, so the evaluation needs to know how big this cube actually is.
		// Three sizes, because the band limit (max(waveMm, 2 * cubeSizeMm)) has
		// three regimes and only the middle one is the interesting arithmetic:
		// 100 mm is a level-0 voxel and leaves every authored wavelength alone,
		// 3200 mm is a level-5 ring where the limit binds on every row, and 0
		// is the documented "no patch term" input that must take the early out
		// rather than divide by it.
		acc += VoxelMaterialColor(m, VOXEL_FACE_TOP,    int3(1, 2, 3),    100.0f);
		acc += VoxelMaterialColor(m, VOXEL_FACE_SIDE,   int3(-4, 5, -6),  3200.0f);
		acc += VoxelMaterialColor(m, VOXEL_FACE_BOTTOM, int3(7, -8, 9),   0.0f);

		// The route, over all six face directions and both LOD extremes. The
		// negative chunk origin is deliberate: the pool is re-based so that the
		// camera sits near its own origin, so half of every ring is at negative
		// pool coordinates and the floor() inside the unpack has to be a floor
		// and not a truncation there.
		[unroll] for (uint axis = 0u; axis < 3u; ++axis)
		{
			[unroll] for (uint pos = 0u; pos < 2u; ++pos)
			{
				// L0 (10 UU) on EVEN materials, L5 (320 UU) on odd ones -- `m & 1u`
				// is 1 for odd, and 320/10 is 2^5, so the key's level field takes
				// both 0 and 5 across the sweep. (This comment said the opposite
				// until ADR-0009 gave the pack a base size and made the claim
				// checkable.) WRITTEN AS ARITHMETIC, NOT AS
				// `(m & 1u) ? 10.0f : 320.0f`, and the difference is not style:
				// a scalar select whose result reaches a float3 operation makes
				// DXC's SPIR-V backend emit `OpSelect %v3float` with a SCALAR
				// condition, which is invalid SPIR-V ("Expected vector sizes of
				// Result Type and the condition to be equal"). DXIL accepts the
				// same source. Reduced to eight lines and confirmed both ways.
				// The shipping caller cannot hit it -- its voxel size comes from
				// a buffer, so there is no pair of constants to sink a select
				// between -- but this file is the SPIR-V arm's only sample of
				// this code, and the arm has teeth: this is what it caught.
				const float voxelSizeUU = 10.0f + 310.0f * float(m & 1u);

				// The axis is likewise selected by BUILDING a mask rather than
				// by writing faceNormal[axis]: dynamic vector-component indexing
				// is the other well-known source of the same invalid OpSelect.
				const float3 axisMask = float3(axis == 0u ? 1.0f : 0.0f,
				                               axis == 1u ? 1.0f : 0.0f,
				                               axis == 2u ? 1.0f : 0.0f);
				const float3 faceNormal = axisMask * ((pos != 0u) ? 1.0f : -1.0f);
				const float3 localUU = float3(3.0f, 5.0f, 2.0f) * voxelSizeUU
				                     + axisMask * ((pos != 0u) ? voxelSizeUU : 0.0f);

				// The SECOND size argument is a LEVEL-0 voxel, always, and the
				// ratio between the two is what the pack turns into the level
				// bits of the key. Passing the same value twice would make
				// every ring look like level 0 and the coarse arm of this loop
				// would stop testing anything -- so it is written as the
				// constant it is, next to the one that varies.
				const float baseVoxelSizeUU = 10.0f;

				const float4 packed = VoxelPalettePack(
					localUU, float3(-640.0f, 320.0f, -1280.0f), faceNormal,
					voxelSizeUU, baseVoxelSizeUU, m, axis, pos != 0u);

				float3 rgb;
				float2 variation;
				float biomeWeight;
				VoxelPaletteUnpack(packed, rgb, variation, biomeWeight);

				// EVERY OUTPUT IS CONSUMED. An `out` parameter that nothing
				// reads is dead code the optimiser deletes, and a deleted
				// expression is not a compiled one -- which is the whole
				// purpose of this file. VoxelApplyVariation is how the graph
				// spends `variation`, so spending it the same way here means
				// the arithmetic M_VoxelTerrain will run is the arithmetic DXC
				// has seen.
				acc += VoxelApplyVariation(rgb, variation);

				// THE ABSENT ENCODING, asserted rather than merely evaluated.
				// Zero in this lane means "no palette reached this pixel" and
				// the graph falls through to the climate-only colour; a real
				// weight is sent in the upper half. If a row ever came back at
				// exactly zero, the pooled path would take the fallback and the
				// world would render from a base of (0,0,0) -- black. There is
				// no assert in a compute shader, so it is written as arithmetic
				// that poisons the output: at or above 0.5 this term is exactly
				// zero, below it the accumulator goes to -1e30 and a readback
				// cannot miss it.
				//
				// WRITTEN AS min(), NOT AS A TERNARY ON A LITERAL. `x ? 0 : 0/0`
				// is a constant-folded division by zero on one side, which DXC
				// is free to diagnose or to sink; and a scalar condition feeding
				// a float3 select is the invalid-SPIR-V shape this file already
				// documents twice below. min() is a real instruction on both
				// targets and cannot be folded away, because biomeWeight comes
				// out of a buffer read.
				acc += float3(1.0f, 1.0f, 1.0f) * (min(biomeWeight - 0.5f, 0.0f) * 1e30f);
			}
		}
	}
	PaletteCheckOut[id.x] = acc;
}
