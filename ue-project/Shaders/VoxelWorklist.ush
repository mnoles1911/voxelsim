// VoxelWorklist.ush -- the HLSL half of the P3 chunk-record contract.
// NOT INCLUDED BY ANY KERNEL YET (see VoxelGpuWorklist.h's banner). The
// converted generation kernels will include this and read
// WorklistRecords[WorklistControl[0] + recordIndexInSlice] instead of the
// per-region $Globals -- that substitution IS the P3 conversion, kernel by
// kernel, per docs/gpu-worklist-plan-2026-08-23.md.
//
// MIRROR OF FVoxelGpuChunkWorkRecord (VoxelGpuWorklist.h), 16 dwords, 64 B.
// Field order and widths must match exactly; the host static_asserts its
// offsets, and the plan doc requires each converted kernel to static_assert
// its groups-per-record against the host table.

struct GpuChunkWorkRecord
{
	int  OriginVx;          // halo-free chunk origin, level-L cell units
	int  OriginVy;
	int  BrickZMin;         // level-L brick z of the chunk base
	uint LevelFlags;        // CoarseLevel:0..3 | RingSkirtMask:4..7 | hasAssets:8
	uint ChunkSlot;
	uint GenId;
	uint AssetBase;
	uint AssetCount;
	uint ShadingClimatePacked;
	uint ShadingGradPacked;
	uint ShadingSurfaceZBits;
	uint Reserved0;
	uint Reserved1;
	uint Reserved2;
	uint Reserved3;
	uint Reserved4;
};

uint worklistCoarseLevel(GpuChunkWorkRecord R) { return R.LevelFlags & 0xfu; }
uint worklistCoarseScale(GpuChunkWorkRecord R)
{
	// No variable shifts in kernels (lint-shader-ub VARIABLE_SHIFT): 1<<L as
	// a lookup over the 0..6 range the cascade streams.
	const uint L = worklistCoarseLevel(R);
	return (L == 0u) ? 1u : (L == 1u) ? 2u : (L == 2u) ? 4u : (L == 3u) ? 8u
	     : (L == 4u) ? 16u : (L == 5u) ? 32u : 64u;
}
uint worklistHasAssets(GpuChunkWorkRecord R) { return (R.LevelFlags >> 8) & 1u; }

// --- the record fold, GPU half ----------------------------------------------
//
// MIRROR OF FVoxelGpuWorklist::FoldRecord (VoxelGpuWorklist.cpp) -- same 16
// terms, same constants, same uint32 wraparound. Each side XOR-combines its
// per-record folds and the spine proof (VoxelWorklistConsume.usf) compares the
// two, so a single record dword that differs between what the host staged and
// what the GPU consumed -- a torn ring-wrap copy, a stale slot, a cursor off
// by one -- flips the compare and fails the proof loudly. XOR across records
// ON PURPOSE: GPU consumption order is nondeterministic and XOR is the
// order-independent combine.
//
// Per-dword multipliers are derived (0x9E3779B1 * odd index), not listed, so
// the C++ side can loop the identical arithmetic instead of mirroring 16
// literals -- one derivation, two loops, nothing to drift.
uint worklistFoldTerm(uint d, uint idx) { return d * (0x9E3779B1u * (2u * idx + 1u)); }
uint worklistRecordFold(GpuChunkWorkRecord R)
{
	uint F = 0u;
	F += worklistFoldTerm(asuint(R.OriginVx), 0u);
	F += worklistFoldTerm(asuint(R.OriginVy), 1u);
	F += worklistFoldTerm(asuint(R.BrickZMin), 2u);
	F += worklistFoldTerm(R.LevelFlags, 3u);
	F += worklistFoldTerm(R.ChunkSlot, 4u);
	F += worklistFoldTerm(R.GenId, 5u);
	F += worklistFoldTerm(R.AssetBase, 6u);
	F += worklistFoldTerm(R.AssetCount, 7u);
	F += worklistFoldTerm(R.ShadingClimatePacked, 8u);
	F += worklistFoldTerm(R.ShadingGradPacked, 9u);
	F += worklistFoldTerm(R.ShadingSurfaceZBits, 10u);
	F += worklistFoldTerm(R.Reserved0, 11u);
	F += worklistFoldTerm(R.Reserved1, 12u);
	F += worklistFoldTerm(R.Reserved2, 13u);
	F += worklistFoldTerm(R.Reserved3, 14u);
	F += worklistFoldTerm(R.Reserved4, 15u);
	return F;
}
