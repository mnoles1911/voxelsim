# build outputs
build/
build-*/
tile-cache/

# tool-generated search indexes
docs/index.bleve/

# claude session worktrees
.claude/worktrees/

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# editors/os
.vscode/
.idea/
.DS_Store

# UE (M1+) â€” build outputs and generated IDE files (regenerate with
# Build.bat -projectfiles)
ue-project/Binaries/
ue-project/DerivedDataCache/
ue-project/Intermediate/
ue-project/Saved/
# Repo-root scratch for headless leg logs (-abslog=). Raw UE logs run ~3 MB
# each and a leg set is tens of MB; the distilled numbers live in
# docs/measurements/ instead, which is what anything should cite.
/Saved/
ue-project/.vs/
ue-project/*.sln
ue-project/.vsconfig

# fetched toolchains
tools/dxc/
tools/vulkan-headers/

# Throwaway harness output. Headless runs are driven by piping editor stdout to
# a file per experiment (A-baseline.stdout, perf-on1.stdout, ...); they are
# scratch for one comparison and must never be committed.
*.stdout

# Tile-cache archives. Regenerated from the seed, and large.
tile-cache-*.tar.gz

# Bake/probe artifacts: large float32 dumps, never committed (see bake_prototype.py --npy)
*.npy
bake_out.npy

# Stage-by-stage heightfield dumps (vxc_stagedump +
# terrain-service/tools/dump_stage_heightfields.py). One run is hundreds of MB
# of .npy plus its JSON sidecars, and the cached 8192^2 bake interior alone is
# 268 MB. The TOOLS are the deliverable; the dumps are regenerated from the seed
# in minutes. A 67 MB .npy was committed to this repo once already and had to be
# amended out of history â€” the sidecars are ignored too so a `git add -A` can
# never bring half a dump in.
stage-dumps/

# Earth reference rasters. ~600 MB of Copernicus tiles and USGS 3DEP window
# extracts, rebuilt on demand by terrain-service/tools/earth_reference.py. The
# committed artifact is data/earth_reference/manifest.json, which carries every
# URL, window and sha256 needed to reproduce the cache byte-for-byte.
terrain-service/data/earth_reference/cache/

# NASA SVS sky-dome reference textures (star map + moon), fetched by
# tools/fetch-sky-assets.ps1. 34-124 MB EXR/TIFF sources; provenance and
# sha256 are recorded instead in
# ue-project/Content/Voxel/TextureSource/SKY_ASSET_CREDITS.md.
tools/sky-assets/


# Imported NASA sky textures. Regenerated by tools/fetch-sky-assets.ps1 followed
# by ue-project/Tools/import_sky_textures.py, both pinned and both checked in --
# so these .uassets are build output, not source. They are ignored because
# T_SkyStarmap alone is 38.8 MB and T_MoonColor 12.7 MB against a repo with no
# LFS whose largest tracked binary is 385 KB. M_NightSky and MPC_VoxelSky ARE
# tracked (75 KB and 4 KB); until the two commands above are run, M_NightSky
# will warn about missing texture references, which is expected.
ue-project/Content/Voxel/T_SkyStarmap.uasset
ue-project/Content/Voxel/T_MoonColor.uasset
ue-project/Content/Voxel/T_MoonDisplacement.uasset

# Editor auto-imports of the menu's committed loose art. The front end loads
# Content/UI's .jpg and .ttf files BY FILESYSTEM PATH (see front end step 3:
# no .uasset, no asset registry -- that is what let it be built with no
# editor). But any INTERACTIVE editor session auto-imports loose files it
# finds under Content/, so these .uassets reappear whenever someone opens the
# editor. Nothing references them; committing them would re-introduce the
# import dependency the design exists to avoid.
ue-project/Content/UI/Backgrounds/*.uasset
ue-project/Content/UI/Fonts/*.uasset

# Work-item-2 survey dumps: ~140 MB of per-tile bake rasters. The REPORT and
# the overlays are committed (docs/lake-survey/); these are the inputs.
/out/

# asset-forge review renders: regenerated by the tools on demand, and a
# contact sheet of the whole library is tens of megabytes a run.
asset-forge/out/
asset-forge/.backup/

# The MagicaVoxel export of a library asset. `tree.vxa` is the archival format
# and is two orders of magnitude smaller -- hero-arch-colossal's .vox is 194 MB
# against 3.6 MB for its .vxa -- and the .vox is regenerable from it. The six
# small ones committed before this rule stay tracked; nothing new that large
# goes into history.
asset-forge/library/hero-arch-colossal/**/tree.vox

# Baked terrain tiles. GitHub REFUSES any push containing a file over 100 MB,
# and two of these (bake-out/-3_-3.vxtl and -2_-4.vxtl, 192 MB each) were
# committed on 2026-08-15 and blocked every push to main until the history was
# rewritten to strip them on 2026-08-16. They are build artifacts, regenerable
# from the terrain service, and they must never be tracked again.
bake-out/*.vxtl

# Bake OUTPUT, not source: the karst carve run writes ~19 MB of tiles here and
# regenerating them is a script invocation, not a recovery. Same reason
# bake-out/*.vxtl above is ignored -- see GitHub's 100 MB wall in that comment.
bake-out/karst/
# Stray bake transcripts. The findings go in docs/measurements/, not the raw log.
bake-*.log
