static const int kBiomePrecipModU8 = 34;   // climatePrecipU8FromMmPerYr(1600)
static const int kBiomeSeasonalHighU8 = 128; // climateSeasonalityU8From(1500)

// Topsoil (amplifier.cpp). v8 replaced an absolute slope SUBTRACTION with a
// retained FRACTION -- the old form was swamped by any realistic 30 m-pixel
// slope and produced zero topsoil on 85-91% of land, which made the biome
// surface material invisible everywhere. The retention floor is tied to the
// cliff threshold so soil is thinnest exactly where BARE_ROCK takes over.
static const int64_t kTopsoilBaseMm = 200;
static const int64_t kTopsoilMmPerMetreOfRain = 200;
static const int64_t kTopsoilSlopeRetentionMinQ10 = 128;
static const int64_t kTopsoilMinMm = 100;  // == kVoxelSizeMm; guarantees one visible voxel
static const int64_t kTopsoilMaxMm = 2500;
//: climate.h's climatePrecipMmPerYrFromU8: (u8 * 12000) / 255
static const int64_t kClimatePrecipSpanMmPerYr = 12000;

// Detail octave table v2 (amplifier.cpp kDetailOctaves). Ordered coarse to
// fine; the first kLandformOctaveCount entries take slopeScaleQ10 and the rest
// take microScaleQ10. See amplifier.cpp for why the table looks like this.
// MIRROR: amplifier.cpp kDetailAmplitudeScaleQ10. One q10 multiplier over every
// octave in BOTH tables.
//
// It must be mirrored, and the first bracket run proved why the hard way: the
// scale was changed on the CPU only, so the GPU -- which is what actually
// generates the rendered voxels -- kept producing unscaled terrain, and three
// arms at 1.0x, 0.5x and 0.25x came back looking the same. The experiment
// measured nothing, and the builds were silently CPU/GPU divergent while it ran.
// Same family as CoarseScale defaulting to 0 and the months-stale prebuilt
// bytecode: the harness was fine, the thing under test was not connected.
// The helper itself lives below truncDiv (search scaledAmpMm) -- HLSL needs the
// callee declared first, and truncDiv comes later in this file.
static const int64_t kDetailAmplitudeScaleQ10 = 1024;

static const int kOctaveCount = 5;
static const int kLandformOctaveCount = 2;
// v13 THIRD BAND. The last kMaterialOctaveCount octaves are MATERIAL -- clods
// and stones -- and take no relief gate, because they are not landform. The
// 1.6 m octave moved out of that group and under the landform gate with the
// rest of the ladder; MIRROR: amplifier.cpp's band-split block, which explains
// why keeping 1.6 m floored on flat ground was most of the defect.
static const int kMaterialOctaveCount = 2;
static const int kOctaveLatticeMm[kOctaveCount] = {25600, 6400, 1600, 400, 200};
static const int kOctaveAmplitudeMm[kOctaveCount] = {2600, 1100, 500, 90, 25};

// v10 BAND OWNERSHIP (amplifier.cpp kFineDetailOctaves). On a world whose tile
// raster carries the baked fine tier, the 25.6 m and 6.4 m landform octaves are
// DELETED and the ladder continues from 3.2 m -- synthesising them over measured
// landform fights the bake with hash noise. Read the band-ownership comment in
// amplifier.cpp before touching either table; in particular, it records WHY it
// is safe to branch worldgen on the sampler pitch (pitch is a property of the
// world, pinned by provider_id, and the residency gate BLOCKS rather than
// falling back -- weaken that gate and this branch becomes a desync).
//
// THE TWO TIERS DO NOT SHARE NOISE FIELDS OCTAVE-FOR-OCTAVE. The channel is
// CH_DETAIL_OCTAVE_BASE + i where i indexes the octave's position in ITS OWN
// table, so fine octave 0 (3.2 m) draws the same channel as coarse octave 0
// (25.6 m). That is deliberate on the CPU side and mirrored exactly here: they
// are different worlds, never two renderings of one world.
static const int kFineOctaveCount = 4;
static const int kFineLandformOctaveCount = 1;
static const int kFineOctaveLatticeMm[kFineOctaveCount] = {3200, 1600, 400, 200};
static const int kFineOctaveAmplitudeMm[kFineOctaveCount] = {900, 500, 90, 25};

// vxc::isFineTier -- a tile raster at or below this pitch carries baked sub-30 m
// landform. 3750 is scale 8, 1875 is scale 16; both select the fine ladder.
static const int64_t kFineTierMaxPixelMm = 3750;

// --- v13 mirrors: carrier.h's prefilter and relief gate ---------------------
//
// MIRROR: vxc::kCarrierPrefilterRadius / W / Den / Lo / Hi / Span, and
// vxc::kCarrierSampleTierMinPixelMm. A cubic B-spline approximates its control
// points, so a tier that ships raster SAMPLES has to be prefiltered before the
// carrier evaluates it or the model's own output is low-passed away -- measured
// at 815 mm on plains and 3222 mm on alpine. The baked fine tier ships control
// points and must NOT be prefiltered again, which is what the pitch test picks.
static const int kCarrierPrefilterRadius = 4;
static const int64_t kCarrierPrefilterW[5] = {1048576, -280965, 75284, -20172, 5405};
static const int64_t kCarrierPrefilterDen = 607680; // the exact sum; DC is exact
static const int kCarrierPrefilterLo = -5;         // -1 - R
static const int kCarrierPrefilterSpan = 12;       // 4 + 2R
static const int64_t kCarrierSampleTierMinPixelMm = 3751;
static const int64_t kCarrierControlClampMm = 9000000;

// MIRROR: vxc::kReliefBaselineMm / kReliefRefMm / kReliefScaleMinQ10 /
// kReliefScaleMaxQ10. These are worldgen contract; carrier.h carries the
// calibration and the measurements behind every one of them.
static const int64_t kReliefBaselineMm = 30000;
static const int64_t kReliefRefMm = 16000;
static const int64_t kReliefScaleMinQ10 = 102;
static const int64_t kReliefScaleMaxQ10 = 2048;

// --- v14 mirror: the detail gradient cap (amplifier.cpp) --------------------
//
// MIRROR: amplifier.cpp kLandformGradMmPerM .. kFineMicroGradMmPerM (DERIVED
// there from the octave tables as sum of scaledAmpMm(amp) * 1000 / lattice per
// band, and pinned by static_assert; hand-mirrored here as literals because
// HLSL cannot run that constexpr loop), plus kDetailGradCapKQ10 /
// kDetailGradFloorMmPerM (calibrated worldgen constants). The cap scales the
// whole summed post-gate detail down so its nominal gradient stays within
// max(floor, k * carrierGradient) -- detail steeper than the ground it
// decorates reverses the downhill direction and turns routed drainage into
// closed decimetre basins. See the v14 block in amplifier.cpp for the
// derivation, the drainage measurement, and why the floor is load-bearing.
static const int64_t kLandformGradMmPerM = 272;
static const int64_t kMetreGradMmPerM = 312;
static const int64_t kMicroGradMmPerM = 350;
static const int64_t kFineLandformGradMmPerM = 281;
static const int64_t kFineMetreGradMmPerM = 312;
static const int64_t kFineMicroGradMmPerM = 350;
static const int64_t kDetailGradCapKQ10 = 512;
// v15. kRillMaxAbsMm * 1000 / kRillAcrossMm = 300 * 1000 / 1600, static_asserted
// == 187 on the CPU side BECAUSE it is a literal here. Do not fold this into an
// expression involving the rill constants: they live in detail_rill.h, which this
// file does not include, so the assert is the only thing tying the two together.
static const int64_t kRillGradMmPerM = 187;
static const int64_t kDetailGradFloorMmPerM = 50;
static const int64_t kFineDetailGradFloorMmPerM = 50;
// On a COARSE world the cap ENGAGES on a ramp over landform relief (the same
// per-cell reliefMm the amplitude gate reads): off at Lo, full at Hi, so flat
// classes keep their texture bit-for-bit while valley floors -- where every
// hillside's water must exit -- stay protected. On a FINE world it engages
// everywhere: the bake carves sub-metre structure and the client must stay
// out of its way. MIRROR: amplifier.cpp's engagement-ramp block, which
// carries the measured justification (the required allowance is NON-MONOTONE
// in slope, so no constant floor works; a slope-local exemption dams the
// catchment outlets).
static const int64_t kDetailCapReliefLoMm = 3600;
static const int64_t kDetailCapReliefHiMm = 7500;

// --- primitives mirrored from core.h / hash.h ------------------------------

// VENDOR-DIVERGENCE FIX (M0 gate, 2026-07: AMD RX 7800 XT PASS / NVIDIA RTX
// 4090 FAIL on identical SPIR-V). Signed integer division and remainder with
// operands of MIXED SIGN are not portable in this stack:
//   * HLSL defines `%` only when both operands share a sign (D3D HLSL
//     operator reference); GLSL says the same for `%` and for `/`.
//   * DXC lowers them to OpSDiv/OpSRem, and the 64-bit integer emulation the
//     driver substitutes is where the vendors part ways. On AMD, OpSRem
//     returned a remainder with the sign of the DIVIDEND (matching x86/C++),
//     so the flooring correction `(r < 0) != (b < 0)` fired for negative
//     coordinates. On NVIDIA it did not fire, and floorDiv silently degraded
//     to TRUNCATING division for every column with a negative world
//     coordinate â€” wrong raster pixel, wrong noise lattice cell, metre-scale
//     surfaceMm/topsoilMm/subsoilMm divergence.
//
// Everything below therefore routes signed division through MAGNITUDE-ONLY
// unsigned division (OpUDiv), which has exactly one legal result on every
// implementation, and reconstructs the sign explicitly. No OpSRem, no
// sign-dependent rounding, anywhere in the worldgen math. Unsigned negation
// wraps by definition, so these are also correct at INT64_MIN.
// DO NOT reintroduce bare `/` or `%` on a possibly-negative signed value:
// use floorDiv (floor, world coord -> cell index) or truncDiv (toward zero,
// mirrors C++ `/`) so the CPU reference and the GPU agree by construction.

uint64_t absToU64(int64_t v)
{
    const uint64_t u = (uint64_t)v;
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - deliberate two's-complement negation of a magnitude; unsigned wraparound is well-defined and is exactly what makes this correct at INT64_MIN
    return (v < 0) ? ((uint64_t)0 - u) : u;
}

// Truncating division â€” bit-exact mirror of C++ `/` on int64_t.
int64_t truncDiv(int64_t a, int64_t b)
{
    const uint64_t uq = absToU64(a) / absToU64(b);
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - deliberate negation of an unsigned magnitude to rebuild the signed quotient; unsigned wraparound is well-defined
    return ((a < 0) != (b < 0)) ? (int64_t)((uint64_t)0 - uq) : (int64_t)uq;
}

// MIRROR: amplifier.cpp scaledAmpMm. Placed here rather than beside
// kDetailAmplitudeScaleQ10 because HLSL requires truncDiv to be declared first.
// truncDiv matches the C++ `/`; amplitudes are positive so the two agree today,
// and the discipline is what keeps them agreeing after an edit that lets a
// negative through.
int64_t scaledAmpMm(int64_t amplitudeMm)
{
    return truncDiv(amplitudeMm * kDetailAmplitudeScaleQ10, 1024);
}

// Floored division â€” bit-exact mirror of vxc::floorDiv (core.h).
int64_t floorDiv(int64_t a, int64_t b)
{
    const uint64_t ua = absToU64(a);
    const uint64_t ub = absToU64(b);
    const uint64_t uq = ua / ub;
    if ((a < 0) != (b < 0))
    {
        // Negative quotient: round away from zero unless the division was
        // exact. `uq * ub == ua` is the exactness test (no OpUMod needed).
        const uint64_t bump = (uq * ub == ua) ? (uint64_t)0 : (uint64_t)1;
        // lint-shader-ub: allow UNSIGNED_UNDERFLOW - deliberate negation of an unsigned magnitude, then a 0-or-1 rounding bump; unsigned wraparound is well-defined and is the intended two's-complement result
        return (int64_t)((uint64_t)0 - uq - bump);
    }
    return (int64_t)uq;
}

int64_t clamp64(int64_t v, int64_t lo, int64_t hi)
{
    return v < lo ? lo : (v > hi ? hi : v);
}

// MIRROR: vxc::carrierPrefilterStencil (voxelcore/carrier.h). Separable, two
// stage, with the intermediate divide -- folding the two stages into one tensor
// form is a different number AND overflows.
//
// EVERY DIVISION HERE HAS A ROUTINELY NEGATIVE NUMERATOR: the odd taps of the
// kernel are negative, so a bare `/` is exactly the operand pattern that
// diverged AMD vs NVIDIA (see the VENDOR-DIVERGENCE FIX block above). truncDiv,
// never floorDiv and never `/`.
void carrierPrefilterStencil(int64_t raw[kCarrierPrefilterSpan * kCarrierPrefilterSpan],
                             out int64_t cp[16])
{
    int64_t tmp[kCarrierPrefilterSpan * 4];
    [unroll]
    for (int a = 0; a < kCarrierPrefilterSpan; ++a)
    {
        [unroll]
        for (int j = 0; j < 4; ++j)
        {
            int64_t acc = kCarrierPrefilterW[0] *
                          raw[a + kCarrierPrefilterSpan * (j + kCarrierPrefilterRadius)];
            [unroll]
            for (int n = 1; n <= kCarrierPrefilterRadius; ++n)
                acc += kCarrierPrefilterW[n] *
                       (raw[a + kCarrierPrefilterSpan * (j + kCarrierPrefilterRadius + n)] +
                        raw[a + kCarrierPrefilterSpan * (j + kCarrierPrefilterRadius - n)]);
            tmp[a + kCarrierPrefilterSpan * j] = truncDiv(acc, kCarrierPrefilterDen);
        }
    }
    [unroll]
    for (int j2 = 0; j2 < 4; ++j2)
    {
        [unroll]
        for (int i = 0; i < 4; ++i)
        {
            int64_t acc = kCarrierPrefilterW[0] *
                          tmp[(i + kCarrierPrefilterRadius) + kCarrierPrefilterSpan * j2];
            [unroll]
            for (int m = 1; m <= kCarrierPrefilterRadius; ++m)
                acc += kCarrierPrefilterW[m] *
                       (tmp[(i + kCarrierPrefilterRadius + m) + kCarrierPrefilterSpan * j2] +
                        tmp[(i + kCarrierPrefilterRadius - m) + kCarrierPrefilterSpan * j2]);
            cp[i + 4 * j2] = clamp64(truncDiv(acc, kCarrierPrefilterDen), -kCarrierControlClampMm,
                                     kCarrierControlClampMm);
        }
    }
}

uint64_t splitmix64(uint64_t z)
{
    z += 0x9E3779B97F4A7C15ULL;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
    return z ^ (z >> 31);
}

uint64_t hash2(uint64_t seed, int64_t x, int64_t y, uint channel)
{
    return splitmix64(seed ^ splitmix64((uint64_t)x ^
                             splitmix64((uint64_t)y ^
                             splitmix64((uint64_t)channel))));
}

// vxc::hash3 (hash.h) bit-for-bit â€” one more splitmix64 round than hash2.
// Used by the cavern pass's per-room geometry channel (CH_CAVERN_SITE), which
// needs the room index as a third coordinate.
uint64_t hash3(uint64_t seed, int64_t x, int64_t y, int64_t z, uint channel)
{
    return splitmix64(seed ^ splitmix64((uint64_t)x ^
                             splitmix64((uint64_t)y ^
                             splitmix64((uint64_t)z ^
                             splitmix64((uint64_t)channel)))));
}

// Top 16 bits -> [-32768, 32767].
int hashToSigned16(uint64_t h)
{
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - recentring a full 16-bit unsigned range onto [-32768, 32767]; the subtraction happens in signed 32-bit after the (int) cast, so it cannot wrap, and a negative result is the whole point
    return (int)(uint)(h >> 48) - 32768;
}

int64_t valueNoise2(uint64_t seed, int64_t xMm, int64_t yMm, int64_t latticeMm, uint channel)
{
    const int64_t x0 = floorDiv(xMm, latticeMm);
    const int64_t y0 = floorDiv(yMm, latticeMm);
    const int64_t fx = xMm - x0 * latticeMm;
    const int64_t fy = yMm - y0 * latticeMm;
    const int64_t v00 = hashToSigned16(hash2(seed, x0, y0, channel));
    const int64_t v10 = hashToSigned16(hash2(seed, x0 + 1, y0, channel));
    const int64_t v01 = hashToSigned16(hash2(seed, x0, y0 + 1, channel));
    const int64_t v11 = hashToSigned16(hash2(seed, x0 + 1, y0 + 1, channel));
    const int64_t gx = latticeMm - fx;
    const int64_t gy = latticeMm - fy;
    // Numerator is routinely negative (v* in [-32768, 32767]) â€” truncDiv, not
    // `/`, per the floorDiv comment above.
    return truncDiv((v00 * gx + v10 * fx) * gy + (v01 * gx + v11 * fx) * fy,
                    latticeMm * latticeMm);
}

// vxc::fadeFractionMm (hash.h) bit-for-bit. Perlin's quintic
// 6t^5 - 15t^4 + 10t^3 applied to a lattice fraction, carried as a 10-bit
// fraction so t^5 stays inside int64. See hash.h for why the detail octaves
// need it and why it costs the surface bound nothing.
//
// Every operand here is NON-NEGATIVE: fx is in [0, latticeMm) by floorDiv's
// contract, and the quintic is nonneg on [0, 1]. So the divisions are
// same-sign and truncDiv agrees with `/` on both CPU and GPU â€” but they go
// through truncDiv anyway, because "this operand happens to be positive
// today" is exactly the reasoning the M0 NVIDIA-vs-AMD divergence punished.
int64_t fadeFractionMm(int64_t fx, int64_t latticeMm)
{
    const int64_t tq = truncDiv(fx * 1024, latticeMm);
    const int64_t t3 = tq * tq * tq;
    const int64_t w = truncDiv(6 * t3 * tq * tq - 15 * t3 * tq * 1024 + 10 * t3 * 1024 * 1024,
                               (int64_t)1024 * 1024 * 1024 * 1024);
    return truncDiv(w * latticeMm, 1024);
}

// vxc::valueNoise2Fade (hash.h) bit-for-bit. Same lattice, same hashes, same
// output range as valueNoise2 â€” only the interpolation weights differ.
int64_t valueNoise2Fade(uint64_t seed, int64_t xMm, int64_t yMm, int64_t latticeMm, uint channel)
{
    const int64_t x0 = floorDiv(xMm, latticeMm);
    const int64_t y0 = floorDiv(yMm, latticeMm);
    const int64_t fx = fadeFractionMm(xMm - x0 * latticeMm, latticeMm);
    const int64_t fy = fadeFractionMm(yMm - y0 * latticeMm, latticeMm);
    const int64_t v00 = hashToSigned16(hash2(seed, x0, y0, channel));
    const int64_t v10 = hashToSigned16(hash2(seed, x0 + 1, y0, channel));
    const int64_t v01 = hashToSigned16(hash2(seed, x0, y0 + 1, channel));
    const int64_t v11 = hashToSigned16(hash2(seed, x0 + 1, y0 + 1, channel));
    const int64_t gx = latticeMm - fx;
    const int64_t gy = latticeMm - fy;
    // Numerator is routinely negative (v* in [-32768, 32767]) â€” truncDiv, not
    // `/`, per the floorDiv comment above.
    return truncDiv((v00 * gx + v10 * fx) * gy + (v01 * gx + v11 * fx) * fy,
                    latticeMm * latticeMm);
}

// --- the C2 carrier (v9) ----------------------------------------------------
// Bit-exact mirror of the carrier block in amplifier.cpp. Read that file for
// WHY the base is a uniform cubic B-spline rather than bilinear, why B-spline
// rather than Catmull-Rom, and why the evaluation is two-stage separable
// (short version: the exact tensor form overflows int64 by ten orders of
// magnitude at a 30 m pixel). Every division here is truncDiv, mirroring C++
// `/`; NOT floorDiv, because the bound lemma is stated against truncation.
static const int64_t kCarrierT = 1024;
static const int64_t kCarrierValueDen = (int64_t)6 * 1024 * 1024 * 1024; // 6*1024^3
static const int64_t kCarrierSlopeDen = (int64_t)2 * 1024 * 1024;       // 2*1024^2

struct CarrierW4 { int64_t w0, w1, w2, w3; };
struct CarrierW3 { int64_t w0, w1, w2; };

CarrierW4 carrierValueW(int64_t tq)
{
    const int64_t u = kCarrierT - tq;
    const int64_t T = kCarrierT;
    CarrierW4 r;
    r.w0 = u * u * u;
    r.w1 = 3 * tq * tq * tq - 6 * tq * tq * T + 4 * T * T * T;
    r.w2 = -3 * tq * tq * tq + 3 * tq * tq * T + 3 * tq * T * T + T * T * T;
    r.w3 = tq * tq * tq;
    return r;
}

CarrierW3 carrierSlopeW(int64_t tq)
{
    const int64_t u = kCarrierT - tq;
    const int64_t T = kCarrierT;
    CarrierW3 r;
    r.w0 = u * u;
    r.w1 = -2 * tq * tq + 2 * T * tq + T * T;
    r.w2 = tq * tq;
    return r;
}

struct CarrierEval
{
    int64_t heightMm;
    int64_t sxMmPerPx; // signed
    int64_t syMmPerPx; // signed
};

CarrierEval evalCarrier(int64_t cp[16], int64_t fx, int64_t fy, int64_t pxMm)
{
    // fx, fy are in [0, pxMm) by floorDiv's contract, so both numerators are
    // non-negative and tq lands in [0, 1023].
    const int64_t tx = truncDiv(fx * kCarrierT, pxMm);
    const int64_t ty = truncDiv(fy * kCarrierT, pxMm);
    const CarrierW4 wx = carrierValueW(tx);
    const CarrierW4 wy = carrierValueW(ty);
    const CarrierW3 dx = carrierSlopeW(tx);
    const CarrierW3 dy = carrierSlopeW(ty);

    // Stage 1: collapse x for each of the four control rows.
    int64_t rowVal[4];
    int64_t rowDx[4];
    [unroll]
    for (int j = 0; j < 4; ++j)
    {
        const int64_t r0 = cp[4 * j + 0];
        const int64_t r1 = cp[4 * j + 1];
        const int64_t r2 = cp[4 * j + 2];
        const int64_t r3 = cp[4 * j + 3];
        const int64_t v = r0 * wx.w0 + r1 * wx.w1 + r2 * wx.w2 + r3 * wx.w3;
        const int64_t d = (r1 - r0) * dx.w0 + (r2 - r1) * dx.w1 + (r3 - r2) * dx.w2;
        rowVal[j] = truncDiv(v, kCarrierValueDen);
        rowDx[j] = truncDiv(d, kCarrierSlopeDen);
    }

    // Stage 2: collapse y. The y-derivative is the quadratic basis over the
    // first differences of the already-collapsed rows -- the tensor product
    // commutes, so this is the same value as collapsing y first.
    const int64_t h = rowVal[0] * wy.w0 + rowVal[1] * wy.w1 + rowVal[2] * wy.w2 +
                      rowVal[3] * wy.w3;
    const int64_t sx = rowDx[0] * wy.w0 + rowDx[1] * wy.w1 + rowDx[2] * wy.w2 +
                       rowDx[3] * wy.w3;
    const int64_t sy = (rowVal[1] - rowVal[0]) * dy.w0 + (rowVal[2] - rowVal[1]) * dy.w1 +
                       (rowVal[3] - rowVal[2]) * dy.w2;

    CarrierEval e;
    e.heightMm = truncDiv(h, kCarrierValueDen);
    e.sxMmPerPx = truncDiv(sx, kCarrierValueDen);
    e.syMmPerPx = truncDiv(sy, kCarrierSlopeDen);
    return e;
}

// --- analytic curvature (v10) ----------------------------------------------
// Bit-exact mirror of voxelcore/carrier.h's evalCarrierCurvature /
// carrierCurvatureMmPerM2Q10. Read that header for the sign convention (crest
// NEGATIVE -- these are the plain second derivatives of height, not the
// geomorphological profile-curvature convention) and for why the currency is
// q10 mm per metre per metre rather than whole mm/m^2.
//
// The SECOND derivative of a uniform cubic B-spline is a LINEAR B-spline over
// the second differences of the control points, so the basis is {T - tq, tq}
// over ONE factor of the q10 one -- not three (the cubic value basis) or two
// (the quadratic slope basis).
static const int64_t kCarrierCurveDen = 1024; // == kCarrierT, deliberately named apart
static const int64_t kCurveQ10One = 1024;
static const int64_t kMmPerMSquared = 1000000;

struct CarrierW2 { int64_t w0, w1; };

CarrierW2 carrierCurveW(int64_t tq)
{
    CarrierW2 r;
    r.w0 = kCarrierT - tq;
    r.w1 = tq;
    return r;
}

struct CarrierCurvature
{
    int64_t cxxMmPerPx2; // signed
    int64_t cyyMmPerPx2; // signed
};

// OVERFLOW ANALYSIS, RE-CHECKED IN THIS FILE'S ARITHMETIC (carrier.h works the
// same numbers for the CPU; the shader uses the identical int64 types and the
// identical two-stage order, so the chain and its margins carry over term for
// term -- but it is re-stated here because "the CPU's bound carries" is exactly
// the assumption that would hide a widened intermediate).
//
// C = 9e6 mm, the elevation clamp. A second difference of four control points
// is |D| <= 4C = 3.6e7. int64 tops out at 9.22e18.
//   stage 1: |sum| <= 4C * kCarrierCurveDen  = 3.69e10   (2.5e8x margin)
//   stage 2: |sum| <= 4C * kCarrierValueDen  = 2.32e17   (40x margin)  <-- tightest
//   unit conversion: 8C * kCurveQ10One * kMmPerMSquared = 7.4e16 (125x margin)
//   the divisor pxMm * pxMm <= 9e8 at a 30 m pixel, nowhere near the limit.
// The ONE-STAGE q10 form overflows by 26x and is tempting because
// kCarrierCurveDen happens to equal the q10 one so the divide LOOKS free. It is
// not. Do not fold the stage-1 divide away here any more than on the CPU.
//
// EXACTLY ZERO ON A PLANAR CONTROL FIELD, which is the property the whole gate
// rests on: both axes difference FIRST and interpolate SECOND, so on a plane
// every second difference is 0 before any division happens and truncation has
// nothing to truncate. Collapsing with the cubic basis first and differencing
// the truncated row values afterwards would report spurious curvature on a
// tilted plane whose row values straddle zero. Keep the order.
CarrierCurvature evalCarrierCurvature(int64_t cp[16], int64_t fx, int64_t fy, int64_t pxMm)
{
    // Same q10 cell fraction as evalCarrier. fx, fy are in [0, pxMm) by
    // floorDiv's contract, so both numerators are non-negative and tq lands in
    // [0, 1023]; truncDiv agrees with the CPU's `/` there.
    const int64_t tx = truncDiv(fx * kCarrierT, pxMm);
    const int64_t ty = truncDiv(fy * kCarrierT, pxMm);
    const CarrierW4 wx = carrierValueW(tx);
    const CarrierW4 wy = carrierValueW(ty);
    const CarrierW2 gx = carrierCurveW(tx);
    const CarrierW2 gy = carrierCurveW(ty);

    // d2/dx2: stage 1 differences ALONG X within each control row (exact, no
    // division), stage 2 collapses Y with the cubic value basis.
    // d2/dy2: the mirror image -- stage 1 differences ALONG Y within each
    // control column (stride 4), stage 2 collapses X.
    //
    // Both stage-1 numerators are routinely NEGATIVE (a crest gives negative
    // second differences), so these are truncDiv and NOT a bare `/`.
    int64_t rowD2[4];
    int64_t colD2[4];
    [unroll]
    for (int k = 0; k < 4; ++k)
    {
        const int64_t r0 = cp[4 * k + 0];
        const int64_t r1 = cp[4 * k + 1];
        const int64_t r2 = cp[4 * k + 2];
        const int64_t r3 = cp[4 * k + 3];
        const int64_t c0 = cp[k + 4 * 0];
        const int64_t c1 = cp[k + 4 * 1];
        const int64_t c2 = cp[k + 4 * 2];
        const int64_t c3 = cp[k + 4 * 3];
        const int64_t dxx = (r2 - 2 * r1 + r0) * gx.w0 + (r3 - 2 * r2 + r1) * gx.w1;
        const int64_t dyy = (c2 - 2 * c1 + c0) * gy.w0 + (c3 - 2 * c2 + c1) * gy.w1;
        rowD2[k] = truncDiv(dxx, kCarrierCurveDen);
        colD2[k] = truncDiv(dyy, kCarrierCurveDen);
    }

    const int64_t cxx = rowD2[0] * wy.w0 + rowD2[1] * wy.w1 + rowD2[2] * wy.w2 +
                        rowD2[3] * wy.w3;
    const int64_t cyy = colD2[0] * wx.w0 + colD2[1] * wx.w1 + colD2[2] * wx.w2 +
                        colD2[3] * wx.w3;

    CarrierCurvature c;
    // Also routinely negative -- truncDiv.
    c.cxxMmPerPx2 = truncDiv(cxx, kCarrierValueDen);
    c.cyyMmPerPx2 = truncDiv(cyy, kCarrierValueDen);
    return c;
}

// The curvature currency: the LAPLACIAN, in q10 mm per metre per metre. Signed;
// crest negative. Truncating division on a routinely-negative numerator, so
// truncDiv -- truncation toward zero is symmetric and preserves the
// antisymmetry curvature(-h) == -curvature(h) that the CPU tests assert.
int64_t carrierCurvatureMmPerM2Q10(CarrierCurvature c, int64_t pxMm)
{
    const int64_t perPx2 = c.cxxMmPerPx2 + c.cyyMmPerPx2; // mm per pixel^2
    return truncDiv(perPx2 * kCurveQ10One * kMmPerMSquared, pxMm * pxMm);
}

// Faded-bilinear blend of four u8 corners -- one channel of vxc::blendClimate
// (amplifier.cpp), bit-for-bit. Every input is a u8 and both weights are
// non-negative, so the result cannot leave [0, 255] and needs no clamp.
int64_t blendU8(int64_t v00, int64_t v10, int64_t v01, int64_t v11,
                int64_t gx, int64_t fx, int64_t gy, int64_t fy, int64_t den)
{
    return truncDiv((v00 * gx + v10 * fx) * gy + (v01 * gx + v11 * fx) * fy, den);
}

// The slope currency, MM PER METRE. L1, keeping the shape of the v8
// tileSlopeMmPerPx so the recalibrated gates below are a pure unit conversion.
int64_t carrierSlopeMmPerM(CarrierEval c, int64_t pxMm)
{
    const int64_t ax = c.sxMmPerPx < 0 ? -c.sxMmPerPx : c.sxMmPerPx;
    const int64_t ay = c.syMmPerPx < 0 ? -c.syMmPerPx : c.syMmPerPx;
    return truncDiv((ax + ay) * 1000, pxMm);
}

// vxc::reliefScaleQ10 (voxelcore/carrier.h) bit-for-bit, and the ONLY detail
// gate at v13. slopeScaleQ10 and microScaleQ10 are GONE from both sides: the
// quantity they conditioned on was the wrong one. The full derivation and the
// measurement that killed them are in carrier.h; the one-line version is that
// they spanned 1.9x and 1.06x between a plain and a mountain whose landform
// differs 25x, so the client laid the same roughness on both and the finished
// plain came out six times more ridged than the finished mountain.
//
// relief30Mm is a magnitude (>= 0), so both roundings agree; truncDiv keeps
// that from becoming load-bearing.
int64_t reliefScaleQ10(int64_t relief30Mm)
{
    return clamp64(truncDiv(relief30Mm * 1024, kReliefRefMm), kReliefScaleMinQ10,
                   kReliefScaleMaxQ10);
}

// vxc::carrierReliefLagPx / vxc::carrierReliefMm (voxelcore/carrier.h).
// The lag in PIXELS that puts the relief baseline at 30 m on any tier; 1 at
// 30 m/px, 8 at scale 8, 16 at the scale-16 fine tier. pxMm > 0 always, so
// truncDiv and floorDiv agree.
int64_t carrierReliefLagPx(int64_t pxMm)
{
    const int64_t l = truncDiv(kReliefBaselineMm + truncDiv(pxMm, 2), pxMm);
    return l < 1 ? 1 : l;
}

// Mean of the two axis relief magnitudes across the baseline, in mm. Both
// numerators are magnitudes by the time they are halved, so truncDiv matches
// the CPU's `/ 2`.
int64_t carrierReliefMm(int64_t wx, int64_t ex, int64_t sy, int64_t ny)
{
    const int64_t dx = ex - wx;
    const int64_t dy = ny - sy;
    return truncDiv((dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy), 2);
}

// vxc::curvatureScaleQ10 (voxelcore/carrier.h) bit-for-bit. Convex crests
// roughen toward 1.75x, concave hollows smooth toward 0.5x as colluvium fills
// them. Gates the SHAPING band only, never the microrelief band -- for the same
// reason microScaleQ10 has a floor: decimetre roughness is a property of the
// material, not of the local geometry.
//
// ALL FOUR CONSTANTS ARE PROVISIONAL AND UNCALIBRATED on the CPU side and are
// mirrored here as-is. The knee especially is per-tier and will NOT transfer to
// the fine tier (curvature magnitude is spectral); carrier.h says so at length.
// Do not "improve" them here -- they are worldgen contract, and changing one on
// this side alone is a desync, not a tweak.
//
// The clamp is the FIRST operation, which is what makes carrier.h's exhaustive
// compile-time sweep over [-knee, +knee] exhaustive over all of int64. Keep it
// first. Both divisions have a non-negative numerator by construction (the
// magnitude is taken first), so truncDiv matches the CPU's `/`.
static const int64_t kCurvatureScaleOneQ10 = 1024; // 1.0x at zero curvature
static const int64_t kCurvatureScaleMinQ10 = 512;  // 0.5x  in hollows  [PROVISIONAL]
static const int64_t kCurvatureScaleMaxQ10 = 1792; // 1.75x on crests   [PROVISIONAL]
// 0.5 mm/m^2 AT THE 30 m REFERENCE TIER -- feed the argument through
// carrierCurvatureTierNormQ10 first. A MEASURED anchor: mean |Laplacian| on a
// realistic 30 m raster is 288 q10, so a knee at 512 puts typical ground a
// little over half way to saturation. The first cut was 2048, seven times the
// mean, and the gate was wired in, bounded, proved, MIRRORED -- and doing
// nothing. Do not round it back to a tidier number.        [PROVISIONAL]
// MIRROR: carrier.h kCurvatureKneeQ10. Re-calibrated -- 0.5 left 70-96% of real
// samples saturated, i.e. a two-valued step rather than a ramp.
static const int64_t kCurvatureKneeQ10 = kCurveQ10One;

// The curvature UNIT is scale-invariant; the curvature terrain EXHIBITS is not.
// Curvature is a second derivative, so on a self-affine surface its magnitude
// grows as finer scales are resolved -- measured 288 q10 at a 30 m pixel against
// 74,182 at 1.875 m, a ratio of 257.6 against a pixel ratio of 16, i.e. almost
// exactly pxMm^-2. One knee therefore cannot serve both tiers: at 2048 it
// saturated 0% of samples at 30 m and 98% at 1.875 m.
//
// floorDiv, NOT truncDiv, and this one is not interchangeable even though it
// sits between two functions that both use truncDiv. Flooring is what makes a
// crest and a hollow of EQUAL MAGNITUDE gate equally; truncation toward zero
// would break that symmetry across zero. carrier.h pins it with static_asserts
// on carrierCurvatureTierNormQ10(+/-2560, 1875) == +/-10.
//
// OVERFLOW, in this file's arithmetic. The product re-forms exactly the quantity
// carrierCurvatureMmPerM2Q10 divided down, so its bound does NOT grow with a
// finer pitch: |curve| <= 8C * kCurveQ10One * kMmPerMSquared / pxMm^2, hence
// |curve * pxMm * pxMm| <= 8C * 1024 * 1e6 = 7.4e16 at ANY pitch -- 125x margin
// against int64's 9.22e18, the same 125x as the unit conversion it undoes.
// Evaluation is left to right, so the intermediate `curve * pxMm` is smaller
// still (2.5e12 at 30000, 3.9e13 at 1875). The divisor is 9e8, a constant.
static const int64_t kCurvatureRefPixelMm = 30000;

int64_t carrierCurvatureTierNormQ10(int64_t curveMmPerM2Q10, int64_t pxMm)
{
    return floorDiv(curveMmPerM2Q10 * pxMm * pxMm,
                    kCurvatureRefPixelMm * kCurvatureRefPixelMm);
}

int64_t curvatureScaleQ10(int64_t curveMmPerM2Q10)
{
    const int64_t c = clamp64(curveMmPerM2Q10, -kCurvatureKneeQ10, kCurvatureKneeQ10);
    if (c < 0) // crest: roughen
    {
        return kCurvatureScaleOneQ10 +
               truncDiv((-c) * (kCurvatureScaleMaxQ10 - kCurvatureScaleOneQ10),
                        kCurvatureKneeQ10);
    }
    // hollow: smooth
    return kCurvatureScaleOneQ10 -
           truncDiv(c * (kCurvatureScaleOneQ10 - kCurvatureScaleMinQ10), kCurvatureKneeQ10);
}

// --- rill / flute term (v10, voxelcore/detail_rill.h) -----------------------
// Bit-exact mirror. Water does not cut isotropic hollows; this is a value-noise
// field ~1.6 m across-slope and ~12.8 m along-slope, oriented by the carrier's
// local gradient and gated off on ground too flat for a rill to exist.
//
// WHY THE ROTATION IS QUANTISED TO A TABLE, which is the one thing here that
// looks like it could be "simplified" back into the plan's literal text and
// must not be. Rotating world position by the LOCAL gradient makes the noise
// phase a p-dependent transform of the global coordinate, whose derivative
// carries a term proportional to distance from the world origin -- measured 61x
// excess roughness at 54 km, while staying mathematically continuous the whole
// way, so a continuity test would never have caught it. Each of the 16 table
// directions is a COMPILE-TIME CONSTANT linear map and therefore has zero lever
// arm; only the blend weights depend on the gradient, and they enter
// multiplicatively and boundedly.
//
// EVERY division in this block is floorDiv, matching detail_rill.h, which uses
// floorDiv throughout rather than truncDiv. That is not interchangeable: the
// two disagree on negative numerators, and `dx * yMm - dy * xMm` in
// rillFieldAtDir is negative over half the world.
static const int64_t kRillAcrossMm = 1600;
static const int64_t kRillElongation = 8;
static const int64_t kRillAlongMm = 12800; // kRillAcrossMm * kRillElongation
static const int64_t kRillAmplitudeMm = 300;  // PROVISIONAL, see detail_rill.h
static const int64_t kRillGateStartMmPerM = 100; // 10% grade
static const int64_t kRillGateFullMmPerM = 200;  // 20% grade
static const int64_t kRillGateWidthMmPerM = 100; // Full - Start
static const int64_t kRillDirQ = 4096;
static const int64_t kRillGateQ = 4096;
static const int64_t kRillSectors = 16;
static const int64_t kRillNoiseAbs = 32768;

// 11.25-degree steps over 180 degrees, q12. A rill axis is a LINE, so a half
// turn is the whole table and index 16 wraps to 0.
static const int kRillDirCosQ[16] = {
    4096, 4017, 3783, 3406, 2896, 2276, 1567, 799,
    0, -799, -1567, -2276, -2896, -3406, -3783, -4017,
};
static const int kRillDirSinQ[16] = {
    0, 799, 1567, 2276, 2896, 3406, 3783, 4017,
    4096, 4017, 3783, 3406, 2896, 2276, 1567, 799,
};

// Octagonal norm: sqrt-free magnitude estimate, used ONLY for the gate's grade
// test. Overestimates true length by 0..+6.07% by direction.
int64_t rillOctNorm(int64_t x, int64_t y)
{
    const int64_t ax = x < 0 ? -x : x;
    const int64_t ay = y < 0 ? -y : y;
    const int64_t hi = ax > ay ? ax : ay;
    const int64_t lo = ax > ay ? ay : ax;
    return hi + floorDiv(lo, 2);
}

// Perlin's quintic on [0, kRillGateQ] -> [0, kRillGateQ], FACTORED rather than
// expanded: the expanded numerator needs 15*T^5 = 1.7e19 and blows int64, while
// this form's product is the quintic (in [0,1]) times T^5 = 1.15e18, an 8x
// margin against 9.22e18. That margin is the reason for the factoring and it is
// the same in HLSL as in C++ -- do not expand it here.
int64_t rillQuinticQ(int64_t t)
{
    const int64_t T = kRillGateQ;
    const int64_t inner = 6 * t * t - 15 * t * T + 10 * T * T;
    return floorDiv(t * t * t * inner, T * T * T * T);
}

int64_t rillGateQ(int64_t gradMagMmPerM)
{
    if (gradMagMmPerM <= kRillGateStartMmPerM) return 0;
    if (gradMagMmPerM >= kRillGateFullMmPerM) return kRillGateQ;
    const int64_t t =
        floorDiv((gradMagMmPerM - kRillGateStartMmPerM) * kRillGateQ, kRillGateWidthMmPerM);
    return rillQuinticQ(t);
}

// Aspect -> position in the direction table, in [0, kRillSectors*kRillDirQ].
// The "diamond angle" (L1 angle): continuous, strictly monotone in the true
// angle, one divide, no atan2. The gradient is folded into the upper half plane
// first because the rill axis is a line; the fold is seamless because a=0 and
// a=2 both land on entry 0.
int64_t rillSectorQ(int64_t gradXMmPerM, int64_t gradYMmPerM)
{
    int64_t gx = gradXMmPerM;
    int64_t gy = gradYMmPerM;
    if (gy < 0 || (gy == 0 && gx < 0)) { gx = -gx; gy = -gy; }
    const int64_t l1 = (gx < 0 ? -gx : gx) + gy; // > 0: the caller gates |g| == 0 away
    return floorDiv((l1 - gx) * (kRillSectors * kRillDirQ), 2 * l1);
}

// One anisotropic field: rotate the world point into table direction k, scale
// the across-slope axis by kRillElongation, sample the quintic-FADED value noise
// on that warped domain. Faded and not raw: under an 8:1 warp, valueNoise2's
// lattice creases would run dead straight down the fall line -- an artifact
// indistinguishable at a glance from the feature being created.
int64_t rillFieldAtDir(uint64_t seed, int64_t xMm, int64_t yMm, int64_t k)
{
    const int64_t dx = (int64_t)kRillDirCosQ[k];
    const int64_t dy = (int64_t)kRillDirSinQ[k];
    const int64_t along = floorDiv(dx * xMm + dy * yMm, kRillDirQ);
    const int64_t across = floorDiv(dx * yMm - dy * xMm, kRillDirQ);
    return valueNoise2Fade(seed, along, across * kRillElongation, kRillAlongMm, CH_RILL);
}

int64_t rillScaleMm(int64_t noise, int64_t gateQ)
{
    return floorDiv(noise * kRillAmplitudeMm * gateQ, kRillNoiseAbs * kRillGateQ);
}

int64_t rillMm(uint64_t seed, int64_t xMm, int64_t yMm, int64_t gradXMmPerM,
               int64_t gradYMmPerM)
{
    const int64_t gate = rillGateQ(rillOctNorm(gradXMmPerM, gradYMmPerM));
    // Early out on flats. EXACT, not an approximation: the gate is identically
    // zero here. It also keeps rillSectorQ's divide by |g| from being evaluated
    // where the aspect is undefined.
    if (gate == 0) return 0;

    const int64_t sQ = rillSectorQ(gradXMmPerM, gradYMmPerM);
    const int64_t k0 = clamp64(floorDiv(sQ, kRillDirQ), 0, kRillSectors - 1);
    const int64_t k1 = (k0 + 1 == kRillSectors) ? 0 : k0 + 1;
    const int64_t f = sQ - k0 * kRillDirQ; // [0, kRillDirQ]

    const int64_t n0 = rillFieldAtDir(seed, xMm, yMm, k0);
    const int64_t n1 = rillFieldAtDir(seed, xMm, yMm, k1);
    // Convex combination: weights non-negative and summing to kRillDirQ, so the
    // range is unchanged and |rillMm| <= kRillAmplitudeMm exactly.
    const int64_t blend = floorDiv(n0 * (kRillDirQ - f) + n1 * f, kRillDirQ);

    return rillScaleMm(blend, gate);
}

// --- bedding term (v10, voxelcore/detail_bedding.h) -------------------------
// Bit-exact mirror. A regional 819.2 m strike/dip/thickness field, plus the
// quasi-periodic banding the ground surface makes where it cuts the tilted bed
// planes -- so layered rock reads as layered across a whole hillside rather than
// per-point.
//
// THE RAW (UNDIVIDED) PROJECTION IS CARRIED AS FAR AS POSSIBLE AND DIVIDED DOWN
// ONCE, LATE. Reducing perpRaw to true mm immediately would staircase it --
// perpRaw changes by only ~kBeddingDirScale per millimetre of x, so a floorDiv
// by 64 sits still for ~64 steps then jumps a whole unit, which through the
// steep per-bed profile becomes a visible step recurring every ~64 mm. That is a
// seam artifact WITHIN a structural domain, exactly the class this project
// exists to remove. Every stage below divides only by something large relative
// to its numerator's per-millimetre delta. Do not "simplify" the scaling.
static const int64_t kBeddingDomainMm = 819200; // 819.2 m
static const int64_t kBeddingDirScale = 64;
static const int64_t kBeddingDipMaxQ10 = 3072; // ~71.6 degrees, finite by construction
static const int64_t kBeddingThicknessMinMm = 800;
static const int64_t kBeddingThicknessMaxMm = 3200;
static const int64_t kBeddingRawScale = (int64_t)1024 * 32768; // shapeQ10 * hardness den
static const int64_t kBeddingWarpLatticeMul = 3;
static const int64_t kBeddingWarpAmpQ10 = 384;
static const int64_t kBeddingPeakFracMinQ10 = 307;
static const int64_t kBeddingPeakFracMaxQ10 = 717;
// MIRROR: detail_bedding.h kBeddingAmpMm. 320 -> 120: at 320 this term alone was
// 4.66x the whole detail S2 budget at the 0.4 m lag.        PROVISIONAL
static const int64_t kBeddingAmpMm = 120;

// The 16 strike directions. Entries 8..15 are the EXACT 90-degree rotation
// (-dy, dx) of entries 0..7, which is an integer identity with no rounding, so
// strike and its perpendicular (the dip direction) are exactly orthogonal for
// every entry. That exactness is load-bearing for along-strike invariance.
static const int kBeddingStrikeDx[16] = {
    64, 63, 59, 53, 45, 36, 24, 12, 0, -12, -24, -36, -45, -53, -59, -63,
};
static const int kBeddingStrikeDy[16] = {
    0, 12, 24, 36, 45, 53, 59, 63, 64, 63, 59, 53, 45, 36, 24, 12,
};

// vxc::beddingHashField16, SPLIT so the shift distance is always a bare literal
// at the call site.
//
// The C++ original takes `shift` as a parameter. Mirrored literally -- as a
// macro or as a helper that shifts by its own argument -- that is a variable
// shift distance, which lint-shader-ub rejects as VARIABLE_SHIFT and rightly so:
// an out-of-range shift is undefined and vendors differ on whether the distance
// is masked. The same construct was already deleted once from this file (see
// coarseRep's note on `1 << level`). So the helper takes the ALREADY-EXTRACTED
// 16 bits and every caller does its own `>> <literal>` â€” same arithmetic, no
// variable shift anywhere.
int64_t beddingRangeFrom16(int64_t bits, int64_t lo, int64_t hi)
{
    return lo + floorDiv(bits * (hi - lo), 65535);
}

// shapeQ10 * hardness, in [-kBeddingRawScale, kBeddingRawScale] exactly.
//
// The CPU calls beddingDomainHash three times (once each for strike, dip and
// thickness) and this hoists it to one `dh`. hash2 is a pure function of its
// arguments, so that is value-identical, not merely equivalent -- and it is the
// same single hash the C++ comment says it intends ("a single hash2, sliced into
// disjoint bit ranges").
int64_t beddingRawAt(uint64_t seed, int64_t xMm, int64_t yMm, int64_t zMm)
{
    const uint64_t dh = hash2(seed, floorDiv(xMm, kBeddingDomainMm),
                              floorDiv(yMm, kBeddingDomainMm), CH_BEDDING_STRIKE);
    const uint strikeIdx = (uint)(dh >> 60) & 0xFu;                          // top 4 bits
    const int64_t dipQ10 = beddingRangeFrom16((int64_t)((dh >> 32) & 0xFFFFULL),
                                              -kBeddingDipMaxQ10, kBeddingDipMaxQ10);
    const int64_t thicknessMm = beddingRangeFrom16((int64_t)((dh >> 16) & 0xFFFFULL),
                                                   kBeddingThicknessMinMm,
                                                   kBeddingThicknessMaxMm);

    const int64_t strikeDx = (int64_t)kBeddingStrikeDx[strikeIdx];
    const int64_t strikeDy = (int64_t)kBeddingStrikeDy[strikeIdx];
    const int64_t dipDirX = -strikeDy; // exact 90-degree rotation
    const int64_t dipDirY = strikeDx;

    const int64_t perpRaw = xMm * dipDirX + yMm * dipDirY;

    const int64_t drawZ = zMm * kBeddingDirScale;
    const int64_t drawDip = floorDiv(dipQ10 * perpRaw, 1024);
    const int64_t dRaw = drawZ - drawDip;

    // Domain warp: a smooth 1D hashed field over dRaw, giving locally variable
    // bed thickness without ever summing more than the two nearest lattice
    // corners.
    const int64_t thicknessRaw = thicknessMm * kBeddingDirScale;
    const int64_t warpLatticeRaw = thicknessRaw * kBeddingWarpLatticeMul;
    const int64_t wi0 = floorDiv(dRaw, warpLatticeRaw);
    const int64_t wf = dRaw - wi0 * warpLatticeRaw; // [0, warpLatticeRaw)
    const int64_t wv0 = (int64_t)hashToSigned16(hash2(seed, wi0, 0, CH_BEDDING));
    const int64_t wv1 = (int64_t)hashToSigned16(hash2(seed, wi0 + 1, 0, CH_BEDDING));
    const int64_t warpAmpRaw = floorDiv(thicknessRaw * kBeddingWarpAmpQ10, 1024);
    const int64_t warpRaw = floorDiv((wv0 * (warpLatticeRaw - wf) + wv1 * wf) * warpAmpRaw,
                                     32768 * warpLatticeRaw);
    const int64_t dwRaw = dRaw + warpRaw;

    const int64_t bedIdx = floorDiv(dwRaw, thicknessRaw);
    const int64_t fracRaw = dwRaw - bedIdx * thicknessRaw; // [0, thicknessRaw)

    const int64_t pfQ10 = beddingRangeFrom16(
        (int64_t)(hash2(seed, bedIdx, 2, CH_BEDDING) & 0xFFFFULL), kBeddingPeakFracMinQ10,
        kBeddingPeakFracMaxQ10);
    const int64_t pfRaw = floorDiv(pfQ10 * thicknessRaw, 1024);

    // Asymmetric tent: 0 at bed boundaries, 1024 at the hashed peak. The `> 0`
    // guards are defensive only (pfQ10 in [307,717] and thicknessRaw > 0 already
    // give 0 < pfRaw < thicknessRaw) and are mirrored because the whole point of
    // the source file is not to trust an unchecked division.
    int64_t shapeQ10;
    if (fracRaw <= pfRaw)
    {
        shapeQ10 = pfRaw > 0 ? floorDiv(fracRaw * 1024, pfRaw) : 1024;
    }
    else
    {
        const int64_t span = thicknessRaw - pfRaw;
        shapeQ10 = span > 0 ? floorDiv((thicknessRaw - fracRaw) * 1024, span) : 0;
    }

    const int64_t hardness = (int64_t)hashToSigned16(hash2(seed, bedIdx, 1, CH_BEDDING));
    return shapeQ10 * hardness;
}

// 2D bedding displacement, mm. |result| <= kBeddingAmpMm, proved in
// detail_bedding.h.
//
// THE z ARGUMENT IS THE CARRIER HEIGHT BEFORE DETAIL, not the final surface --
// see the call in evalSurface. Beds sit at fixed ABSOLUTE elevations and the
// ground cuts through them, so feeding the wrong z slides the whole stack.
int64_t beddingMm(uint64_t seed, int64_t xMm, int64_t yMm, int64_t surfaceMm)
{
    return floorDiv(kBeddingAmpMm * beddingRawAt(seed, xMm, yMm, surfaceMm), kBeddingRawScale);
}

// --- bounded 3D density band (v12, voxelcore/density3.h) --------------------
// Bit-exact mirror. Read that header for the design; what matters HERE is the
// three things that make this mirror different from every other block in this
// file:
//
//   1. IT HASHES PER VOXEL, not per column. Every other worldgen term in this
//      file is a function of (x, y) and is evaluated once per thread; this one
//      runs inside VoxelizeMain's z loop. That is why vxc_gpu comparing the
//      full CELL buffer (rather than only the column buffer) is load-bearing
//      for this change in a way it was not for the ones before it -- a column
//      comparison cannot see this term at all.
//
//   2. THE CPU SIDE IS HOISTED AND THIS IS NOT. voxelcore/density3.h caches the
//      structural-domain hash per column (Density3Column); this file recomputes
//      it per voxel. That is DELIBERATE and it is safe for exactly one reason:
//      hash2 is pure, so a hoisted evaluation and a fresh one are the same
//      integer, and test_density3.cpp pins that equality directly. Mirroring the
//      cache here would mean mirroring a per-thread object across a language
//      boundary for no arithmetic gain.
//
//   3. EVERY DIVISION IS floorDiv. density3.h's own comment is explicit that a
//      bare `/` on a negative operand is what diverged AMD vs NVIDIA once
//      already, and the numerators here are routinely negative -- the noise is
//      signed, the bedding value is signed, and the displacement is signed.
static const int64_t kDensity3MaxAbsMm = 350;
static const int64_t kDensity3BandHalfMm = 350; // forced equal to the envelope
static const int64_t kDensity3GateQ = 4096;     // == kRillGateQ
static const int64_t kDensity3SlopeStartMmPerM = 600;
static const int64_t kDensity3SlopeFullMmPerM = 800;
static const int64_t kDensity3SlopeWidthMmPerM = 200;
static const int64_t kDensity3BandCoreMm = 200;
static const int64_t kDensity3BandRampMm = 150;
static const int64_t kDensity3RockSoilFullMm = 200;
static const int64_t kDensity3RockSoilZeroMm = 800;
static const int64_t kDensity3RockSoilWidthMm = 600;
static const int64_t kBedding3AmpMm = 350; // the WHOLE envelope; see density3.h section 2
static const int64_t kBedding3MaxAbsMm = 350;

// The slope gate, taking a slope MAGNITUDE in mm per metre. Zero at or below
// 60% grade, full at or above 80%, Perlin quintic between, so it is C2 at both
// ends: a step here would be a seam following an iso-slope contour.
int64_t density3SlopeGateQFromMag(int64_t slopeMmPerM)
{
    if (slopeMmPerM <= kDensity3SlopeStartMmPerM) return 0;
    if (slopeMmPerM >= kDensity3SlopeFullMmPerM) return kDensity3GateQ;
    const int64_t t = floorDiv((slopeMmPerM - kDensity3SlopeStartMmPerM) * kDensity3GateQ,
                               kDensity3SlopeWidthMmPerM);
    return rillQuinticQ(t);
}

// The lithology gate, on the column's depth of soil above rock. At v12 it gates
// the WHOLE displacement rather than a pocket term, so a soil-mantled column is
// skipped outright -- 45% of otherwise-qualifying columns on real tiles.
int64_t density3RockGateQ(int64_t soilDepthMm)
{
    if (soilDepthMm <= kDensity3RockSoilFullMm) return kDensity3GateQ;
    if (soilDepthMm >= kDensity3RockSoilZeroMm) return 0;
    const int64_t t = floorDiv((soilDepthMm - kDensity3RockSoilFullMm) * kDensity3GateQ,
                               kDensity3RockSoilWidthMm);
    return kDensity3GateQ - rillQuinticQ(t);
}

// The two column gates, multiplied into one q12. Exactly 0 iff either is 0 and
// exactly kDensity3GateQ iff both are open -- the exact-skip argument rests on
// the first and the envelope bound on the second.
int64_t density3ColumnGateQ(int64_t slopeGateQ, int64_t rockGateQ)
{
    return floorDiv(slopeGateQ * rockGateQ, kDensity3GateQ);
}

// The band's taper: full strength within +/-200 mm, quintic to exactly 0 at
// +/-350 mm. Exactly zero at and beyond the band edge is what makes the skip an
// identity rather than an approximation.
int64_t density3BandTaperQ(int64_t zMm, int64_t surfaceMm)
{
    const int64_t d0 = zMm - surfaceMm;
    const int64_t d = d0 < 0 ? -d0 : d0;
    if (d >= kDensity3BandHalfMm) return 0;
    if (d <= kDensity3BandCoreMm) return kDensity3GateQ;
    const int64_t t = floorDiv((d - kDensity3BandCoreMm) * kDensity3GateQ, kDensity3BandRampMm);
    return kDensity3GateQ - rillQuinticQ(t);
}

// Perlin's quintic on [0, T] -> [0, T] for an arbitrary domain T -- rillQuinticQ
// generalised off its hardwired q12 domain. FACTORED for the same overflow
// reason rillQuinticQ is: t^3 * inner never exceeds T^5, and the callers use
// T = 700 and T = 4096, so the widest product is 1.15e18 against 9.2e18. Do not
// expand it.
int64_t density3QuinticOn(int64_t t, int64_t T)
{
    const int64_t inner = 6 * t * t - 15 * t * T + 10 * T * T;
    return floorDiv(t * t * t * inner, T * T * T * T);
}

// The monotone odd contrast curve. This is what makes the term produce
// overhangs at all: the bedding tent alone reaches dD/dz > 1 on 0.29% of
// samples and yields overhangs on 0.098% of gated columns -- bounded,
// continuous, gated and geometrically inert.
//
// THREE passes at v12, up from two, unrolled explicitly (density3.h
// static_asserts that its own pass count still matches this body). Halving the
// envelope to 350 mm cost 91% of the overhang rate at two passes, because
// dD/dz > 1 is a threshold rather than a magnitude; the third pass buys 3.6x of
// it back and costs retained bed contrast, 2.9:1 -> 1.7:1. A fourth would take
// it to 1.1:1, which is a uniform corrugation with no differential weathering
// left. It fixes 0 and both endpoints EXACTLY in integers, which is what
// preserves the phase of the banding.
int64_t density3SharpenMm(int64_t rMm, int64_t ampMm)
{
    const int64_t T = 2 * ampMm;
    int64_t t = rMm + ampMm; // [0, T]
    t = density3QuinticOn(t, T);
    t = density3QuinticOn(t, T);
    t = density3QuinticOn(t, T);
    return t - ampMm;
}

// D's ONLY contributor: the SAME beddingRawAt the 2D banding uses -- same
// regional strike/dip field, same 819.2 m structural lattice, same warp, same
// bed index, same hardness -- at the full 350 mm envelope and through the
// contrast curve. Sharing the field is the whole design: an independently
// hashed 3D term would put the undercuts at heights unrelated to the bands on
// the face above them.
//
// The pocket term that used to sit beside this one was deleted at v12. It
// produced ZERO overhangs -- its 6400 mm z lattice made dD/dz > 1 unreachable --
// while costing eight hash3 per voxel, which was the only reason this block
// ever needed a hash3. See density3.h section 2.
int64_t density3BeddingMm(uint64_t seed, int64_t xMm, int64_t yMm, int64_t zMm)
{
    return density3SharpenMm(
        floorDiv(kBedding3AmpMm * beddingRawAt(seed, xMm, yMm, zMm), kBeddingRawScale),
        kBedding3MaxAbsMm);
}

int64_t density3ScaleMm(int64_t sumMm, int64_t columnGateQ, int64_t bandTaperQ)
{
    return floorDiv(sumMm * columnGateQ * bandTaperQ, kDensity3GateQ * kDensity3GateQ);
}

// D itself, with the combined column gate supplied. |D| <= kDensity3MaxAbsMm
// always.
int64_t density3DisplacementGatedMm(uint64_t seed, int64_t xMm, int64_t yMm, int64_t zMm,
                                    int64_t surfaceMm, int64_t columnGateQ)
{
    if (columnGateQ == 0) return 0;
    const int64_t taperQ = density3BandTaperQ(zMm, surfaceMm);
    if (taperQ == 0) return 0; // outside the band: exactly zero
    return density3ScaleMm(density3BeddingMm(seed, xMm, yMm, zMm), columnGateQ, taperQ);
}

// --- biome classification (voxelcore/biome.h) -------------------------------
// Bit-exact mirror of vxc::classifyBiome / vxc::biomeTreelineMm /
// vxc::biomeSurfaceMaterial. See biome.h for the doc comments explaining the
// gate order and every threshold; DO NOT let this drift from that file.

int biomeTreelineMm(int tempU8)
{
    const int64_t adjusted = (int64_t)kBiomeTreelineBaseMm +
                              ((int64_t)tempU8 - 128) * (int64_t)kBiomeTreelineMmPerTempUnit;
    return (int)clamp64(adjusted, (int64_t)kBiomeBeachUpperMm, (int64_t)9000000);
}

uint classifyBiome(int tempU8, int precipU8, int seasonalityU8, int surfaceMm,
                    int64_t slopeMmPerM)
{
    // SEA LEVEL FIRST (v8). The slope gate used to run ahead of these, so steep
    // SEAFLOOR classified as TUNDRA_ALPINE -- measured at 17.8% of the real
    // 25-tile world. Nothing below sea level can be alpine.
    if (surfaceMm < kBiomeBeachLowerMm) return BIOME_OCEAN;
    if (surfaceMm <= kBiomeBeachUpperMm) return BIOME_BEACH;
    if (slopeMmPerM > kBiomeCliffSlopeMmPerM) return BIOME_BARE_ROCK;
    if (surfaceMm > biomeTreelineMm(tempU8)) return BIOME_TUNDRA_ALPINE;

    if (tempU8 < kBiomeTempColdU8) return BIOME_TAIGA;

    const bool seasonal = seasonalityU8 >= kBiomeSeasonalHighU8;
    const bool warm = tempU8 >= kBiomeTempWarmU8;
    const bool hot = tempU8 >= kBiomeTempHotU8;

    if (precipU8 < kBiomePrecipAridU8) return hot ? BIOME_DESERT : BIOME_GRASSLAND;
    if (precipU8 < kBiomePrecipSemiU8) return (warm && seasonal) ? BIOME_SAVANNA : BIOME_GRASSLAND;
    if (precipU8 < kBiomePrecipModU8)
        return (warm && seasonal) ? BIOME_SAVANNA : BIOME_TEMPERATE_FOREST;
    return warm ? BIOME_RAINFOREST : BIOME_TEMPERATE_FOREST; // wet band
}

uint biomeSurfaceMaterial(uint biome, int surfaceMm)
{
    if (biome == BIOME_OCEAN) return MAT_MUD;
    if (biome == BIOME_BEACH) return MAT_SAND;
    if (biome == BIOME_GRASSLAND) return MAT_GRASS;
    if (biome == BIOME_TEMPERATE_FOREST) return MAT_TOPSOIL;
    if (biome == BIOME_RAINFOREST) return MAT_JUNGLE_SOIL;
    if (biome == BIOME_DESERT) return MAT_SAND;
    if (biome == BIOME_SAVANNA) return MAT_SAVANNA_GRASS;
    if (biome == BIOME_TAIGA) return MAT_PODZOL;
    if (biome == BIOME_BARE_ROCK) return MAT_ROCK;
    // BIOME_TUNDRA_ALPINE (default). Since v8 only the treeline gate reaches
    // here, so this is unambiguously cold high ground and the split is just
    // permafrost below the rock line, exposed rock above.
    return surfaceMm > kBiomeAlpineRockLineMm ? MAT_ROCK : MAT_PERMAFROST;
}

// --- kernel I/O ------------------------------------------------------------

struct GpuColumnSample
{
    int surfaceMm;
    int topsoilMm;
    int subsoilMm;
    int bedrockDepthMm;
    uint surfaceMat;
};

// One cbuffer shared by both kernels (documented per-field below) rather
// than a second one: it stays a single binding, and the fields ColumnMain
// doesn't use (BrickZMin/BricksZ) or VoxelizeMain doesn't use (RasterOriginPx/
// RasterSize/PixelSizeMm) simply go unread by that kernel's entry point.
// Under VXC_UE the same fields are declared as LOOSE GLOBALS instead of an
// explicit cbuffer. That is Unreal's convention for shader parameters (see
// Engine/Shaders/Private/Tools/SetupIndirectArgs.usf -- `uint Multiplier;`
// at file scope): loose globals land in the implicit $Globals constant
// buffer, which is exactly where Unreal's BEGIN_SHADER_PARAMETER_STRUCT
// binds SHADER_PARAMETER entries by reflected name. A hand-declared
// `cbuffer WorldGenParams : register(b0)` would be a SEPARATE constant
// buffer that Unreal never binds -- the kernel would read zeroes.
//
// Same names, same order, same types either way; only the wrapper differs.
// The Unreal-side struct is FVoxelWorldGenParameters in VoxelGpuWorldGen.cpp,
// which static_asserts its own layout against the 56 bytes the bench uses.
#ifdef VXC_UE
uint2 DispatchColumns;
int2 RasterOriginPx;
uint2 RasterSize;
int PixelSizeMm;
uint SeedLo;
uint SeedHi;
int OriginVx;
int OriginVy;
int BrickZMin;
uint BricksZ;
uint ScanCount;
uint CoarseScale;
uint RingSkirtMask;
#else
cbuffer WorldGenParams : register(b0)
{
    uint2 DispatchColumns;  // columns along x, y for this dispatch (both kernels)
    int2 RasterOriginPx;    // tile-pixel coordinate of raster window texel (0,0) (ColumnMain)
    uint2 RasterSize;       // raster window extent in pixels (ColumnMain)
    int PixelSizeMm;        // 30000 (scale 1) or 3750 (scale 8) (ColumnMain)
    uint SeedLo;            // uint64 seed split across two 32-bit values (ColumnMain)
    uint SeedHi;
    int OriginVx;           // world voxel coord of dispatch column (0,0);
    int OriginVy;           // int32 spans +/-214,000 km at 10cm â€” Earth fits
    int BrickZMin;          // (VoxelizeMain) lowest brick z-index of the stack:
                             // covers voxel z in [BrickZMin*8, (BrickZMin+BricksZ)*8)
    uint BricksZ;           // (VoxelizeMain) number of bricks in the vertical stack
    uint ScanCount;         // (Scan*Main) number of mask entries to scan
    uint CoarseScale;       // (D5) coarse cell size in level-0 voxels, i.e.
                            // 1 << level. ONE is level 0, and level 0 is
                            // EXACTLY the pre-D5 behaviour -- see coarseRep
                            // below for why that is arithmetic rather than a
                            // promise. The HOST computes 1 << level so this
                            // file contains no variable shift; see coarseRep.
    uint RingSkirtMask;     // (D5.3) ring-boundary skirt, bit per lateral face:
                            // 1=-X 2=+X 4=-Y 8=+Y. ZERO for every dispatch that
                            // is not an inward ring boundary, which is nearly
                            // all of them. See regionCellMat.
};
#endif

// Raster window (elevation mm per pixel; climate packed t|s<<8|p<<16|v<<24).
// The harness/RDG pass MUST size the window to cover every pixel the
// dispatch bilinearly samples ([floorDiv(min xMm, px) .. floorDiv(max xMm,
// px)+1]); reads clamp to the window edge deterministically as a defensive
// backstop, but a clamped read means the caller sized the window wrong.
StructuredBuffer<int> ElevationMm VXC_REG(t0);
StructuredBuffer<uint> ClimatePacked VXC_REG(t1);

RWStructuredBuffer<GpuColumnSample> OutColumns VXC_REG(u0);

// VoxelizeMain-only bindings. InColumns is the SAME buffer OutColumns was
// written to by the chained ColumnMain dispatch â€” columns are read back, not
// recomputed. Registers t3/u2 are deliberately non-contiguous with t0/t1/u0
// so that after tools/compile-shaders.ps1's DXC -fvk-*-shift mapping
// (b->+0, t->+1, u->+3) EVERY resource declared in this file lands on a
// distinct Vulkan (set=0, binding) slot, regardless of whether a given
// kernel's compiled entry point ends up referencing it:
//   b0 WorldGenParams -> binding 0   (both kernels)
//   t0 ElevationMm    -> binding 1   (ColumnMain AND, since the C6 cavern
//                                     mirror, VoxelizeMain â€” cavernSiteFor
//                                     needs the surface at the SITE's xy)
//   t1 ClimatePacked  -> binding 2   (ColumnMain)
//   u0 OutColumns     -> binding 3   (ColumnMain)
//   t3 InColumns      -> binding 4   (VoxelizeMain)
//   u2 OutCells       -> binding 5   (VoxelizeMain)
// voxel-core/bench/gpu_harness.cpp hardcodes this same layout for the
// VoxelizeMain pipeline's descriptor set.
StructuredBuffer<GpuColumnSample> InColumns VXC_REG(t3);

// One uint per cell, material id 0-255 in the low byte (packing optimization
// left for later). Layout â€” see the VoxelizeMain doc comment below for the
// precise brick/cell indexing this buffer is written with.
RWStructuredBuffer<uint> OutCells VXC_REG(u2);

// HARDENING (2026-07 cross-vendor UB pass, issue 5). `RasterSize` is host-
// controlled and unvalidated in-shader. When RasterSize.x == 0 the clamp
// upper bound `(int64_t)RasterSize.x - 1` is -1 while the lower bound is 0,
// so clamp64 returns -1 for any px past the origin (`v > hi` wins), and the
// `(uint)` cast turns that into ~4 billion â€” a wild out-of-bounds load whose
// result is vendor-defined (AMD's range-checked descriptors return 0,
// NVIDIA's may return adjacent memory). An empty raster window carries no
// data to interpolate, so return the zero element deterministically instead.
// This is a GUARD, not a behavior change: for RasterSize.{x,y} >= 1 â€” every
// window the harness/RDG pass ever binds â€” the guard is never taken and the
// clamp is unchanged.
int rasterElevationMm(int64_t px, int64_t py)
{
    if (RasterSize.x == 0u || RasterSize.y == 0u) return 0;
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the zero-extent early-out directly above proves RasterSize.x >= 1, so this clamp bound is >= 0 and the range stays well-ordered
    const int64_t lx = clamp64(px - RasterOriginPx.x, 0, (int64_t)RasterSize.x - 1);
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - same zero-extent early-out proves RasterSize.y >= 1
    const int64_t ly = clamp64(py - RasterOriginPx.y, 0, (int64_t)RasterSize.y - 1);
    return ElevationMm[(uint)(lx + ly * RasterSize.x)];
}

uint rasterClimate(int64_t px, int64_t py)
{
    if (RasterSize.x == 0u || RasterSize.y == 0u) return 0u;
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the zero-extent early-out directly above proves RasterSize.x >= 1, so this clamp bound is >= 0 and the range stays well-ordered
    const int64_t lx = clamp64(px - RasterOriginPx.x, 0, (int64_t)RasterSize.x - 1);
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - same zero-extent early-out proves RasterSize.y >= 1
    const int64_t ly = clamp64(py - RasterOriginPx.y, 0, (int64_t)RasterSize.y - 1);
    return ClimatePacked[(uint)(lx + ly * RasterSize.x)];
}

// --- evalSurface: bit-exact mirror of vxc::Amplifier::evalSurface ----------
// The surface half of column() â€” bilinear tile base plus the slope-scaled
// detail octaves, and the two by-products (tile pixel, tile slope) the rest of
// ColumnMain needs.
//
// C4 factored this out on the CPU for ONE reason, and it is the reason it
// exists here too: the cavern pass anchors rooms at ABSOLUTE z, so
// `cavernSiteFor` needs the terrain height at the SITE's own xy rather than at
// the querying column's, and that height must be produced by the very same
// function the querying column's own surfaceMm came from. VoxelizeMain
// therefore calls this directly (see cavernSiteFor below) instead of
// GpuColumnSample being widened to carry a site surface â€” which it could not
// do anyway, since the site is not a column in the dispatch.
//
// CALLER CONTRACT: this reads ElevationMm, so any kernel that calls it must
// have the raster bound and must have already refused PixelSizeMm == 0.
struct SurfaceEval
{
    int64_t px, py;        // tile pixel the column falls in
    int64_t slopeMmPerM;   // v9: carrier's analytic gradient, mm per METRE
    int surfaceMm;
};

// THE 4x4 CONTROL STENCIL, IN ONE PLACE. Prefiltered on a tier that ships raster
// SAMPLES (the 30 m s1 raster), read straight through on a tier that already ships
// control points (the baked fine tier).
//
// WHY IT IS A FUNCTION NOW. This was written out twice -- once in evalSurface and
// once in columnCarrierSlopeMmPerM -- and the two copies were NOT the same: the
// second did the raw 4x4 read unconditionally and so skipped the prefilter on the
// coarse tier. That is a latent divergence in shipped v15, because the CPU's
// density3 slope comes from evalSurface's PREFILTERED carrier while the GPU's came
// from an unprefiltered one. vxc_gpu passes at v15 only because the slope feeds a
// THRESHOLD (density3SlopeGateQFromMag) and no tested column sits near enough to
// it for the difference to flip the gate. It surfaced the moment a v16 experiment
// perturbed slopes by a few mm/m: cpu=2 gpu=0 on the top cells of gated columns,
// with every column field still matching.
//
// One definition, two callers, so the copies cannot disagree again. This is the
// same duplication that made four ablations void earlier in this session -- a
// constant mirrored in two files that only one of them was edited in.
void buildCarrierCp(int64_t px, int64_t py, int64_t pxMm, out int64_t cp[16])
{
    if (pxMm >= kCarrierSampleTierMinPixelMm)
    {
        int64_t raw[kCarrierPrefilterSpan * kCarrierPrefilterSpan];
        [unroll]
        for (int b = 0; b < kCarrierPrefilterSpan; ++b)
        {
            [unroll]
            for (int a = 0; a < kCarrierPrefilterSpan; ++a)
                raw[a + kCarrierPrefilterSpan * b] = (int64_t)rasterElevationMm(
                    px + kCarrierPrefilterLo + a, py + kCarrierPrefilterLo + b);
        }
        carrierPrefilterStencil(raw, cp);
    }
    else
    {
        [unroll]
        for (int j = 0; j < 4; ++j)
        {
            [unroll]
            for (int i = 0; i < 4; ++i)
                cp[i + 4 * j] = (int64_t)rasterElevationMm(px - 1 + i, py - 1 + j);
        }
    }
}

SurfaceEval evalSurface(uint64_t seed, int64_t vx, int64_t vy)
{
    const int64_t xMm = vx * kVoxelSizeMm;
    const int64_t yMm = vy * kVoxelSizeMm;
    const int64_t pxMm = (int64_t)PixelSizeMm;

    // C2 carrier over the tile raster (exact integer math). The control stencil
    // for this cell is px-1..px+2 on each axis -- four control points per axis
    // rather than bilinear's two, which is what buys gradient continuity across
    // the cell boundary.
    //
    // RASTER WINDOW CONTRACT: this reaches ONE pixel further on the low side and
    // TWO further on the high side than v8 did. rasterElevationMm CLAMPS to the
    // bound window, so a window that is not dilated to match would silently
    // return an edge value where the CPU reads the real tile -- a divergence
    // that no bounds check would catch. The host pass and gpu_harness both
    // dilate; see kCarrierStencilLo / kCarrierStencilHi below.
    const int64_t px = floorDiv(xMm, pxMm);
    const int64_t py = floorDiv(yMm, pxMm);
    const int64_t fx = xMm - px * pxMm;
    const int64_t fy = yMm - py * pxMm;

    // v13: PREFILTERED on a tier that ships raster SAMPLES. MIRROR:
    // amplifier.cpp cachedStencilSlot / carrier.h carrierPrefilterStencil. The
    // CPU memoises this per cell; the GPU recomputes it per column, which is
    // 144 buffer loads against 16 and is the whole cost of the change.
    int64_t cp[16];
    buildCarrierCp(px, py, pxMm, cp);

    const CarrierEval carrier = evalCarrier(cp, fx, fy, pxMm);
    const int64_t baseMm = carrier.heightMm;

    // v13: LANDFORM RELIEF across a fixed 30 m physical baseline, four reads at
    // +/- carrierReliefLagPx pixels. MIRROR: amplifier.cpp cachedStencilSlot /
    // carrier.h carrierReliefMm. These reads sit up to 16 pixels outside the
    // 4x4 stencil, which is why kCarrierStencilLo/Hi grew to +/-16 -- an
    // undilated window would clamp here and silently disagree with the CPU.
    const int64_t reliefLag = carrierReliefLagPx(pxMm);
    const int64_t reliefMm = carrierReliefMm((int64_t)rasterElevationMm(px - reliefLag, py),
                                             (int64_t)rasterElevationMm(px + reliefLag, py),
                                             (int64_t)rasterElevationMm(px, py - reliefLag),
                                             (int64_t)rasterElevationMm(px, py + reliefLag));

    // The carrier's ANALYTIC gradient, mm per metre. v8 used a per-cell forward
    // difference that was constant across a whole pixel, so the detail gain
    // stepped at every pixel line; the spline derivative is continuous, so that
    // step is structurally impossible rather than merely small.
    const int64_t slopeMmPerM = carrierSlopeMmPerM(carrier, pxMm);

    // Two bands, accumulated separately because they take different scales,
    // and each scaled ONCE â€” mirroring Amplifier::evalSurface exactly,
    // including WHERE the truncations happen. Moving a truncation is a
    // divergence even when the arithmetic is otherwise identical.
    //
    // v10: the SHAPING band also takes a CURVATURE gate. Convex crests roughen,
    // concave hollows smooth toward colluvial fill. The microrelief band is NOT
    // gated -- decimetre roughness is a property of the material, not of the
    // local geometry.
    //
    // Normalised to the 30 m reference tier BEFORE gating. Without it the gate
    // is a no-op at 30 m and hard-clipped at 1.875 m -- not two settings of one
    // gate, two different failures.
    const int64_t curveQ10 = carrierCurvatureTierNormQ10(
        carrierCurvatureMmPerM2Q10(evalCarrierCurvature(cp, fx, fy, pxMm), pxMm), pxMm);
    const int64_t cScale = curvatureScaleQ10(curveQ10);

    // v13: ONE relief gate over the ladder, replacing slopeScaleQ10 and
    // microScaleQ10, which are GONE. MIRROR: carrier.h reliefScaleQ10.
    const int64_t rScale = reliefScaleQ10(reliefMm);
    int64_t landformMm = 0;
    int64_t metreMm = 0;
    int64_t microMm = 0;
    // v10 TIER BRANCH (vxc::isFineTier). Two tables, two lengths, two band
    // splits, and the noise channel indexed by the octave's position in ITS OWN
    // table -- so the loops are written out separately rather than parameterised
    // over a table pointer HLSL does not have. Both bodies are otherwise
    // character-identical, and both are identical to the CPU's single loop.
    if (pxMm <= kFineTierMaxPixelMm)
    {
        [unroll]
        for (int i = 0; i < kFineOctaveCount; ++i)
        {
            const int64_t term = truncDiv(valueNoise2Fade(seed, xMm, yMm,
                                                          (int64_t)kFineOctaveLatticeMm[i],
                                                          CH_DETAIL_OCTAVE_BASE + (uint)i) *
                                              scaledAmpMm((int64_t)kFineOctaveAmplitudeMm[i]),
                                          32768);
            if (i < kFineLandformOctaveCount)
                landformMm += term;
            else if (i < kFineOctaveCount - kMaterialOctaveCount)
                metreMm += term;
            else
                microMm += term;
        }
    }
    else
    {
        [unroll]
        for (int i = 0; i < kOctaveCount; ++i)
        {
            const int64_t term = truncDiv(valueNoise2Fade(seed, xMm, yMm,
                                                          (int64_t)kOctaveLatticeMm[i],
                                                          CH_DETAIL_OCTAVE_BASE + (uint)i) *
                                              scaledAmpMm((int64_t)kOctaveAmplitudeMm[i]),
                                          32768);
            if (i < kLandformOctaveCount)
                landformMm += term;
            else if (i < kOctaveCount - kMaterialOctaveCount)
                metreMm += term;
            else
                microMm += term;
        }
    }
    // The microrelief band takes HALF the curvature gate's excursion (range
    // 0.75..1.375). Gating only the shaping band put the whole effect in the
    // 25.6 m and 6.4 m octaves, whose second difference over a 0.1 m lag is
    // ~1e-5 of amplitude -- invisible at every scale a player actually sees.
    // Half rather than all because a hollow genuinely smooths at decimetre scale
    // (it collects colluvium) while the material's own texture does not vanish
    // with the local geometry, and half keeps the range clear of the floor
    // microScaleQ10 exists to defend.
    //
    // `cScale - 1024` is in [-512, +768] and is ROUTINELY NEGATIVE AND ODD (a
    // hollow gives exactly -c for c in [0, 512]), so the CPU's `/ 2` is a
    // truncating divide on a negative numerator: truncDiv, never floorDiv. They
    // differ by one whole q10 step on every odd hollow.
    const int64_t cScaleMicro = 1024 + truncDiv(cScale - 1024, 2);
    // v13: THREE bands, three gates, and the MATERIAL band takes no relief gate
    // at all. Each q10 divide truncates, in exactly this order; folding any pair
    // into a single divide by 1024*1024 is NOT the same number and is a
    // divergence.
    int64_t detailMm = truncDiv(truncDiv(landformMm * rScale, 1024) * cScale, 1024) +
                       truncDiv(truncDiv(metreMm * rScale, 1024) * cScaleMicro, 1024) +
                       truncDiv(microMm * cScaleMicro, 1024);

    // Two ADDITIVE structured terms, added AFTER the band scaling because
    // neither is an fBm octave. v13: they DO take the relief gate -- see
    // amplifier.cpp for why the old reason to exempt them (each already carries
    // a GRADIENT condition) does not apply to a LANDFORM one.
    //
    // The rill gradient is the carrier's analytic gradient converted to mm per
    // METRE. `sxMmPerPx` is SIGNED, so the CPU's bare `/` is a truncating divide
    // on a routinely-negative numerator: truncDiv here, never floorDiv.
    //
    // beddingMm takes baseMm -- the carrier height BEFORE detail is added, not
    // the final surface.
    const int64_t addMm = rillMm(seed, xMm, yMm, truncDiv(carrier.sxMmPerPx * 1000, pxMm),
                                 truncDiv(carrier.syMmPerPx * 1000, pxMm)) +
                          beddingMm(seed, xMm, yMm, baseMm);
    detailMm += truncDiv(addMm * rScale, 1024);

    // v14: THE DETAIL GRADIENT CAP -- one scale-down over the whole summed
    // detail, engaged on a slope ramp. MIRROR: Amplifier::evalSurface and the
    // derivation blocks above amplifier.cpp kDetailGradCapKQ10. The nominal
    // per-band gradients go through the SAME gates in the SAME order and
    // integer form as the detail sum itself. Every operand here is
    // non-negative -- gates, gradients, slope, ramp -- EXCEPT detailMm, so the
    // final divide is on a routinely-negative numerator: truncDiv (mirrors
    // C++ `/`), never floorDiv. The other divides use truncDiv on
    // non-negative numerators, where it equals `/` exactly.
    const int64_t gradLand = (pxMm <= kFineTierMaxPixelMm) ? kFineLandformGradMmPerM
                                                           : kLandformGradMmPerM;
    const int64_t gradMetre = (pxMm <= kFineTierMaxPixelMm) ? kFineMetreGradMmPerM
                                                            : kMetreGradMmPerM;
    const int64_t gradMicro = (pxMm <= kFineTierMaxPixelMm) ? kFineMicroGradMmPerM
                                                            : kMicroGradMmPerM;
    // v15: the rill's nominal across-slope gradient joins the budget. Mirrors
    // amplifier.cpp's kRillGradMmPerM, which is kRillMaxAbsMm * 1000 /
    // kRillAcrossMm = 300 * 1000 / 1600 and is static_asserted == 187 there
    // precisely because it appears here as a literal. See the derivation block
    // above kDetailGradCapKQ10 for why v14's omission was a leaking guarantee
    // rather than a tuning choice. Every term is non-negative so truncDiv and
    // floorDiv agree, but truncDiv is used to match the CPU's `/` exactly.
    const int64_t detailGradMmPerM =
        truncDiv(truncDiv(gradLand * rScale, 1024) * cScale, 1024) +
        truncDiv(truncDiv(gradMetre * rScale, 1024) * cScaleMicro, 1024) +
        truncDiv(gradMicro * cScaleMicro, 1024) +
        truncDiv(kRillGradMmPerM * rScale, 1024);
    int64_t engageQ10 = 1024;
    if (pxMm > kFineTierMaxPixelMm)
    {
        if (reliefMm >= kDetailCapReliefHiMm)
        {
            engageQ10 = 1024;
        }
        else if (reliefMm > kDetailCapReliefLoMm)
        {
            engageQ10 = truncDiv((reliefMm - kDetailCapReliefLoMm) * 1024,
                                 kDetailCapReliefHiMm - kDetailCapReliefLoMm);
        }
        else
        {
            engageQ10 = 0;
        }
    }
    if (engageQ10 > 0)
    {
        const int64_t gradFloor = (pxMm <= kFineTierMaxPixelMm) ? kFineDetailGradFloorMmPerM
                                                                : kDetailGradFloorMmPerM;
        int64_t allowedGradMmPerM = truncDiv(kDetailGradCapKQ10 * slopeMmPerM, 1024);
        if (allowedGradMmPerM < gradFloor) allowedGradMmPerM = gradFloor;
        if (detailGradMmPerM > allowedGradMmPerM)
        {
            const int64_t capQ10 = truncDiv(allowedGradMmPerM * 1024, detailGradMmPerM);
            const int64_t scaleQ10 = 1024 - truncDiv(engageQ10 * (1024 - capQ10), 1024);
            detailMm = truncDiv(detailMm * scaleQ10, 1024);
        }
    }

    SurfaceEval s;
    s.px = px;
    s.py = py;
    s.slopeMmPerM = slopeMmPerM;
    s.surfaceMm = (int)clamp64(baseMm + detailMm, -8000000, 9000000);
    return s;
}

// The CARRIER-ONLY half of evalSurface's slope, for VoxelizeMain's 3D density
// band (v12). Returns exactly evalSurface(seed, vx, vy).slopeMmPerM.
//
// WHY THIS IS A SEPARATE FUNCTION RATHER THAN A CALL TO evalSurface. The slope
// depends on the carrier alone -- carrierSlopeMmPerM reads only CarrierEval --
// so the detail ladder, the curvature gate, the rill term and the bedding term
// that make up the rest of evalSurface contribute nothing to it and would cost
// VoxelizeMain a full column evaluation per thread for a number it discards.
//
// WHY IT IS BIT-IDENTICAL AND NOT MERELY EQUIVALENT: it is the same four lines
// of evalSurface, calling the same evalCarrier on the same 4x4 stencil read
// through the same rasterElevationMm, then the same carrierSlopeMmPerM. There
// is no re-derivation to drift. If it ever did drift, vxc_gpu's cell comparison
// fails immediately -- the band changes the material of every voxel within
// 700 mm of the surface on a gated column.
//
// CALLER CONTRACT, same as evalSurface's: this reads ElevationMm, so the raster
// window must be dilated by the carrier stencil and PixelSizeMm must already
// have been refused if zero.
int64_t columnCarrierSlopeMmPerM(int64_t vx, int64_t vy)
{
    const int64_t xMm = vx * kVoxelSizeMm;
    const int64_t yMm = vy * kVoxelSizeMm;
    const int64_t pxMm = (int64_t)PixelSizeMm;
    const int64_t px = floorDiv(xMm, pxMm);
    const int64_t py = floorDiv(yMm, pxMm);
    const int64_t fx = xMm - px * pxMm;
    const int64_t fy = yMm - py * pxMm;

    // Through the SHARED stencil builder, so this is prefiltered on a sample tier
    // exactly as evalSurface is. It was a bare raw 4x4 read here, which made the
    // header's "bit-identical to evalSurface" promise false on the coarse tier --
    // see buildCarrierCp for why vxc_gpu did not catch it at v15.
    int64_t cp[16];
    buildCarrierCp(px, py, pxMm, cp);
    return carrierSlopeMmPerM(evalCarrier(cp, fx, fy, pxMm), pxMm);
}

// Representative level-0 voxel coordinate for coarse cell `c` (ADR D5).
//
// EXACT MIRROR of vxc::GeneratedWorld::coarseRep in voxel-core/generator.h:
//
//     static constexpr int64_t coarseRep(int64_t c, int32_t level) {
//         const int64_t s = int64_t(1) << level;
//         return c * s + s / 2;
//     }
//
// AT CoarseShift == 0 THIS IS THE IDENTITY, and by arithmetic rather than by a
// special case: s == 1, so c * 1 + 0 == c. That is what makes level 0 provably
// byte-identical to every dispatch taken before D5 existed, and it is why the
// determinism digest is the gate for this change -- if level 0 moved at all,
// 6e893ab3679a8c81 would stop matching.
//
// TWO SHIFTS WERE REMOVED HERE, BOTH DELIBERATELY.
//
// `c << level` would fold to the same value for positive c, but c is a world
// voxel coordinate and is routinely NEGATIVE -- the digest's own far-negative
// fixture sits at -100,000. Left-shifting a negative signed value is exactly
// the class of construct this file's cross-vendor UB pass exists to keep out.
// The CPU writes `c * s`; so does this.
//
// And `s` ITSELF is passed in rather than computed as `1 << level`, because
// that is a VARIABLE shift distance -- undefined if it ever exceeded the width,
// with vendors differing on whether the distance is masked. lint-shader-ub
// flagged it, correctly, and the honest fix is to delete the construct rather
// than annotate it: the host computes 1 << level in C++ where the level is
// already validated, and this file never shifts by a non-literal at all.
int64_t coarseRep(int64_t c, uint scale)
{
    const int64_t s = (int64_t)scale;        // 1 at level 0; host-computed 1 << level
    return c * s + (s >> 1);                 // literal shift distance: lint-clean
}

// --- ColumnMain: bit-exact mirror of vxc::Amplifier::column ----------------

[numthreads(8, 8, 1)]
void ColumnMain(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= DispatchColumns.x || tid.y >= DispatchColumns.y)
        return;

    // HARDENING (2026-07 cross-vendor UB pass, issue 4). PixelSizeMm is a
    // host-supplied divisor that reaches floorDiv/truncDiv below (and
    // `pxMm * pxMm`). Zero would be an OpUDiv-by-zero: undefined in SPIR-V,
    // so the result is whatever the vendor's integer unit happens to produce
    // (and on some stacks it can fault). There is no meaningful column to
    // derive from a zero-size pixel, so refuse the dispatch deterministically.
    // Mirrored by a host-side assert in voxel-core/bench/gpu_harness.cpp.
    // GUARD ONLY: valid PixelSizeMm is 30000 (scale 1) or 3750 (scale 8) â€”
    // never 0 â€” so this branch is never taken on any real dispatch.
    if (PixelSizeMm == 0)
        return;

    const uint64_t seed = ((uint64_t)SeedHi << 32) | (uint64_t)SeedLo;
    // D5: OriginVx/OriginVy are in COARSE cell units at CoarseShift > 0, exactly
    // as vxc::coarseColumns takes bx*B + x in level-L cells. Identity at level 0.
    const int64_t vx = coarseRep((int64_t)OriginVx + (int64_t)tid.x, CoarseScale);
    const int64_t vy = coarseRep((int64_t)OriginVy + (int64_t)tid.y, CoarseScale);

    const SurfaceEval se = evalSurface(seed, vx, vy);
    const int64_t px = se.px;
    const int64_t py = se.py;
    const int64_t slopeMmPerM = se.slopeMmPerM;

    // CLIMATE, FADED-BILINEAR RATHER THAN NEAREST-PIXEL (v9). Mirror of
    // Amplifier::column's blendClimate. v8 read the single pixel the column fell
    // in, so classifyBiome's inputs were piecewise constant on the 30 m grid and
    // surfaceMat changed in hard 30 m squares. Measured with vxc_terrainprobe's
    // material-boundary-alignment instrument on the synthetic sampler: v8 put
    // 89.1% of material changes within one voxel of a pixel boundary against
    // 1.0% by chance; v9 puts 0%.
    //
    // Blends the CHANNELS, not the classification: the gates stay hard, which is
    // correct for a treeline or a shoreline, but they now sit on smooth
    // iso-curves instead of pixel edges.
    const int64_t xMmC = vx * kVoxelSizeMm;
    const int64_t yMmC = vy * kVoxelSizeMm;
    const int64_t pxMmC = (int64_t)PixelSizeMm;
    const int64_t cfx = fadeFractionMm(xMmC - px * pxMmC, pxMmC);
    const int64_t cfy = fadeFractionMm(yMmC - py * pxMmC, pxMmC);
    const int64_t cgx = pxMmC - cfx;
    const int64_t cgy = pxMmC - cfy;
    const int64_t cden = pxMmC * pxMmC;
    const uint cl00 = rasterClimate(px, py);
    const uint cl10 = rasterClimate(px + 1, py);
    const uint cl01 = rasterClimate(px, py + 1);
    const uint cl11 = rasterClimate(px + 1, py + 1);
    // LITERAL shift distances, one channel at a time.
    //
    // This was a macro taking the shift as a parameter, and tools/lint-shader-ub.py
    // rejected it as a VARIABLE_SHIFT -- correctly. The linter is textual and
    // cannot see that every expansion is a constant, and a non-literal shift
    // distance is undefined when out of range with vendors differing on whether
    // they mask it. That is exactly the class of construct this file exists to
    // keep out, so the honest fix is to spell the three channels out rather than
    // to annotate the macro away. Costs nothing.
    const uint clTemperature =
        (uint)blendU8((int64_t)(cl00 & 0xff), (int64_t)(cl10 & 0xff),
                      (int64_t)(cl01 & 0xff), (int64_t)(cl11 & 0xff),
                      cgx, cfx, cgy, cfy, cden);
    const uint clSeasonality =
        (uint)blendU8((int64_t)((cl00 >> 8) & 0xff), (int64_t)((cl10 >> 8) & 0xff),
                      (int64_t)((cl01 >> 8) & 0xff), (int64_t)((cl11 >> 8) & 0xff),
                      cgx, cfx, cgy, cfy, cden);
    const uint clPrecipitation =
        (uint)blendU8((int64_t)((cl00 >> 16) & 0xff), (int64_t)((cl10 >> 16) & 0xff),
                      (int64_t)((cl01 >> 16) & 0xff), (int64_t)((cl11 >> 16) & 0xff),
                      cgx, cfx, cgy, cfy, cden);

    // ECOTONE DITHER. Interpolation turns 30 m stair-steps into smooth curves,
    // but a smooth curve through a hard threshold is still a clean line, and a
    // real biome boundary is a ragged few-metre transition. +/-2 u8 units on a
    // 1.6 m lattice, applied to the two decision channels only.
    const int64_t ecoT =
        truncDiv((int64_t)hashToSigned16(hash2(seed, floorDiv(vx, 16), floorDiv(vy, 16), CH_ECOTONE_TEMP)) * 2,
                 32768);
    const int64_t ecoP =
        truncDiv((int64_t)hashToSigned16(hash2(seed, floorDiv(vx, 16), floorDiv(vy, 16), CH_ECOTONE_PRECIP)) * 2,
                 32768);
    const int clTempDithered = (int)clamp64((int64_t)clTemperature + ecoT, 0, 255);
    const int clPrecipDithered = (int)clamp64((int64_t)clPrecipitation + ecoP, 0, 255);

    GpuColumnSample outCol;
    outCol.surfaceMm = se.surfaceMm;

    // Topsoil (v8). Mirrors amplifier.cpp exactly: decode precipitation to
    // mm/yr, take a base from it, then RETAIN a slope-dependent fraction rather
    // than subtracting an absolute depth. All operands here are provably
    // non-negative, but truncDiv is used anyway -- the shader-UB lint rejects a
    // bare signed `/` on principle and the CPU side truncates identically.
    const int64_t rainMmPerYr =
        truncDiv((int64_t)clPrecipitation * kClimatePrecipSpanMmPerYr, 255);
    const int64_t topsoilBaseMm =
        kTopsoilBaseMm + truncDiv(rainMmPerYr * kTopsoilMmPerMetreOfRain, 1000);
    const int64_t retainQ10 =
        clamp64(1024 - truncDiv(slopeMmPerM * 1024, kBiomeCliffSlopeMmPerM),
                kTopsoilSlopeRetentionMinQ10, 1024);
    int64_t topsoil = truncDiv(topsoilBaseMm * retainQ10, 1024);
    const int64_t tj =
        (int64_t)hashToSigned16(hash2(seed, floorDiv(vx, 16), floorDiv(vy, 16), CH_TOPSOIL_JITTER));
    topsoil += truncDiv(topsoil * tj, 4 * 32768); // tj is signed â€” truncDiv.
    // Clamp AFTER the jitter: kTopsoilMinMm is what guarantees at least one
    // visible biome-coloured voxel on every column, and clamping first would
    // let a -25% draw break that.
    outCol.topsoilMm = (int)clamp64(topsoil, kTopsoilMinMm, kTopsoilMaxMm);

    // From the CLAMPED topsoil, not the raw local -- otherwise a floored column
    // gets the unfloored value's subsoil and the two layers disagree.
    outCol.subsoilMm = (int)clamp64((int64_t)outCol.topsoilMm * 2 + 500, 0, 6000);

    // Bedrock top: a jittered band CENTRED ON 200 m. kWorldGenVersion 5 moved
    // this from 40-60 m to 180-220 m (amplifier.cpp â€” read its comment for
    // why 200 m is the band's MEAN, not its floor). Same deterministic shape
    // as before, one 16-bit hash field linearly mapped onto [base, base+span);
    // only the two constants moved.
    const uint64_t bj = hash2(seed, floorDiv(vx, 64), floorDiv(vy, 64), CH_BEDROCK_JITTER);
    outCol.bedrockDepthMm = (int)(180000 + ((bj >> 48) * 40000) / 65536);

    // Surface material from biome classification (M4) â€” morphology gates
    // then Whittaker climate lookup, bit-exact mirror of
    // vxc::Amplifier::column's classifyBiome/biomeSurfaceMaterial call.
    // Dithered temperature/precipitation, undithered seasonality -- and the
    // topsoil depth above deliberately uses the UNDITHERED rainfall, because it
    // is a depth model rather than a boundary. Mirrors Amplifier::column.
    const uint biome = classifyBiome(clTempDithered, clPrecipDithered,
                                     (int)clSeasonality, outCol.surfaceMm, slopeMmPerM);
    outCol.surfaceMat = biomeSurfaceMaterial(biome, outCol.surfaceMm);

    OutColumns[tid.x + tid.y * DispatchColumns.x] = outCol;
}

// --- VoxelizeMain: bit-exact mirror of vxc::Amplifier::materialAt ---------
// (fed by ColumnMain's output; columns are never recomputed here).
//
// OutCells layout contract (mirrored exactly in gpu_harness.cpp):
//   - The dispatch footprint DispatchColumns (same meaning as ColumnMain:
//     one thread per voxel column) MUST be brick-aligned: DispatchColumns.x
//     and .y are exact multiples of 8. BricksX = DispatchColumns.x / 8,
//     BricksY = DispatchColumns.y / 8.
//   - Thread (tid.x, tid.y) belongs to brick footprint
//     (bx, by) = (tid.x / 8, tid.y / 8) at local column (lx, ly) = (tid.x % 8, tid.y % 8).
//   - The vertical stack for footprint (bx, by) holds BricksZ bricks; stack
//     index bz in [0, BricksZ) maps to actual brick z = BrickZMin + bz,
//     covering voxel z in [(BrickZMin+bz)*8, (BrickZMin+bz)*8 + 8) â€” i.e. the
//     whole stack spans voxel z in [BrickZMin*8, (BrickZMin+BricksZ)*8).
//   - Bricks are ordered z-major WITHIN a column's stack, and footprints are
//     ordered bx-major-x-then-y (row-major, x fastest):
//       footprintIndex = bx + BricksX * by
//       brickIndex     = footprintIndex * BricksZ + bz
//   - Cell index within a brick mirrors vxc::Brick<8>::cellIndex exactly:
//       cellIndexInBrick(x, y, z) = x + 8 * (y + 8 * z)
//   - Final index into OutCells: brickIndex * 512 + cellIndexInBrick(lx, ly, zLocal)
//
// InColumns is indexed exactly like ColumnMain's OutColumns:
//   idx = tid.x + tid.y * DispatchColumns.x

uint cellIndexInBrick(uint x, uint y, uint z) { return x + 8u * (y + 8u * z); }

// The lithology gate's argument, mirroring amplifier.cpp's soilAboveRockMm: the
// depth of soil above rock, which under a BARE_ROCK surface is the topsoil band
// alone, because stratigraphyAt below reads MAT_ROCK straight through the
// subsoil there. The two must move together -- if that case ever changes, this
// is wrong and nothing else in either file would say so.
int64_t density3SoilAboveRockMm(GpuColumnSample col)
{
    if (col.surfaceMat == MAT_ROCK) return (int64_t)col.topsoilMm;
    return (int64_t)col.topsoilMm + (int64_t)col.subsoilMm;
}

// vxc::Amplifier::stratigraphyAt bit-for-bit (the layer model, cave pass NOT
// applied â€” materialAt below is the full function).
//
// v12 GAINS THE 3D DENSITY BAND. The test was `centre <= surfaceMm`; it is now
// `centre <= surfaceMm + D`. `columnGateQ` is this column's slope and lithology
// gates already multiplied together, reduced ONCE per thread in VoxelizeMain
// and passed down the z loop --
// the same split vxc::ColumnSample::d3 makes on the CPU. They are passed rather
// than carried on GpuColumnSample on purpose: that struct is a cross-module
// contract (FVoxelGpuColumnSample in the UE module static_asserts its 20-byte
// layout, and ue-project/Shaders/VoxelBandReduce.usf reads the same buffer), and
// widening it would be a silent stride mismatch outside this repository. The
// same reasoning caves.h's mirror records for recomputing the cave column here.
//
// D DISPLACES THE WHOLE PROFILE, not just the air test, exactly as on the CPU:
// depthMm is measured from the displaced surface so topsoil, subsoil and the
// bedrock boundary hang below it rather than below a ghost surface 700 mm away.
uint stratigraphyAt(GpuColumnSample col, int64_t vz, uint64_t seed, int64_t xMm, int64_t yMm,
                    int64_t columnGateQ)
{
    const int64_t centreMm = vz * (int64_t)kVoxelSizeMm + (int64_t)kVoxelSizeMm / 2;
    const int64_t displacementMm = density3DisplacementGatedMm(
        seed, xMm, yMm, centreMm, (int64_t)col.surfaceMm, columnGateQ);
    const int64_t depthMm = (int64_t)col.surfaceMm + displacementMm - centreMm;
    if (depthMm < 0) return MAT_AIR;
    if (depthMm < (int64_t)col.topsoilMm) return col.surfaceMat;
    if (depthMm < (int64_t)col.topsoilMm + (int64_t)col.subsoilMm)
    {
        // Coarse subsoil under sandy surfaces; and under a BARE_ROCK surface
        // (v8) it is rock all the way down. Without the second case a cliff
        // column reads rock, then SUBSOIL, then rock -- a soil layer sandwiched
        // under a rock skin, which also breaks stratigraphy's depth ordering.
        if (col.surfaceMat == MAT_SAND) return MAT_GRAVEL;
        if (col.surfaceMat == MAT_ROCK) return MAT_ROCK;
        return MAT_SUBSOIL;
    }
    if (depthMm < (int64_t)col.bedrockDepthMm) return MAT_ROCK;
    return MAT_BEDROCK;
}

// --- M4 cave pass ----------------------------------------------------------
// Bit-exact mirror of voxelcore/caves.h. Read that header for WHY the network
// is a jittered lattice graph rather than 3D noise, why tube depth is measured
// from the column's own surface, and what the three safety clamps are for; the
// code below is deliberately a line-for-line transliteration of it so the two
// can be diffed by eye. DO NOT let them drift.
//
// Recomputed here per VoxelizeMain thread rather than carried through
// GpuColumnSample: it needs only (seed, vx, vy, surfaceMm) â€” no raster reads â€”
// so recomputing costs the same 34 hashes ColumnMain would have paid, keeps
// the column buffer layout (and the harness's column comparison) unchanged,
// and avoids widening a cross-kernel struct contract.

static const int64_t kCaveLatticeMm = 25600;
static const int64_t kCaveNodeDepthMinMm = 9000;
static const int64_t kCaveNodeDepthSpanMm = 25000;
static const int64_t kCaveRadiusMinMm = 1200;
static const int64_t kCaveRadiusSpanMm = 1600;
static const int64_t kCaveBackboneMask = 3;
static const uint64_t kCaveEdgeGateMask = 3;
static const int64_t kCaveShaftNodeMask = 3;
static const uint64_t kCaveShaftGateMask = 3;
static const int64_t kCaveShaftRadiusMinMm = 1000;
static const int64_t kCaveShaftRadiusSpanMm = 700;
static const int64_t kCaveRoofMinMm = 6000;
static const int64_t kCaveBedrockMarginMm = 2000;
static const int kCaveMinSurfaceMm = 12000;
static const int64_t kCaveMinVoxelZ = 0;
// Raised 8 -> 12 by M4 cave pass v2 (C2): a crevice can now ride the SAME
// lattice edge as a tunnel, so a junction column can see 4 tunnels + 4
// crevices; 12 leaves headroom. Mirrors caves.h's kMaxCaveSegs exactly â€” the
// cap is part of the worldgen contract because it decides, together with the
// (dj, di, dir) iteration order, which segments survive if it were ever hit.
static const int kMaxCaveSegs = 12;

// Crevices (M4 cave pass v2, docs/cavern-design.md Â§4): a 1-in-8 gated thin
// lens-tapered vertical slab riding an EXISTING tube's axis. Not a new
// generator and not a new per-voxel mechanism â€” it emits an ordinary CaveSeg
// in depth space, so caveCarveAt is untouched.
static const uint64_t kCrevGateMask = 7;
static const int64_t kCrevHalfThickMinMm = 300;
static const int64_t kCrevHalfThickSpanMm = 500;
static const int64_t kCrevUpMinMm = 3000;
static const int64_t kCrevUpSpanMm = 7000;
static const int64_t kCrevDownMinMm = 2000;
static const int64_t kCrevDownSpanMm = 4000;

// HashChannel ids from voxelcore/caves.h â€” append only, never renumber.
static const uint CH_CAVE_NODE = 30;
static const uint CH_CAVE_EDGE = 31;
static const uint CH_CAVE_RADIUS = 20;
static const uint CH_CAVE_SHAFT = 21;
// 22/23/25 belong to the cavern pass below (CH_CAVERN_SITE/_ROUGH/_FLOOD).
static const uint CH_CREVICE = 24;

struct GpuCaveColumn
{
    int segCount;
    int segMarginSq[kMaxCaveSegs];
    int segDepthMm[kMaxCaveSegs];
    int shaftMarginSq;
    int shaftDepthMaxMm;
};

// vxc::caveEdgeExists bit-for-bit.
bool caveEdgeExists(uint64_t seed, int64_t ei, int64_t ej, int edir)
{
    if (edir == 0 && (ej & kCaveBackboneMask) == 0) return true;
    if (edir == 1 && (ei & kCaveBackboneMask) == 0) return true;
    return ((hash2(seed, ei, ej * 2 + (int64_t)edir, CH_CAVE_EDGE) >> 48) & kCaveEdgeGateMask) == 0;
}

// vxc::caveEdgeRadiusMm bit-for-bit.
int64_t caveEdgeRadiusMm(uint64_t seed, int64_t ei, int64_t ej, int edir)
{
    const uint64_t hr = hash2(seed, ei, ej * 2 + (int64_t)edir, CH_CAVE_RADIUS);
    return kCaveRadiusMinMm +
           (int64_t)((((hr >> 44) & 0xFFFFFULL) * (uint64_t)kCaveRadiusSpanMm) >> 20);
}

// vxc::caveColumnFor bit-for-bit, including the (dj, di, dir) iteration order
// that decides which tubes survive the kMaxCaveSegs cap.
GpuCaveColumn caveColumnFor(uint64_t seed, int64_t vx, int64_t vy, int surfaceMm)
{
    GpuCaveColumn cc;
    cc.segCount = 0;
    cc.shaftMarginSq = 0;
    cc.shaftDepthMaxMm = 0;
    [unroll]
    for (int q = 0; q < kMaxCaveSegs; ++q)
    {
        cc.segMarginSq[q] = 0;
        cc.segDepthMm[q] = 0;
    }
    if (surfaceMm < kCaveMinSurfaceMm) return cc;

    const int64_t xMm = vx * (int64_t)kVoxelSizeMm;
    const int64_t yMm = vy * (int64_t)kVoxelSizeMm;
    const int64_t ci = floorDiv(xMm, kCaveLatticeMm);
    const int64_t cj = floorDiv(yMm, kCaveLatticeMm);

    int64_t nodeX[16];
    int64_t nodeY[16];
    int64_t nodeD[16];
    for (int nj = 0; nj < 4; ++nj)
    {
        for (int ni = 0; ni < 4; ++ni)
        {
            const int64_t gi = ci - 1 + (int64_t)ni;
            const int64_t gj = cj - 1 + (int64_t)nj;
            const uint64_t hn = hash2(seed, gi, gj, CH_CAVE_NODE);
            const int nidx = ni + 4 * nj;
            nodeX[nidx] = gi * kCaveLatticeMm +
                          (int64_t)(((hn & 0xFFFFFULL) * (uint64_t)kCaveLatticeMm) >> 20);
            nodeY[nidx] = gj * kCaveLatticeMm +
                          (int64_t)((((hn >> 20) & 0xFFFFFULL) * (uint64_t)kCaveLatticeMm) >> 20);
            nodeD[nidx] = kCaveNodeDepthMinMm +
                          (int64_t)((((hn >> 40) & 0xFFFFFULL) * (uint64_t)kCaveNodeDepthSpanMm) >> 20);
        }
    }

    for (int dj = 0; dj < 3; ++dj)
    {
        for (int di = 0; di < 3; ++di)
        {
            const int64_t ei = ci - 1 + (int64_t)di;
            const int64_t ej = cj - 1 + (int64_t)dj;
            for (int dir = 0; dir < 2; ++dir)
            {
                if (!caveEdgeExists(seed, ei, ej, dir)) continue;
                const int aIdx = di + 4 * dj;
                const int bIdx = (dir == 0) ? (di + 1 + 4 * dj) : (di + 4 * (dj + 1));
                const int64_t axMm = nodeX[aIdx];
                const int64_t ayMm = nodeY[aIdx];
                const int64_t adMm = nodeD[aIdx];
                const int64_t bxMm = nodeX[bIdx];
                const int64_t byMm = nodeY[bIdx];
                const int64_t bdMm = nodeD[bIdx];

                const int64_t sdx = bxMm - axMm;
                const int64_t sdy = byMm - ayMm;
                const int64_t den = sdx * sdx + sdy * sdy;
                if (den == 0) continue;

                const int64_t wx = xMm - axMm;
                const int64_t wy = yMm - ayMm;
                const int64_t num = clamp64(wx * sdx + wy * sdy, 0, den);

                const int64_t cxMm = axMm + floorDiv(sdx * num, den);
                const int64_t cyMm = ayMm + floorDiv(sdy * num, den);
                const int64_t cdMm = adMm + floorDiv((bdMm - adMm) * num, den);

                const int64_t ex = xMm - cxMm;
                const int64_t ey = yMm - cyMm;
                const int64_t rr = caveEdgeRadiusMm(seed, ei, ej, dir);
                const int64_t marginSq = rr * rr - (ex * ex + ey * ey);
                if (marginSq <= 0) continue;

                if (cc.segCount < kMaxCaveSegs)
                {
                    cc.segMarginSq[cc.segCount] = (int)marginSq;
                    cc.segDepthMm[cc.segCount] = (int)cdMm;
                    cc.segCount += 1;
                }

                // Crevice: a 1-in-8 gated thin vertical slab riding this same
                // edge. Only reachable here because marginSq > 0 already put
                // us within the (wider) tunnel radius of this axis, and
                // kCrevHalfThickMaxMm < kCaveRadiusMinMm, so a column outside
                // the tube is provably outside the crevice's narrower
                // corridor too â€” no separate reject was skipped.
                //
                // caves.h computes this hash for every existing edge (its
                // lattice block) and reads it only here; recomputing it lazily
                // is the same pure function of (seed, i, j, dir), so the value
                // is identical.
                const uint64_t crevH = hash2(seed, ei, ej * 2 + (int64_t)dir, CH_CREVICE);
                if (((crevH >> 61) & kCrevGateMask) == 0)
                {
                    const int64_t tMm =
                        kCrevHalfThickMinMm +
                        (int64_t)(((crevH & 0xFFFFFULL) * (uint64_t)kCrevHalfThickSpanMm) >> 20);
                    if (ex * ex + ey * ey <= tMm * tMm)
                    {
                        const int64_t hUpMm =
                            kCrevUpMinMm +
                            (int64_t)((((crevH >> 20) & 0xFFFFFULL) * (uint64_t)kCrevUpSpanMm) >> 20);
                        const int64_t hDownMm =
                            kCrevDownMinMm +
                            (int64_t)((((crevH >> 40) & 0xFFFFFULL) * (uint64_t)kCrevDownSpanMm) >> 20);
                        // Per-column clamp: never let the slab's top reach
                        // shallower than the roof clamp, so a crevice pinches
                        // out gracefully instead of getting a flat lid from
                        // caveCarveAt's own guard.
                        const int64_t hUpEffMm = clamp64(hUpMm, 0, cdMm - kCaveRoofMinMm);
                        const int64_t halfSpanMm = truncDiv(hUpEffMm + hDownMm, 2);
                        // Lens taper 4u(1-u), u = num/den, in Q16 FIXED POINT
                        // rather than the exact rational num*(den-num)/den^2:
                        // den = dx^2+dy^2 reaches ~5e9 mm^2 for a jittered
                        // edge, so den*den overflows int64. caves.h found that
                        // overflow and took the same Q16 route â€” this mirrors
                        // it exactly, including both floorDivs.
                        const int64_t uQ16 = floorDiv(num << 16, den);
                        const int64_t taperQ16 = (4 * uQ16 * ((int64_t)65536 - uQ16)) >> 16;
                        const int64_t halfSpanTaperedMm =
                            floorDiv(halfSpanMm * taperQ16, (int64_t)65536);
                        const int64_t crevMarginSq = halfSpanTaperedMm * halfSpanTaperedMm;
                        if (crevMarginSq > 0 && cc.segCount < kMaxCaveSegs)
                        {
                            cc.segMarginSq[cc.segCount] = (int)crevMarginSq;
                            cc.segDepthMm[cc.segCount] =
                                (int)(cdMm + floorDiv(hDownMm - hUpEffMm, 2));
                            cc.segCount += 1;
                        }
                    }
                }
            }
        }
    }

    // Sinkhole shaft â€” at most one backbone-crossing node is in reach.
    for (int sj = 0; sj < 3; ++sj)
    {
        for (int si = 0; si < 3; ++si)
        {
            if (cc.shaftMarginSq != 0) continue;
            const int64_t hi = ci - 1 + (int64_t)si;
            const int64_t hj = cj - 1 + (int64_t)sj;
            if ((hi & kCaveShaftNodeMask) != 0 || (hj & kCaveShaftNodeMask) != 0) continue;
            const uint64_t hs = hash2(seed, hi, hj, CH_CAVE_SHAFT);
            if (((hs >> 48) & kCaveShaftGateMask) != 0) continue;
            const int sIdx = si + 4 * sj;
            const int64_t sr = kCaveShaftRadiusMinMm +
                               (int64_t)(((hs & 0xFFFFFULL) * (uint64_t)kCaveShaftRadiusSpanMm) >> 20);
            const int64_t sex = xMm - nodeX[sIdx];
            const int64_t sey = yMm - nodeY[sIdx];
            const int64_t sMarginSq = sr * sr - (sex * sex + sey * sey);
            if (sMarginSq <= 0) continue;
            cc.shaftMarginSq = (int)sMarginSq;
            cc.shaftDepthMaxMm = (int)nodeD[sIdx];
        }
    }
    return cc;
}

// vxc::caveCarveAt bit-for-bit.
bool caveCarveAt(GpuCaveColumn cc, int surfaceMm, int bedrockDepthMm, int64_t vz)
{
    if (cc.segCount == 0 && cc.shaftMarginSq == 0) return false;
    if (vz < kCaveMinVoxelZ) return false;
    if (surfaceMm < kCaveMinSurfaceMm) return false;

    const int64_t centreMm = vz * (int64_t)kVoxelSizeMm + (int64_t)kVoxelSizeMm / 2;
    const int64_t depthMm = (int64_t)surfaceMm - centreMm;
    if (depthMm < 0) return false;
    if (cc.shaftMarginSq > 0 && depthMm <= (int64_t)cc.shaftDepthMaxMm) return true;
    if (depthMm < kCaveRoofMinMm) return false;
    if (depthMm + kCaveBedrockMarginMm >= (int64_t)bedrockDepthMm) return false;

    for (int s = 0; s < cc.segCount; ++s)
    {
        const int64_t dz = depthMm - (int64_t)cc.segDepthMm[s];
        if (dz * dz < (int64_t)cc.segMarginSq[s]) return true;
    }
    return false;
}

// --- M4 cave pass v2 cavern pass -------------------------------------------
// Bit-exact mirror of voxelcore/caverns.h. Read that header for WHY sites are
// hash-gated backbone-crossing nodes 204.8 m apart, why each open site is a
// COAXIAL chain of four ellipsoid rooms descending from the anchor, and why
// the per-voxel roof/bedrock/sea clamps are LOAD-BEARING here rather than
// backstops (caverns anchor at absolute z, so a level room under sloping
// terrain has no draped-depth guarantee to fall back on). The code below is a
// line-for-line transliteration so the two can be diffed by eye.
//
// The CPU splits this into cavernCandidatesFor (per coarse cell) +
// cavernSiteFor (per site) + cavernColumnFromSites (per column) purely so
// amplifier.cpp can memoise the first two â€” each is a pure function of the
// coarse cell / site respectively. The fused form below is what caverns.h
// calls "the pure, self-contained f(...) the HLSL mirror is written against",
// and is bit-identical by construction: same arithmetic, same (dj, di, room)
// iteration order.

static const int64_t kCavernCoarseLatticeRatio = 8;
static const int64_t kCavernCoarseMm = kCaveLatticeMm * kCavernCoarseLatticeRatio; // 204800
static const uint64_t kCavernSiteGateMask = 3; // bits 60..61 of CH_CAVE_NODE == 0 -> open
static const int kCavernMinSurfaceMm = 20000;  // stricter than kCaveMinSurfaceMm, SITE only
static const int kCavernChildCount = 4;
static const int64_t kCavernRxyMinMm = 12000;
static const int64_t kCavernRxySpanMm = 16000;
static const int64_t kCavernRxyMaxMm = kCavernRxyMinMm + kCavernRxySpanMm;
static const int64_t kCavernRz0MinMm = 4000;
static const int64_t kCavernRz0SpanMm = 6000;
static const int64_t kCavernRzDeepMinMm = 12000;
static const int64_t kCavernRzDeepSpanMm = 28000;
static const int64_t kCavernFloorDropMinMm = 3000;
static const int64_t kCavernFloorDropSpanMm = 12000;
static const int64_t kCavernStepDownMinMm = 2000;
static const int64_t kCavernStepDownSpanMm = 12000;
static const int64_t kCavernRoughLatticeMm = 6400;
static const int64_t kCavernRoughAmpQ10 = 307;
static const int64_t kCavernRoughMinQ10 = 717;  // 1024 - kCavernRoughAmpQ10
static const int64_t kCavernRoughMaxQ10 = 1331; // 1024 + kCavernRoughAmpQ10
// kCaveRoofMinMm + kCavernRoofSafetyMarginMm + kCavernRz0MaxMm, and
// caveNode()'s own depth ceiling (kCaveNodeDepthMinMm + kCaveNodeDepthSpanMm).
static const int64_t kCavernNodeDepthSafeMinMm = 18000;
static const int64_t kCavernNodeDepthSafeMaxMm = 34000;
// (kCavernRxyMaxMm * kCavernRoughMaxQ10) / 1024 = (28000 * 1331) / 1024, i.e.
// the widest a roughened room radius can reach from the anchor. Written as a
// literal rather than the expression so no `/` appears at file scope.
static const int64_t kCavernMaxReachMm = 36394;
static const int64_t kCavernMaxReachSqMm = kCavernMaxReachMm * kCavernMaxReachMm;
static const int64_t kCavernFloodMinMm = 800;
static const int64_t kCavernFloodSpanMm = 2400;
static const uint kCavernFloodDryThreshold32 = 1717986918u; // (4 << 32) / 10
// Mirrors vxc::kMaxCavernSegs (caverns.h). Shrunk 6 -> 4 alongside the CPU:
// it is tight == kCavernChildCount, the provable max. Must match exactly --
// the cap decides which segments survive in ColumnSample, so a wider GPU cap
// would admit a 5th segment the CPU dropped and diverge the digest.
static const int kMaxCavernSegs = 4;
// vxc::CavernSite/CavernColumn's INT32_MIN "dry" sentinel. Spelled as a hex
// bit pattern because HLSL parses -2147483648 as a negation of a literal that
// does not fit in int.
static const int kCavernDryZMm = (int)0x80000000u;

static const uint CH_CAVERN_SITE = 22;  // per-room geometry (radii/floor/step)
static const uint CH_CAVERN_ROUGH = 23; // per-column wall roughness
static const uint CH_CAVERN_FLOOD = 25; // per-site flood level

// vxc::cavernHashField10 â€” unsigned 10-bit field -> [0, spanMm), multiply-
// then-shift, never a division. The CPU takes a `shift` parameter; here the
// caller pre-shifts instead, so every shift distance in this file stays an
// integer LITERAL (a variable shift distance is undefined past the operand
// width and is one of tools/lint-shader-ub.py's rules). Same value.
int64_t cavernField10(uint64_t hShifted, int64_t spanMm)
{
    return (int64_t)(((hShifted & 0x3FFULL) * (uint64_t)spanMm) >> 10);
}

struct GpuCaveNode
{
    int64_t xMm, yMm, depthMm;
};

// vxc::CavernSite. xy is always the anchor's (every room is coaxial), so only
// the per-room z, radii and floor are carried.
struct GpuCavernSite
{
    bool valid;
    int64_t anchorZMm;
    int64_t childZMm[kCavernChildCount];
    int64_t childRxyMm[kCavernChildCount];
    int64_t childRzMm[kCavernChildCount];
    int64_t childFloorZMm[kCavernChildCount];
    int floodZMm;
};

// vxc::CavernColumn.
struct GpuCavernColumn
{
    int count;
    int marginSq[kMaxCavernSegs];
    int zCenterMm[kMaxCavernSegs];
    int zFloorMm[kMaxCavernSegs];
    int floodZMm;
};

// vxc::cavernSiteFor bit-for-bit.
//
// THE surfaceAt CONTRACT (caverns.h, and the whole reason evalSurface exists
// as a separate function on both sides): the surface is sampled at the SITE's
// OWN (node.xMm, node.yMm), NOT at the querying column's xy. A lake or room
// floor that drapes with the terrain overhead is visibly wrong; caverns anchor
// at absolute z so floors and water tables stay level. amplifier.cpp supplies
// `evalSurface(floorDiv(xMm, kVoxelSizeMm), floorDiv(yMm, kVoxelSizeMm))
// .surfaceMm` â€” including the mm -> voxel floorDiv, mirrored exactly below.
GpuCavernSite cavernSiteFor(uint64_t seed, int64_t fi, int64_t fj, GpuCaveNode node)
{
    GpuCavernSite site;
    site.valid = false;
    site.anchorZMm = 0;
    site.floodZMm = kCavernDryZMm;
    [unroll]
    for (int q = 0; q < kCavernChildCount; ++q)
    {
        site.childZMm[q] = 0;
        site.childRxyMm[q] = 0;
        site.childRzMm[q] = 0;
        site.childFloorZMm[q] = 0;
    }

    const int siteSurfaceMm = evalSurface(seed, floorDiv(node.xMm, (int64_t)kVoxelSizeMm),
                                          floorDiv(node.yMm, (int64_t)kVoxelSizeMm))
                                  .surfaceMm;
    if (siteSurfaceMm < kCavernMinSurfaceMm) return site; // beach/ocean guard on the SITE

    site.anchorZMm = (int64_t)siteSurfaceMm - node.depthMm;

    int64_t maxFloorZMm = (int64_t)0x8000000000000000ULL; // INT64_MIN
    int64_t prevZMm = site.anchorZMm;
    for (int c = 0; c < kCavernChildCount; ++c)
    {
        const uint64_t h = hash3(seed, fi, fj, (int64_t)c, CH_CAVERN_SITE);
        const bool isRoot = (c == 0);

        const int64_t rxyMm = kCavernRxyMinMm + cavernField10(h, kCavernRxySpanMm);
        const int64_t rzMm = isRoot ? kCavernRz0MinMm + cavernField10(h >> 10, kCavernRz0SpanMm)
                                    : kCavernRzDeepMinMm + cavernField10(h >> 10, kCavernRzDeepSpanMm);
        const int64_t floorDropMm =
            kCavernFloorDropMinMm + cavernField10(h >> 20, kCavernFloorDropSpanMm);
        const int64_t stepDownMm =
            isRoot ? 0 : kCavernStepDownMinMm + cavernField10(h >> 30, kCavernStepDownSpanMm);

        const int64_t zMm = isRoot ? site.anchorZMm : prevZMm - stepDownMm;
        prevZMm = zMm;

        site.childZMm[c] = zMm;
        site.childRxyMm[c] = rxyMm;
        site.childRzMm[c] = rzMm;
        site.childFloorZMm[c] = zMm - floorDropMm;
        if (site.childFloorZMm[c] > maxFloorZMm) maxFloorZMm = site.childFloorZMm[c];
    }

    // Flood level: 40% of open sites dry, else a level just above the highest
    // room floor, clamped below the anchor and above zero.
    const uint64_t floodHash = hash2(seed, fi, fj, CH_CAVERN_FLOOD);
    if ((uint)(floodHash >> 32) >= kCavernFloodDryThreshold32)
    {
        const int64_t floodMm =
            maxFloorZMm + kCavernFloodMinMm + cavernField10(floodHash, kCavernFloodSpanMm);
        site.floodZMm = (int)clamp64(floodMm, 1, site.anchorZMm - 1);
    }

    site.valid = true;
    return site;
}

// vxc::cavernColumnFor bit-for-bit â€” the fused candidates + per-column
// reduction, including the (dj, di) corner order and the per-room order that
// together decide which segments survive the kMaxCavernSegs cap.
GpuCavernColumn cavernColumnFor(uint64_t seed, int64_t vx, int64_t vy, int surfaceMm)
{
    GpuCavernColumn cv;
    cv.count = 0;
    cv.floodZMm = kCavernDryZMm;
    [unroll]
    for (int q = 0; q < kMaxCavernSegs; ++q)
    {
        cv.marginSq[q] = 0;
        cv.zCenterMm[q] = 0;
        cv.zFloorMm[q] = 0;
    }
    // The QUERYING column's ordinary ocean/beach guard â€” deliberately the more
    // permissive kCaveMinSurfaceMm; kCavernMinSurfaceMm is stricter and
    // applies only to the SITE's own surface, inside cavernSiteFor.
    if (surfaceMm < kCaveMinSurfaceMm) return cv;

    const int64_t xMm = vx * (int64_t)kVoxelSizeMm;
    const int64_t yMm = vy * (int64_t)kVoxelSizeMm;
    const int64_t si = floorDiv(xMm, kCavernCoarseMm);
    const int64_t sj = floorDiv(yMm, kCavernCoarseMm);

    for (int dj = 0; dj < 2; ++dj)
    {
        for (int di = 0; di < 2; ++di)
        {
            const int64_t fi = (si + (int64_t)di) * kCavernCoarseLatticeRatio;
            const int64_t fj = (sj + (int64_t)dj) * kCavernCoarseLatticeRatio;

            // vxc::cavernCandidatesFor: cheapest reject first â€” the site gate
            // folded into bits 60/61 of the node-jitter hash caveNode() would
            // compute anyway, then the node those same bits also encode
            // (vxc::caveNodeFromHash), then child 0's depth safety window.
            const uint64_t hn = hash2(seed, fi, fj, CH_CAVE_NODE);
            if (((hn >> 60) & kCavernSiteGateMask) != 0) continue;
            GpuCaveNode node;
            node.xMm = fi * kCaveLatticeMm +
                       (int64_t)(((hn & 0xFFFFFULL) * (uint64_t)kCaveLatticeMm) >> 20);
            node.yMm = fj * kCaveLatticeMm +
                       (int64_t)((((hn >> 20) & 0xFFFFFULL) * (uint64_t)kCaveLatticeMm) >> 20);
            node.depthMm =
                kCaveNodeDepthMinMm +
                (int64_t)((((hn >> 40) & 0xFFFFFULL) * (uint64_t)kCaveNodeDepthSpanMm) >> 20);
            if (node.depthMm < kCavernNodeDepthSafeMinMm ||
                node.depthMm > kCavernNodeDepthSafeMaxMm)
                continue;

            // Every room shares the anchor's xy (coaxial chain), so this
            // distance is computed ONCE per column, not once per room.
            const int64_t ex = xMm - node.xMm;
            const int64_t ey = yMm - node.yMm;
            const int64_t dxySq = ex * ex + ey * ey;
            if (dxySq > kCavernMaxReachSqMm) continue;

            // Full reduction: the one place the terrain raster is read. At
            // most one corner per column ever reaches here (caverns.h
            // static_assert), so no column does this twice.
            const GpuCavernSite site = cavernSiteFor(seed, fi, fj, node);
            if (!site.valid) continue;

            // Wall roughness: one 2D value-noise sample for this column,
            // shared by every room of this site.
            const int64_t roughQ10 =
                clamp64(1024 + truncDiv(valueNoise2(seed, xMm, yMm, kCavernRoughLatticeMm,
                                                    CH_CAVERN_ROUGH) *
                                            kCavernRoughAmpQ10,
                                        32768),
                        kCavernRoughMinQ10, kCavernRoughMaxQ10);

            for (int c = 0; c < kCavernChildCount; ++c)
            {
                const int64_t rxyMm = site.childRxyMm[c];
                const int64_t rzMm = site.childRzMm[c];
                const int64_t rxySq = rxyMm * rxyMm;
                const int64_t rxySqRough = truncDiv(rxySq * roughQ10, 1024);
                if (dxySq >= rxySqRough) continue; // this room doesn't reach here
                const int64_t marginSq = truncDiv(rzMm * rzMm * (rxySqRough - dxySq), rxySqRough);
                if (marginSq <= 0) continue;
                if (cv.count < kMaxCavernSegs)
                {
                    cv.marginSq[cv.count] = (int)marginSq;
                    cv.zCenterMm[cv.count] = (int)site.childZMm[c];
                    cv.zFloorMm[cv.count] = (int)site.childFloorZMm[c];
                    cv.count += 1;
                }
            }
            cv.floodZMm = site.floodZMm;
        }
    }
    return cv;
}

// vxc::cavernCarveAt bit-for-bit. Same guard order/shape as caveCarveAt, minus
// the sinkhole exception (caverns have no construct allowed through the roof).
bool cavernCarveAt(GpuCavernColumn cv, int surfaceMm, int bedrockDepthMm, int64_t vz)
{
    if (cv.count == 0) return false;
    if (vz < kCaveMinVoxelZ) return false;
    if (surfaceMm < kCaveMinSurfaceMm) return false;

    const int64_t zAbs = vz * (int64_t)kVoxelSizeMm + (int64_t)kVoxelSizeMm / 2;
    const int64_t depthMm = (int64_t)surfaceMm - zAbs;
    if (depthMm < 0) return false; // above ground
    if (depthMm < kCaveRoofMinMm) return false;
    if (depthMm + kCaveBedrockMarginMm >= (int64_t)bedrockDepthMm) return false;

    for (int s = 0; s < cv.count; ++s)
    {
        if (zAbs < (int64_t)cv.zFloorMm[s]) continue; // flat floor clamp
        const int64_t dz = zAbs - (int64_t)cv.zCenterMm[s];
        if (dz * dz < (int64_t)cv.marginSq[s]) return true;
    }
    return false;
}

// vxc::Amplifier::materialAt bit-for-bit (stratigraphy, then caves, then
// caverns â€” caverns ordered last purely because a cavern column is far rarer,
// so the common case never reaches that call: cavernCarveAt's first test is
// `count == 0`).
uint materialAt(GpuColumnSample col, GpuCaveColumn cc, GpuCavernColumn cv, int64_t vz,
                uint64_t seed, int64_t xMm, int64_t yMm, int64_t columnGateQ)
{
    const uint m = stratigraphyAt(col, vz, seed, xMm, yMm, columnGateQ);
    if (m == MAT_AIR || m == MAT_BEDROCK) return m;
    if (caveCarveAt(cc, col.surfaceMm, col.bedrockDepthMm, vz)) return MAT_AIR;
    if (cavernCarveAt(cv, col.surfaceMm, col.bedrockDepthMm, vz)) return MAT_AIR;
    return m;
}

[numthreads(8, 8, 1)]
void VoxelizeMain(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= DispatchColumns.x || tid.y >= DispatchColumns.y)
        return;

    // Same guard as ColumnMain, and now load-bearing for the same reason: the
    // cavern pass calls evalSurface (for the SITE's surface height), which
    // divides by PixelSizeMm. GUARD ONLY â€” valid values are 30000 or 3750.
    if (PixelSizeMm == 0)
        return;

    const uint bx = tid.x / 8u, by = tid.y / 8u;
    const uint lx = tid.x % 8u, ly = tid.y % 8u;
    const uint bricksX = DispatchColumns.x / 8u;
    const uint footprintIndex = bx + bricksX * by;

    const GpuColumnSample col = InColumns[tid.x + tid.y * DispatchColumns.x];

    // Cave pass: one reduction per column, reused down the whole brick stack â€”
    // the same split vxc::ColumnSample::cave makes on the CPU.
    const uint64_t caveSeed = ((uint64_t)SeedHi << 32) | (uint64_t)SeedLo;
    // D5: same coarse mapping ColumnMain used, so the cave and cavern passes
    // sample at the representative column rather than the coarse index.
    const int64_t colVx = coarseRep((int64_t)OriginVx + (int64_t)tid.x, CoarseScale);
    const int64_t colVy = coarseRep((int64_t)OriginVy + (int64_t)tid.y, CoarseScale);
    const GpuCaveColumn cave = caveColumnFor(caveSeed, colVx, colVy, col.surfaceMm);

    // Cavern pass, wired in exactly as the cave pass above: one reduction per
    // column, reused down the whole brick stack. Unlike caves it DOES read the
    // raster â€” cavernSiteFor evaluates the terrain height at the site's own xy
    // (see its comment) â€” so VoxelizeMain now binds ElevationMm (t3 -> Vulkan
    // binding 1). caverns.h's design doc Â§3.5 chose this over widening
    // GpuColumnSample: the site is generally not a column in the dispatch, so
    // there is no column entry to carry its surface on.
    const GpuCavernColumn cavern = cavernColumnFor(caveSeed, colVx, colVy, col.surfaceMm);

    // v12 3D density band (voxelcore/density3.h): the column-invariant half,
    // reduced once here and reused down the whole brick stack, exactly as the
    // cave and cavern passes above are.
    //
    // THE SLOPE IS RECOMPUTED FROM THE CARRIER, and that is the one place this
    // kernel pays a real price for not widening GpuColumnSample. ColumnMain
    // already computed this exact number inside evalSurface and threw it away;
    // columnCarrierSlopeMmPerM below re-reads the 4x4 control stencil and
    // re-evaluates the spline to get it back. It is bit-identical BY
    // CONSTRUCTION -- it calls the very same evalCarrier and carrierSlopeMmPerM
    // on the very same inputs -- and it is ~16 raster loads plus one spline per
    // THREAD, not per voxel. The alternative was a 24-byte GpuColumnSample,
    // which the UE module's FVoxelGpuColumnSample static_asserts against and
    // ue-project/Shaders/VoxelBandReduce.usf reads with the old stride.
    const int64_t d3xMm = colVx * (int64_t)kVoxelSizeMm;
    const int64_t d3yMm = colVy * (int64_t)kVoxelSizeMm;
    // The two gates multiply into one q12, exactly as Density3Column does on the
    // CPU. Ordered cheapest-first and short-circuited: the slope gate rejects
    // most ground before the lithology gate is looked at, and on the 25 real
    // diffusion tiles the pair together rejects 93.5% of columns.
    const int64_t d3SlopeGateQ =
        density3SlopeGateQFromMag(columnCarrierSlopeMmPerM(colVx, colVy));
    const int64_t d3GateQ =
        d3SlopeGateQ == 0
            ? 0
            : density3ColumnGateQ(d3SlopeGateQ,
                                  density3RockGateQ(density3SoilAboveRockMm(col)));

    for (uint bz = 0; bz < BricksZ; ++bz)
    {
        const uint brickIndex = footprintIndex * BricksZ + bz;
        const int64_t brickZ = (int64_t)BrickZMin + (int64_t)bz;
        [unroll]
        for (uint z = 0; z < 8u; ++z)
        {
            // D5: mirrors makeCoarseBrick's
            // materialAt(col, coarseRep(key.z * B + z, level)). Identity at 0.
            const int64_t vz = coarseRep(brickZ * (int64_t)8 + (int64_t)z, CoarseScale);
            // lint-shader-ub: allow UNGUARDED_WRITE - index is bounded by construction: the entry guard caps tid below DispatchColumns, so footprintIndex < bricksX*bricksY and brickIndex < bricksX*bricksY*BricksZ, while lx/ly/z are all < 8; the host sizes OutCells to exactly bricksX*bricksY*BricksZ*512 (contract mirrored in gpu_harness.cpp, asserted there)
            OutCells[brickIndex * 512u + cellIndexInBrick(lx, ly, z)] =
                materialAt(col, cave, cavern, vz, caveSeed, d3xMm, d3yMm, d3GateQ);
        }
    }
}

// --- Greedy mesher kernels (docs/gpu-mesher-design.md) ---------------------
// Bit-exact port of vxc::meshBrick<8> (voxelcore/mesher.h). Determinism
// strategy: count -> host exclusive scan -> emit at scanned offsets. NO
// atomics anywhere in the output path, so quad order is identical to the CPU
// stream by construction:
//   per interior brick: axis {0,1,2} x dir {neg,pos} x slice {0..7} masks,
//   quads within a mask in the CPU row-major greedy emission order.
//
// One thread per face-mask. Mask decode (mirrors the CPU loop nesting in
// meshBrick: axis outer, then dir, then slice):
//   maskIndex = meshBrickIndex * 48 + axis * 16 + dir * 8 + slice
// Interior bricks only (the 1-brick halo supplies apron reads):
//   interior dims: mbx = BricksX-2, mby = BricksY-2, mbz = BricksZ-2
//   meshBrickIndex = ix + mbx * (iy + mby * iz)   (x fastest, z slowest)
//   actual brick   = (ix+1, iy+1, iz+1) in region brick coords
//
// Bindings (register -> -fvk-shift Vulkan binding; all distinct, see the
// table above InColumns): u4 OutQuadCounts -> 7, t5 InQuadOffsets -> 6,
// u5 OutQuads -> 8.
//
// Packed quad (2x uint32, unpacked and byte-compared against vxc::Quad in
// the harness):
//   word0 = axis | positive<<4 | slice<<8 | u0<<16 | v0<<24
//   word1 = w | h<<8 | ao<<16 | mat<<24

RWStructuredBuffer<uint> OutQuadCounts VXC_REG(u4);
StructuredBuffer<uint> InQuadOffsets VXC_REG(t5);
RWStructuredBuffer<uint2> OutQuads VXC_REG(u5);

// --- Wave D / D2: the chunk-local emit permutation --------------------------
//
// WHAT IT CHANGES. Two things, both only in the emit path:
//
//   1. Quad positions are baked to CHUNK-local voxel coordinates (0..31) here
//      instead of brick-local (0..7). That is exactly what MeshChunkBricks
//      produces and exactly what the geometry pool consumes, so the CPU-side
//      rebase in FVoxelGpuMeshJobManager (RebaseQuadsToChunkLocal) becomes
//      dead: the quad stream is pool-ready as it leaves the GPU.
//   2. Writes are offset by QuadWriteBase, so several chunks can emit into
//      disjoint slices of ONE buffer in one dispatch batch, and so a later
//      stage can point OutQuads straight at the pool's allocated range.
//
// WHY IT IS A PERMUTATION AND NOT AN EDIT IN PLACE. The determinism gate
// (voxel.GPU.VerifyRegion and the Vulkan bench) folds the packed quad FIELDS
// into its digest. slice/u0/v0 are quad fields. Rebasing them changes the
// digest even though the quads are display-only and the underlying geometry is
// identical â€” so an unconditional edit here would turn Wave C's freshly green
// gate red for a reason that has nothing to do with worldgen. Gating it means
// the gate keeps compiling and running the byte-for-byte identical program it
// was pinned against, and the streaming path gets its own permutation.
//
// The gate on the NEW permutation is voxel.GPU.VerifyAsyncMesh, which
// byte-compares against MeshChunkBricks + PackVoxelChunkQuad â€” a strictly
// stronger check than the digest for this purpose, because the CPU mesher it
// compares against is the shipping one and it compares CHUNK-local quads.
//
// UNREAL ONLY, DELIBERATELY. Keeping the whole thing behind a define that the
// standalone DXC leg never sets means tools/compile-shaders.ps1 re-emits
// byte-identical SPIR-V â€” the same property Wave C's version-lock edit relied
// on, and the reason the bench leg is provably still running the program its
// digest was recorded from.
#ifndef VXC_MESH_CHUNK_LOCAL
    #define VXC_MESH_CHUNK_LOCAL 0
#endif
#if VXC_MESH_CHUNK_LOCAL && !defined(VXC_UE)
    #error "VXC_MESH_CHUNK_LOCAL is an Unreal-side permutation (FVoxelMeshEmitCS::FChunkLocalDim). The standalone DXC/SPIR-V leg must never define it, or the bench stops running the program its determinism digest was recorded against."
#endif

#if VXC_MESH_CHUNK_LOCAL
// Bricks along one edge of a render chunk: VoxelCoords::ChunkEdgeVoxels (32)
// divided by the 8-voxel brick edge. Mirrored, not derived, because this file
// deliberately does not know about render chunks anywhere else.
static const uint kBricksPerChunkEdge = 4u;

// First slot in OutQuads this dispatch may write. Zero for a single chunk
// meshing into its own buffer; non-zero when several chunks share one buffer.
// Loose global under VXC_UE, bound by reflected name out of
// FVoxelMeshEmitCS::FParameters â€” see the $Globals comment above.
uint QuadWriteBase;

// Chunk-local voxel origin of the interior brick that owns this mask.
//
// Interior brick (ix,iy,iz) of the region sits at region-local voxel origin
// ((ix+1)*8, (iy+1)*8, (iz+1)*8) â€” the +1 is the halo brick decodeMask adds.
// Its CHUNK-local origin is (ix*8, iy*8, iz*8) modulo the chunk, i.e. the halo
// term comes straight back out. The `% kBricksPerChunkEdge` is what makes a
// multi-chunk region work: interior brick 4 on an axis is brick 0 of the NEXT
// chunk, so its chunk-local origin is 0 again, not 32 (which would not even
// fit the 8-bit field). For the one-chunk-per-region case the interior is
// 4x4x4 and the modulo is the identity.
//
// PRECONDITION: only valid for a maskIndex decodeMask has already accepted.
uint3 maskChunkLocalOrigin(uint maskIndex)
{
    const uint bricksX = DispatchColumns.x / 8u;
    const uint bricksY = DispatchColumns.y / 8u;
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - identical subtraction to decodeMask's, under the same precondition: this is only reached for a maskIndex decodeMask returned true for, and decodeMask's `bricksX < 3u || bricksY < 3u || BricksZ < 3u` early-out is what proves every axis has at least 3 bricks
    const uint mbx = bricksX - 2u, mby = bricksY - 2u;
    const uint meshBrickIndex = maskIndex / 48u;
    const uint ix = meshBrickIndex % mbx;
    const uint iy = (meshBrickIndex / mbx) % mby;
    const uint iz = meshBrickIndex / (mbx * mby);
    return uint3((ix % kBricksPerChunkEdge) * 8u,
                 (iy % kBricksPerChunkEdge) * 8u,
                 (iz % kBricksPerChunkEdge) * 8u);
}
#endif

// Region-voxel material read. rv is region-local voxel coords (region brick
// (0,0,0) cell (0,0,0) is rv = (0,0,0)); callers only pass coords inside the
// voxelized region (interior brick +/-1 cell stays inside because of the
// halo brick).
uint regionCellMat(int3 rv)
{
    // RING-BOUNDARY SKIRT (D5.3). Mirrors the CPU sampler in
    // VoxelChunkMesher.h: when a lateral face of THIS render chunk is a ring
    // boundary, report the apron beyond it as AIR so the mesher emits the
    // retaining wall that closes the cascade seam. Without it a coarse ring's
    // inward edge is see-through.
    //
    // Only reads OUTSIDE the chunk are affected -- interior cells and internal
    // brick borders are untouched -- so a chunk with no flagged face is
    // byte-for-byte what it was before this existed. RingSkirtMask is 0 for
    // every dispatch that is not an inward ring boundary, which is nearly all
    // of them, and 0 makes this whole block dead.
    //
    // THE CHUNK INTERIOR IS CELLS [8, 40) ON BOTH LATERAL AXES: a chunk
    // dispatch is 6 bricks per axis with one brick of halo, so the 4 interior
    // bricks start at cell 8 and span 32. That is a SINGLE-CHUNK assumption and
    // it is not left as one -- ValidateRegionRequest REJECTS a non-zero
    // RingSkirtMask on any region that is not exactly one chunk. The reason is
    // that under batching a shared interior cell is one chunk's interior AND
    // its neighbour's apron, so a single mask would corrupt real geometry
    // rather than merely fail to add a wall. Refusing is what makes the scalar
    // sound instead of merely sound-for-now.
    if (RingSkirtMask != 0u)
    {
        if (((RingSkirtMask & 1u) && rv.x <  8) ||
            ((RingSkirtMask & 2u) && rv.x >= 40) ||
            ((RingSkirtMask & 4u) && rv.y <  8) ||
            ((RingSkirtMask & 8u) && rv.y >= 40))
        {
            return 0u;   // MAT_AIR
        }
    }

    const uint bx = (uint)(rv.x >> 3), by = (uint)(rv.y >> 3), bz = (uint)(rv.z >> 3);
    const uint lx = (uint)(rv.x & 7), ly = (uint)(rv.y & 7), lz = (uint)(rv.z & 7);
    const uint bricksX = DispatchColumns.x / 8u;
    const uint footprintIndex = bx + bricksX * by;
    const uint brickIndex = footprintIndex * BricksZ + bz;
    return OutCells[brickIndex * 512u + cellIndexInBrick(lx, ly, lz)] & 0xffu;
}

// vxc::detail::aoCorner bit-for-bit.
uint aoCorner(bool s1, bool s2, bool c)
{
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the subtrahend is a sum of three 0-or-1 terms, so it is at most 3 and the result stays in [0, 3]; cannot go below zero
    return (s1 && s2) ? 0u : (3u - ((s1 ? 1u : 0u) + (s2 ? 1u : 0u) + (c ? 1u : 0u)));
}

// Builds the 8x8 face mask for (brickOrigin, axis, dir, slice) and runs the
// CPU greedy algorithm. When emit != 0, writes packed quads at
// OutQuads[baseOffset + n]; always returns the quad count. Mirrors
// vxc::meshBrick<8> exactly: mask key = mat | ao<<8 | 1<<16.
uint greedyMask(int3 brickOriginRv, uint axis, uint dir, uint slice, uint emit, uint baseOffset
#if VXC_MESH_CHUNK_LOCAL
                // Chunk-local voxel origin to bake into the emitted positions;
                // see maskChunkLocalOrigin. Unused when emit == 0.
              , uint3 quadOrigin
#endif
               )
{
    const uint u = (axis + 1u) % 3u;
    const uint v = (axis + 2u) % 3u;
    const int nOff = (dir != 0u) ? 1 : -1;

    uint mask[64];
    for (uint j = 0; j < 8u; ++j)
    {
        for (uint i = 0; i < 8u; ++i)
        {
            int3 c = int3(0, 0, 0);
            c[axis] = (int)slice;
            c[u] = (int)i;
            c[v] = (int)j;
            const uint m = regionCellMat(brickOriginRv + c);
            uint key = 0u;
            if (m != MAT_AIR)
            {
                int3 n = c;
                n[axis] += nOff;
                if (regionCellMat(brickOriginRv + n) == MAT_AIR)
                {
                    // 4-corner AO from the 8 cells ringing the face on the
                    // neighbor plane (mesher.h order: (0,0),(1,0),(0,1),(1,1)).
                    bool uNeg, uPos, vNeg, vPos, dNN, dPN, dNP, dPP;
                    {
                        int3 p;
                        p = n; p[u] -= 1;            uNeg = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[u] += 1;            uPos = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[v] -= 1;            vNeg = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[v] += 1;            vPos = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[u] -= 1; p[v] -= 1; dNN = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[u] += 1; p[v] -= 1; dPN = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[u] -= 1; p[v] += 1; dNP = regionCellMat(brickOriginRv + p) != MAT_AIR;
                        p = n; p[u] += 1; p[v] += 1; dPP = regionCellMat(brickOriginRv + p) != MAT_AIR;
                    }
                    uint ao = 0u;
                    ao |= aoCorner(uNeg, vNeg, dNN);
                    ao |= aoCorner(uPos, vNeg, dPN) << 2;
                    ao |= aoCorner(uNeg, vPos, dNP) << 4;
                    ao |= aoCorner(uPos, vPos, dPP) << 6;
                    key = m | (ao << 8) | (1u << 16);
                }
            }
            mask[i + 8u * j] = key;
        }
    }

    // Greedy rectangle merge - identical control flow to mesher.h.
    uint quadCount = 0u;
    for (uint j2 = 0; j2 < 8u; ++j2)
    {
        for (uint i2 = 0; i2 < 8u;)
        {
            const uint key = mask[i2 + 8u * j2];
            if (key == 0u)
            {
                ++i2;
                continue;
            }
            // HARDENING (2026-07 cross-vendor UB pass, issue 2). This was
            //   while (i2 + w < 8u && mask[i2 + w + 8u * j2] == key) ++w;
            // which reads mask[64] â€” one past `uint mask[64]` â€” on the
            // terminating iteration of the last row (i2 + w == 8, j2 == 7).
            // It is only safe if `&&` short-circuits, and HLSL has
            // historically declined to guarantee short-circuit evaluation for
            // scalar operands (the spec permits evaluating both sides; DXC
            // does short-circuit today, but that is a compiler property, not
            // a contract). Hoisting the bound into its own `if` makes the
            // in-range test structural. Identical iteration count and
            // identical `w` for every input â€” pure control-flow rewrite.
            uint w = 1u;
            while (i2 + w < 8u)
            {
                if (mask[i2 + w + 8u * j2] != key) break;
                ++w;
            }
            uint h = 1u;
            for (; j2 + h < 8u; ++h)
            {
                bool rowOk = true;
                for (uint k = 0; k < w; ++k)
                {
                    if (mask[i2 + k + 8u * (j2 + h)] != key)
                    {
                        rowOk = false;
                        break;
                    }
                }
                if (!rowOk) break;
            }
            for (uint dj = 0; dj < h; ++dj)
                for (uint di = 0; di < w; ++di)
                    mask[i2 + di + 8u * (j2 + dj)] = 0u;

            if (emit != 0u)
            {
                const uint ao8 = (key >> 8) & 0xffu;
                const uint mat = key & 0xffu;
                uint2 q;
#if VXC_MESH_CHUNK_LOCAL
                // D2: bake the brick's chunk-local origin into the three
                // position fields, so the quad is positioned in the chunk on
                // its own. slice runs along `axis`, i2 along u, j2 along v â€”
                // the same axis assignment RebaseQuadsToChunkLocal used on the
                // CPU, which is the code this replaces. Every term stays under
                // 32 for a 32-voxel chunk, so the 8-bit fields do not overflow.
                q.x = axis | (dir << 4)
                    | ((slice + quadOrigin[axis]) << 8)
                    | ((i2    + quadOrigin[u])    << 16)
                    | ((j2    + quadOrigin[v])    << 24);
#else
                q.x = axis | (dir << 4) | (slice << 8) | (i2 << 16) | (j2 << 24);
#endif
                q.y = w | (h << 8) | (ao8 << 16) | (mat << 24);
                // HARDENING (2026-07 cross-vendor UB pass, issue 3).
                // `baseOffset` comes from InQuadOffsets, i.e. from whatever
                // the scan chain wrote; the write was previously unclamped,
                // so a short/stale ScanCount (offsets never scanned) or a
                // corrupt offset would scribble arbitrarily far outside
                // OutQuads. Bound it against the buffer's OWN length rather
                // than a new cbuffer field: GetDimensions lowers to
                // OpArrayLength over the bound descriptor range, so it is the
                // real allocation, needs no host/shader contract to stay in
                // sync, and cannot itself go stale. `quadIndex < baseOffset`
                // catches uint wraparound. GUARD ONLY: the harness sizes
                // OutQuads to the 32-quads-per-mask upper bound
                // (docs/gpu-mesher-design.md), so on every valid dispatch
                // quadIndex < quadCap holds and every quad is still written.
                uint quadCap, quadStride;
                OutQuads.GetDimensions(quadCap, quadStride);
#if VXC_MESH_CHUNK_LOCAL
                // Same guard, one term longer. QuadWriteBase is a host-supplied
                // uniform, so it gets the identical treatment InQuadOffsets
                // does: both additions are checked for wraparound and the final
                // index is bounded against the buffer's own length.
                const uint writeBase = QuadWriteBase + baseOffset;
                const uint quadIndex = writeBase + quadCount;
                if (writeBase >= QuadWriteBase && quadIndex >= writeBase && quadIndex < quadCap)
                    OutQuads[quadIndex] = q;
#else
                const uint quadIndex = baseOffset + quadCount;
                if (quadIndex >= baseOffset && quadIndex < quadCap)
                    OutQuads[quadIndex] = q;
#endif
            }
            ++quadCount;
            i2 += w;
        }
    }
    return quadCount;
}

// Decodes a flat mask index into (brick origin, axis, dir, slice); returns
// false when the index is out of range.
bool decodeMask(uint maskIndex, out int3 brickOriginRv, out uint axis, out uint dir, out uint slice)
{
    const uint bricksX = DispatchColumns.x / 8u;
    const uint bricksY = DispatchColumns.y / 8u;
    // HARDENING (2026-07 cross-vendor UB pass, issue 1). The interior-brick
    // dims below subtract the 1-brick halo from each axis. On UNSIGNED
    // values, a region with fewer than 3 bricks on any axis wraps: e.g.
    // bricksX == 1 gives mbx == 0xFFFFFFFF, and the product
    // mbx*mby*mbz*48 then wraps to some large-but-arbitrary maskCount that
    // the `maskIndex >= maskCount` range check happily passes. decodeMask
    // would return true with a nonsense brick origin, and regionCellMat
    // would read OutCells far out of bounds â€” vendor-defined behavior
    // exactly like the bug this pass exists to prevent (AMD's range-checked
    // descriptors return 0; NVIDIA's may return adjacent memory). A region
    // that thin has NO interior bricks, so the correct answer is "no mask".
    // GUARD ONLY: gpu_harness.cpp already refuses to run the mesh chain
    // unless bricksX/Y/Z are all >= 3, so this branch is never taken on any
    // dispatch that actually reaches the GPU today.
    if (bricksX < 3u || bricksY < 3u || BricksZ < 3u)
    {
        brickOriginRv = int3(0, 0, 0);
        axis = 0u;
        dir = 0u;
        slice = 0u;
        return false;
    }
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the >= 3 early-out directly above proves every axis has at least 3 bricks, so each halo subtraction leaves >= 1; this is the exact underflow that guard was added to prevent
    const uint mbx = bricksX - 2u, mby = bricksY - 2u, mbz = BricksZ - 2u;
    const uint maskCount = mbx * mby * mbz * 48u;
    if (maskIndex >= maskCount)
    {
        brickOriginRv = int3(0, 0, 0);
        axis = 0u;
        dir = 0u;
        slice = 0u;
        return false;
    }
    const uint meshBrickIndex = maskIndex / 48u;
    const uint sub = maskIndex % 48u;
    axis = sub / 16u;
    dir = (sub % 16u) / 8u;
    slice = sub % 8u;
    const uint ix = meshBrickIndex % mbx;
    const uint iy = (meshBrickIndex / mbx) % mby;
    const uint iz = meshBrickIndex / (mbx * mby);
    brickOriginRv = int3((int)((ix + 1u) * 8u), (int)((iy + 1u) * 8u), (int)((iz + 1u) * 8u));
    return true;
}

[numthreads(64, 1, 1)]
void MeshCountMain(uint3 tid : SV_DispatchThreadID)
{
    int3 origin;
    uint axis, dir, slice;
    if (!decodeMask(tid.x, origin, axis, dir, slice))
        return;
    // The chunk-local origin is an emit-time concern only: counting is
    // position-independent, so this passes zero and the count is identical
    // under either permutation. That matters â€” the scan chain between count
    // and emit must produce the SAME offsets whichever way emit is compiled.
    OutQuadCounts[tid.x] = greedyMask(origin, axis, dir, slice, 0u, 0u
#if VXC_MESH_CHUNK_LOCAL
                                    , uint3(0u, 0u, 0u)
#endif
                                     );
}

[numthreads(64, 1, 1)]
void MeshEmitMain(uint3 tid : SV_DispatchThreadID)
{
    int3 origin;
    uint axis, dir, slice;
    if (!decodeMask(tid.x, origin, axis, dir, slice))
        return;
    // HARDENING (2026-07 cross-vendor UB pass, issue 3). InQuadOffsets[i] is
    // only meaningful for i < ScanCount â€” those are the entries the
    // ScanBlocks/Sums/Add chain actually wrote. Emitting from an offset
    // beyond ScanCount would read never-written device memory, whose
    // contents differ by driver and allocation history, and then use it as a
    // write base. GUARD ONLY: the harness always sets ScanCount == maskCount
    // (both call sites), and decodeMask has already rejected
    // tid.x >= maskCount above, so this is unreachable on a valid dispatch.
    if (tid.x >= ScanCount)
        return;
    greedyMask(origin, axis, dir, slice, 1u, InQuadOffsets[tid.x]
#if VXC_MESH_CHUNK_LOCAL
             , maskChunkLocalOrigin(tid.x)
#endif
              );
}

// --- GPU exclusive scan over per-mask quad counts ---------------------------
// Replaces the host scan between count and emit (the 128m gate's dominant
// cost â€” see docs/status.md). Determinism: fixed-order shared-memory
// Hillis-Steele over integers, identical result to the host scan by
// definition of exclusive scan. Three dispatches chained in ONE command
// buffer with barriers:
//   ScanBlocksMain: per-256-block exclusive scan of OutQuadCounts into
//                   OutQuadOffsets + per-block totals into OutBlockSums.
//   ScanSumsMain:   ONE workgroup exclusive-scans OutBlockSums in place
//                   (max 256 blocks => maskCount <= 65,536 per dispatch â€”
//                   the harness asserts this per tile).
//   ScanAddMain:    adds the scanned block base to every element.
// The emit pass then reads InQuadOffsets â€” the SAME buffer bound read-only.
// ScanCount (cbuffer append) = number of masks in this dispatch.

RWStructuredBuffer<uint> OutQuadOffsets VXC_REG(u6);
RWStructuredBuffer<uint> OutBlockSums VXC_REG(u7);

groupshared uint gsScan[256];

[numthreads(256, 1, 1)]
void ScanBlocksMain(uint3 tid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID,
                    uint3 gid : SV_GroupID)
{
    const uint n = ScanCount;
    const uint v = (tid.x < n) ? OutQuadCounts[tid.x] : 0u;
    gsScan[gtid.x] = v;
    GroupMemoryBarrierWithGroupSync();
    // Hillis-Steele inclusive scan (fixed iteration order â€” deterministic).
    [unroll]
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        uint add = 0u;
        if (gtid.x >= offset)
            // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the enclosing `gtid.x >= offset` test is precisely the no-underflow precondition for this subtraction
            add = gsScan[gtid.x - offset];
        GroupMemoryBarrierWithGroupSync();
        gsScan[gtid.x] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    // Exclusive = inclusive shifted right by one.
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the ternary takes the subtracting branch only when gtid.x != 0, i.e. gtid.x >= 1, so this cannot go below zero
    const uint exclusive = (gtid.x == 0u) ? 0u : gsScan[gtid.x - 1u];
    if (tid.x < n)
        OutQuadOffsets[tid.x] = exclusive;
    if (gtid.x == 255u)
        // lint-shader-ub: allow UNGUARDED_WRITE - one store per workgroup, so gid.x < the dispatched group count, and the host sizes OutBlockSums to exactly ceil(ScanCount/256) = that group count (gpu_harness.cpp blockSumsBuf)
        OutBlockSums[gid.x] = gsScan[255u]; // block total (inclusive of padding zeros)
}

[numthreads(256, 1, 1)]
void ScanSumsMain(uint3 gtid : SV_GroupThreadID)
{
    const uint numBlocks = (ScanCount + 255u) / 256u;
    const uint v = (gtid.x < numBlocks) ? OutBlockSums[gtid.x] : 0u;
    gsScan[gtid.x] = v;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        uint add = 0u;
        if (gtid.x >= offset)
            // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the enclosing `gtid.x >= offset` test is precisely the no-underflow precondition for this subtraction
            add = gsScan[gtid.x - offset];
        GroupMemoryBarrierWithGroupSync();
        gsScan[gtid.x] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    // lint-shader-ub: allow UNSIGNED_UNDERFLOW - the ternary takes the subtracting branch only when gtid.x != 0, i.e. gtid.x >= 1, so this cannot go below zero
    const uint exclusive = (gtid.x == 0u) ? 0u : gsScan[gtid.x - 1u];
    if (gtid.x < numBlocks)
        OutBlockSums[gtid.x] = exclusive;
}

[numthreads(256, 1, 1)]
void ScanAddMain(uint3 tid : SV_DispatchThreadID, uint3 gid : SV_GroupID)
{
    if (tid.x < ScanCount)
        OutQuadOffsets[tid.x] += OutBlockSums[gid.x];
}
