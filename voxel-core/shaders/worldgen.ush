// Biome gate/Whittaker thresholds (voxelcore/biome.h) â€” bit-exact mirror,
// worldgen contract.
//
// SINCE v8 THESE ARE DERIVED, NOT CHOSEN. biome.h states each threshold in
// physical units and converts at compile time through voxelcore/climate.h --
// e.g. `kBiomeTempColdU8 = climateTempU8FromDegC(5)`. HLSL has no climate.h and
// no constexpr conversion, so the literals below are the CONVERTED values, and
// the physical quantity each one came from is written beside it.
//
// DO NOT hand-compute these when biome.h changes. Run
// `vxc_dump_biome_constants` (voxel-core/bench) and paste its output: it prints
// them from the very headers the CPU path compiles against, which is the only
// way this mirror cannot drift by arithmetic slip.
static const int64_t kBiomeCliffSlopeMmPerM = 700; // 70% grade, ~35 deg (v9: mm per METRE)
static const int kBiomeBeachLowerMm = -3000;
static const int kBiomeBeachUpperMm = 4000;
static const int kBiomeTreelineBaseMm = 900000;       // 900 m at 0 C (TUNED, not derived)
static const int kBiomeTreelineMmPerTempUnit = 47058; // 150 m/degC over the u8 range
static const int kBiomeAlpineRockLineMm = 3200000;
static const int kBiomeTempColdU8 = 143;   // climateTempU8FromDegC(5)
static const int kBiomeTempWarmU8 = 185;   // climateTempU8FromDegC(18)
static const int kBiomeTempHotU8 = 204;    // climateTempU8FromDegC(24)
