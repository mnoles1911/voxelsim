+// Opt-in GT-only R0 diagnostic. Durations are INCLUSIVE, not additive.
+// No clocks inside the per-Z predicate/probe loop. One record per entry slice;
+// split scans therefore sum through CSV Accumulate. Destructor handles returns.
+namespace R0EntryDiagnostic
+{
+enum EStage { Entry, Footprint, Memo, Compute, Resolve, Sky, Nearest, Prefetch, NumStages };
+struct FSample { double Ms[NumStages]{}; uint64 Calls[NumStages]{}; uint64 ZCells=0, Evaluations=0, MemoHits=0, EpochInvalidations=0; };
+static thread_local FSample* Active = nullptr;
+struct FTimer
+{
+ FSample* Sample; EStage Stage; double Start;
+ explicit FTimer(EStage InStage) : Sample(Active), Stage(InStage), Start(Sample ? FPlatformTime::Seconds() : 0.0) { if (Sample) ++Sample->Calls[Stage]; }
+ ~FTimer() { if (Sample) Sample->Ms[Stage] += (FPlatformTime::Seconds()-Start)*1000.0; }
+};
+struct FEntry
+{
+ FSample Sample; bool Enabled; double Start; bool Finished=false;
+ explicit FEntry(int32 Level) : Enabled(Level==0 && IsInGameThread() && FParse::Param(FCommandLine::Get(), TEXT("VoxelR0EntryProfile"))), Start(Enabled ? FPlatformTime::Seconds() : 0.0) { if (Enabled) { check(Active==nullptr); Active=&Sample; } }
+ void Finish()
+ {
+  if (!Enabled || Finished) return;
+  Finished=true; Active=nullptr; Sample.Ms[Entry]=(FPlatformTime::Seconds()-Start)*1000.0; Sample.Calls[Entry]=1;
+  static FSample WindowMax; static double LastLog=0.0;
+#define R0_EMIT(Name) CSV_CUSTOM_STAT(VoxelStream, R0Entry##Name##Ms, Sample.Ms[Name], ECsvCustomStatOp::Accumulate); CSV_CUSTOM_STAT(VoxelStream, R0Entry##Name##Calls, double(Sample.Calls[Name]), ECsvCustomStatOp::Accumulate); WindowMax.Ms[Name]=FMath::Max(WindowMax.Ms[Name],Sample.Ms[Name]); WindowMax.Calls[Name]+=Sample.Calls[Name];
+  R0_EMIT(Entry) R0_EMIT(Footprint) R0_EMIT(Memo) R0_EMIT(Compute) R0_EMIT(Resolve) R0_EMIT(Sky) R0_EMIT(Nearest) R0_EMIT(Prefetch)
+#undef R0_EMIT
+#define R0_COUNT(Name) CSV_CUSTOM_STAT(VoxelStream, R0Entry##Name, double(Sample.Name), ECsvCustomStatOp::Accumulate); WindowMax.Name+=Sample.Name;
+  R0_COUNT(ZCells) R0_COUNT(Evaluations) R0_COUNT(MemoHits) R0_COUNT(EpochInvalidations)
+#undef R0_COUNT
+  const double Now=FPlatformTime::Seconds();
+  if (Now-LastLog>=5.0)
+  {
+   UE_LOG(LogVoxelEarth, Log, TEXT("R0EntryProfile inclusive slice-window-max ms: entry=%.3f footprint=%.3f memo=%.3f compute=%.3f resolve=%.3f sky=%.3f nearest=%.3f prefetch=%.3f; window calls entry=%llu footprint=%llu memo=%llu compute=%llu resolve=%llu sky=%llu nearest=%llu prefetch=%llu z=%llu eval=%llu memoHit=%llu epochInvalid=%llu"), WindowMax.Ms[Entry],WindowMax.Ms[Footprint],WindowMax.Ms[Memo],WindowMax.Ms[Compute],WindowMax.Ms[Resolve],WindowMax.Ms[Sky],WindowMax.Ms[Nearest],WindowMax.Ms[Prefetch],WindowMax.Calls[Entry],WindowMax.Calls[Footprint],WindowMax.Calls[Memo],WindowMax.Calls[Compute],WindowMax.Calls[Resolve],WindowMax.Calls[Sky],WindowMax.Calls[Nearest],WindowMax.Calls[Prefetch],WindowMax.ZCells,WindowMax.Evaluations,WindowMax.MemoHits,WindowMax.EpochInvalidations);
+   WindowMax=FSample{}; LastLog=Now;
+  }
+ }
+ ~FEntry() { Finish(); }
+};
+}
 
